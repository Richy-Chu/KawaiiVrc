{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KawaiiVrc Shell",
  "version": "0.3.15",
  "identifier": "com.kawaiivrc.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KawaiiVrc · Rust shell (stage 3: instance, media, notifications)",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 580,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KawaiiVrc",
    "category": "Utility",
    "shortDescription": "VRChat companion shell",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNUEyMkZDQThDNTZENDcKUldSSGJjV28vQ0phR3NzT1MzemNLUUdHN0RXT3I3elhEU2ZzcjUxSUtJWEU2WC9rWGFtUW91WmUK",
      "endpoints": [
        "https://github.com/Richy-Chu/KawaiiVrc/releases/download/shell-latest/shell-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
