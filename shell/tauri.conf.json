{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KawaiiVrc Shell",
  "version": "0.3.1",
  "identifier": "com.kawaiivrc.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KawaiiVrc · Rust shell (stage 3: instance, media, notifications)",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 580,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KawaiiVrc",
    "category": "Utility",
    "shortDescription": "VRChat companion shell",
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOTVCM0M3MEM2MjI1NTQKUldSVUpXSU14N09WWUNMd05McUNMQ1daTUpuMVRGZFpXUEpsdHViTHYrMDlmOUdPcjFMSFVXL2EK",
      "endpoints": [
        "https://github.com/Richy-Chu/KawaiiVrc/releases/latest/download/shell-latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
