{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KawaiiVrc Shell",
  "version": "0.1.0",
  "identifier": "com.kawaiivrc.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KawaiiVrc · Rust shell (stage 1)",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
