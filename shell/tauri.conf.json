{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KawaiiVrc Shell",
  "version": "0.3.0",
  "identifier": "com.kawaiivrc.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KawaiiVrc · Rust shell (stage 3: instance, media, notifications)",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 580,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KawaiiVrc",
    "category": "Utility",
    "shortDescription": "VRChat companion shell",
    "icon": ["icons/icon.ico"]
  }
}
