<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VrcCompanion\VrcCompanion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A passing test cannot speak: the test runner keeps its output in per-test buffers and
    drops them, so a green run that could not judge the profile looks exactly like a clean
    one. The guard leaves its verdict in this file and MSBuild prints it after the run.
  -->
  <PropertyGroup>
    <ProfileGuardNoteFile>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'VrcCompanionTests', 'logs', 'profile-guard-note.txt'))</ProfileGuardNoteFile>
  </PropertyGroup>

  <Target Name="ReportProfileGuardNote" AfterTargets="VSTest">
    <ReadLinesFromFile File="$(ProfileGuardNoteFile)" Condition="Exists('$(ProfileGuardNoteFile)')">
      <Output TaskParameter="Lines" ItemName="ProfileGuardNoteLines" />
    </ReadLinesFromFile>
    <Message Importance="high" Text="%(ProfileGuardNoteLines.Identity)" Condition="'@(ProfileGuardNoteLines)' != ''" />
  </Target>

</Project>
