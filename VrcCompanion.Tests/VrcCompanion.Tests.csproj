<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VrcCompanion\VrcCompanion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A passing test cannot speak: the test runner keeps its output in per-test buffers and
    drops them, so a green run that could not judge the profile looks exactly like a clean
    one. The guard leaves its verdict in a file and MSBuild prints it after the run.

    Each run gets its own folder under ProfileGuardRuns. Two suites running at once must never
    share these files: replaying another run's clean baseline would let this run's leak pass.
    The folder is named when the project is evaluated, which is once per `dotnet test`, and the
    test host learns it from the runsettings file below - the only channel MSBuild has to hand
    a child process a value without writing somewhere a second run also reads.
  -->
  <PropertyGroup>
    <ProfileGuardRuns>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'VrcCompanionTests', 'logs', 'guard'))</ProfileGuardRuns>

    <!-- A caller that names the folder - the red-path probe does - decides this run's identity. -->
    <ProfileGuardDirectory Condition="'$(VRCC_PROFILE_GUARD_DIR)' != ''">$(VRCC_PROFILE_GUARD_DIR)</ProfileGuardDirectory>
    <ProfileGuardDirectory Condition="'$(ProfileGuardDirectory)' == ''">$(ProfileGuardRuns)\$([System.Guid]::NewGuid().ToString('N'))</ProfileGuardDirectory>

    <ProfileGuardNoteFile>$(ProfileGuardDirectory)\profile-guard-note.txt</ProfileGuardNoteFile>
    <ProfileGuardBaselineFile>$(ProfileGuardDirectory)\profile-baseline.txt</ProfileGuardBaselineFile>
    <ProfileGuardSettingsFile>$(ProfileGuardDirectory)\profile-guard.runsettings</ProfileGuardSettingsFile>

    <!-- A settings file the caller passed is left alone: that run loses the hand-off, not its settings. -->
    <VSTestSetting Condition="'$(VSTestSetting)' == '' and '$(RunSettingsFilePath)' == ''">$(ProfileGuardSettingsFile)</VSTestSetting>
  </PropertyGroup>

  <!--
    The baseline belongs to the run starting now. Clearing it first means a filter that
    matches nothing cannot leave an older run's baseline for the guard to judge.
  -->
  <Target Name="PrepareProfileGuardRun" BeforeTargets="VSTest">
    <Delete Files="$(ProfileGuardBaselineFile)" />
    <MakeDir Directories="$(ProfileGuardDirectory)" />
    <WriteLinesToFile
        File="$(ProfileGuardSettingsFile)"
        Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;;&lt;RunSettings&gt;;  &lt;RunConfiguration&gt;;    &lt;EnvironmentVariables&gt;;      &lt;VRCC_PROFILE_GUARD_DIR&gt;$(ProfileGuardDirectory.Replace('&amp;', '&amp;amp;'))&lt;/VRCC_PROFILE_GUARD_DIR&gt;;    &lt;/EnvironmentVariables&gt;;  &lt;/RunConfiguration&gt;;&lt;/RunSettings&gt;"
        Overwrite="true" />
  </Target>

  <!--
    A filter that leaves the guard out would end the run with nothing having looked at the
    profile. After the filtered pass, run the guard by itself against the baseline that pass
    recorded, so a filtered run gets the same verdict as a full one. This pass does not
    build, and the exit code is judged only after the note is printed.
  -->
  <Target Name="RunProfileGuardForFilteredRun"
          AfterTargets="VSTest"
          BeforeTargets="ReportProfileGuardNote"
          Condition="'$(VSTestTestCaseFilter)' != '' and !$(VSTestTestCaseFilter.Contains('TheRealProfileIsUnchangedByTheRun')) and Exists('$(ProfileGuardBaselineFile)')">
    <Exec Command="dotnet vstest &quot;$(TargetPath)&quot; --TestCaseFilter:&quot;FullyQualifiedName=VrcCompanion.Tests.RealProfileGuard.TheRealProfileIsUnchangedByTheRun&quot;"
          EnvironmentVariables="VRCC_PROFILE_GUARD_REPLAY=1;VRCC_PROFILE_GUARD_DIR=$(ProfileGuardDirectory)"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="ProfileGuardExitCode" />
    </Exec>
  </Target>

  <Target Name="ReportProfileGuardNote" AfterTargets="VSTest" DependsOnTargets="RunProfileGuardForFilteredRun">
    <ReadLinesFromFile File="$(ProfileGuardNoteFile)" Condition="Exists('$(ProfileGuardNoteFile)')">
      <Output TaskParameter="Lines" ItemName="ProfileGuardNoteLines" />
    </ReadLinesFromFile>
    <Message Importance="high" Text="%(ProfileGuardNoteLines.Identity)" Condition="'@(ProfileGuardNoteLines)' != ''" />
  </Target>

  <!--
    A real profile write has to fail the run, and the note above has to be printed first,
    so the reason is on screen next to the result.
  -->
  <Target Name="FailOnProfileGuardFailure"
          AfterTargets="ReportProfileGuardNote"
          Condition="'$(ProfileGuardExitCode)' != '' and '$(ProfileGuardExitCode)' != '0'">
    <Error Text="The real-profile guard failed: this run wrote to the real profile. See the guard's output above." />
  </Target>

</Project>
