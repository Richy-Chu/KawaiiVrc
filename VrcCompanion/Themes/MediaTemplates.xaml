<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:VrcCompanion.Controls">

    <!-- A world or player chip in the Media filter bar. -->
    <Style x:Key="MediaFilterChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
        <Setter Property="Padding" Value="9,5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MediaCardTemplate">
        <StackPanel Margin="0,0,8,8"
                    Visibility="{Binding HasItem, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding GroupTitle}"
                       Visibility="{Binding HasGroupTitle, Converter={StaticResource BoolToVis}}"
                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                       Margin="2,0,0,5" />
            <Button Padding="0" BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="{Binding FileName}"
                    Command="{Binding DataContext.MediaViewModel.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding Item}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Card" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Border Width="220" Height="140"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <controls:AsyncImage SourceUrl="{Binding Path}"
                                         DecodeWidth="160"
                                         CornerRadius="12" />
                </Border>
            </Button>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
