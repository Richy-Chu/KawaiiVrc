<UserControl x:Class="VrcCompanion.Controls.InstanceActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VrcCompanion.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="420"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ActivityListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActivityList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ActivityListItem}" />
        </Style>

        <!-- Filter pills. The window's pill styles are not in scope inside a UserControl,
             so the same look is declared here. -->
        <Style x:Key="ActivityPill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PillBorder"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="9,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource VioletBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The two actions an avatar row carries. The window's button styles are not in
             scope inside a UserControl, so the look is declared here. -->
        <Style x:Key="ActivityLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource VioletBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivityPillList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ActivityPill}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <TextBlock Text="Instance activity" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding ActivityText}"
                       Style="{StaticResource MutedText}"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
        <TextBlock Text="Joins, leaves, Udon events and avatar changes, read from VRChat's own log."
                   Style="{StaticResource MutedText}"
                   FontSize="9.5"
                   Foreground="{StaticResource DimBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,8" />

        <ListBox ItemsSource="{Binding ActivityFilters}"
                 SelectedItem="{Binding SelectedActivityFilter, Mode=TwoWay}"
                 Style="{StaticResource ActivityPillList}"
                 Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource MutedText}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding ActivityPage.Items}"
                 Style="{StaticResource ActivityList}"
                 MaxHeight="248"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource InputBrush}"
                            CornerRadius="8"
                            Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <!-- Avatar rows show the avatar itself, like the Activity page; the
                                     AVATAR chip stays until its picture is resolved. -->
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="6"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ShowKindPill, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding KindLabel}"
                                               FontSize="8"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding KindBrush}" />
                                </Border>
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="{StaticResource AccentGradientPink}"
                                        ToolTip="{Binding AvatarImageTooltip}"
                                        Visibility="{Binding ShowAvatarImage, Converter={StaticResource BoolToVis}}">
                                    <Border Margin="1.5"
                                            CornerRadius="14.5"
                                            Background="{StaticResource InputBrush}">
                                        <controls:AsyncImage SourceUrl="{Binding AvatarImageUrl}"
                                                             CornerRadius="14.5"
                                                             DecodeWidth="64" />
                                    </Border>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- The same YOU tag the Activity page puts on the reader's own rows. -->
                                    <Border Grid.Column="1"
                                            Background="#33F472B6"
                                            BorderBrush="#5A3D82"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="4,1"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="This activity is from your own account"
                                            Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="YOU"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="#FFD8EA" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DetailText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="9"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ToolTip}" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,3,0,0"
                                            Visibility="{Binding IsAvatarChange, Converter={StaticResource BoolToVis}}">
                                    <Button Content="View avatar"
                                            Style="{StaticResource ActivityLinkButton}"
                                            Command="{Binding DataContext.OpenActivityAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding AvatarEntry}"
                                            ToolTip="{Binding AvatarTooltip}"
                                            Visibility="{Binding CanOpenAvatar, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Profile"
                                            Style="{StaticResource ActivityLinkButton}"
                                            Margin="10,0,0,0"
                                            Command="{Binding DataContext.OpenActivityUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding AvatarEntry}"
                                            ToolTip="Open this person's VRChat profile"
                                            Visibility="{Binding CanOpenProfile, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TimeText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="8.5"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding RepeatText}"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding KindBrush}"
                                           HorizontalAlignment="Right"
                                           ToolTip="How many identical lines this row stands for"
                                           Visibility="{Binding HasRepeat, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Only this list moves when a page or a filter changes; the Context page around
             the box must stay where the reader is. -->
        <controls:ListPager DataContext="{Binding ActivityPage}"
                            ResetListOnly="True"
                            Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}"
                            Margin="0,4,0,0" />

        <TextBlock Text="{Binding ActivityEmptyText}"
                   Style="{StaticResource MutedText}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVis}}" />
    </StackPanel>
</UserControl>
