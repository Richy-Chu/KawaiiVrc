<UserControl x:Class="VrcCompanion.Controls.ContinuityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VrcCompanion.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ContinuityRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinuityListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinuityList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ContinuityListItem}" />
        </Style>

        <Style x:Key="ContinuityPersonRow" TargetType="ListBoxItem" BasedOn="{StaticResource ContinuityListItem}">
            <EventSetter Event="Loaded" Handler="ContinuityPersonRow_Loaded" />
        </Style>

        <Style x:Key="ContinuityTab" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ContinuityTimelineTab" TargetType="Button" BasedOn="{StaticResource ContinuityTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTimelineTab}" Value="True">
                    <Setter Property="Background" Value="#BE185D" />
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContinuityPeopleTab" TargetType="Button" BasedOn="{StaticResource ContinuityTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPeopleTab}" Value="True">
                    <Setter Property="Background" Value="#BE185D" />
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContinuityWorldsTab" TargetType="Button" BasedOn="{StaticResource ContinuityTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWorldsTab}" Value="True">
                    <Setter Property="Background" Value="#BE185D" />
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ContinuitySourcesTab" TargetType="Button" BasedOn="{StaticResource ContinuityTab}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSourcesTab}" Value="True">
                    <Setter Property="Background" Value="#BE185D" />
                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary and source actions -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Local social memory" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SummaryText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding SourcesSummary}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ImportStatus}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource VioletBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasImportStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Top"
                            Margin="18,0,0,0">
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="12,7"
                            FontSize="11" />
                    <Button Content="{Binding ImportButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportCommand}"
                            Padding="14,8"
                            FontSize="11"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs and search -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Timeline"
                        Style="{StaticResource ContinuityTimelineTab}"
                        AutomationProperties.AutomationId="ContinuityTimelineTab"
                        Command="{Binding ShowTimelineCommand}" />
                <Button Content="People"
                        Style="{StaticResource ContinuityPeopleTab}"
                        AutomationProperties.AutomationId="ContinuityPeopleTab"
                        Command="{Binding ShowPeopleCommand}" />
                <Button Content="Worlds"
                        Style="{StaticResource ContinuityWorldsTab}"
                        AutomationProperties.AutomationId="ContinuityWorldsTab"
                        Command="{Binding ShowWorldsCommand}" />
                <Button Content="Sources"
                        Style="{StaticResource ContinuitySourcesTab}"
                        AutomationProperties.AutomationId="ContinuitySourcesTab"
                        Command="{Binding ShowSourcesCommand}" />
            </StackPanel>

            <Grid Grid.Column="1" Width="270">
                <TextBox AutomationProperties.AutomationId="ContinuitySearchBox"
                         Style="{StaticResource InputBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search history, people, or worlds" />
                <TextBlock Text="Search history, people, or worlds"
                           Margin="13,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Padding="18,14"
                Margin="0,0,0,12"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding EmptyMessage}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Timeline -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsTimelineTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding SessionCountText}"
                       Style="{StaticResource MutedText}"
                       Margin="2,0,0,8" />

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding SessionsView}"
                     Style="{StaticResource ContinuityList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ContinuityRowButton}"
                                Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="View this session">
                            <Border Style="{StaticResource ListRow}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="42" Height="42" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" />
                                        <TextBlock Text="&#xE81C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="17"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                             CornerRadius="10"
                                                             DecodeWidth="84"
                                                             ImageOpacity="1" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WorldName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DetailsText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Location}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Background="{StaticResource InputBrush}"
                                            CornerRadius="8"
                                            Padding="8,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- People -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsPeopleTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding PersonCountText}"
                           Style="{StaticResource MutedText}"
                           Margin="2,0,0,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding PeopleView}"
                         ItemContainerStyle="{StaticResource ContinuityPersonRow}"
                         Style="{StaticResource ContinuityList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="20" />
                                        <TextBlock Text="{Binding Initial}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                             CornerRadius="20"
                                                             DecodeWidth="80"
                                                             ImageOpacity="1" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastSeenText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Profile"
                                                Style="{StaticResource SmallButton}"
                                                Padding="8,4"
                                                FontSize="10"
                                                IsEnabled="{Binding CanOpenProfile}"
                                                Command="{Binding DataContext.OpenPersonProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open this person's VRChat profile" />
                                        <Button Content="Open"
                                                Style="{StaticResource SmallButton}"
                                                Padding="8,4"
                                                FontSize="10"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.SelectPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="18"
                    Visibility="{Binding IsPersonDetailVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPerson.DisplayName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedPerson.UserIdText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="10.5"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ClosePersonCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedPerson.TimeText}" Style="{StaticResource MutedText}" FontSize="10" />
                            </Border>
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedPerson.SessionsText}" Style="{StaticResource MutedText}" FontSize="10" />
                            </Border>
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8,4">
                                <TextBlock Text="{Binding SelectedPerson.FriendText}" Style="{StaticResource MutedText}" FontSize="10" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedPerson.FirstSeenText}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="0,10,0,0" />
                        <Button Content="Open VRChat profile"
                                Style="{StaticResource SecondaryButton}"
                                Padding="11,6"
                                FontSize="10.5"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding SelectedPerson.CanOpenProfile}"
                                Command="{Binding OpenPersonProfileCommand}"
                                CommandParameter="{Binding SelectedPerson}" />

                        <TextBlock Text="About"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4" />
                        <TextBlock Text="{Binding SelectedPerson.Bio}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SelectedPerson.HasBio, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="No profile bio was stored by the source."
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding SelectedPerson.HasBio, Converter={StaticResource InverseBoolToVis}}" />

                        <TextBlock Text="Your note"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4" />
                        <TextBox Text="{Binding SelectedPerson.Note, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="86"
                                 VerticalContentAlignment="Top" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save note"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,7"
                                    FontSize="10.5"
                                    Command="{Binding SaveNoteCommand}" />
                            <TextBlock Text="{Binding NoteStatus}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasNoteStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="Shared sessions"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,18,0,6" />
                        <ListBox ItemsSource="{Binding PersonSessions}"
                                 Style="{StaticResource ContinuityList}"
                                 MaxHeight="230">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ContinuityRowButton}"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="View this session">
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding WorldName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DetailsText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="20"
                    Visibility="{Binding IsPeopleListVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pick a person"
                               Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Open someone from the list to see every session you shared, their known profile details, and a private local note."
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Worlds -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsWorldsTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding WorldCountText}"
                           Style="{StaticResource MutedText}"
                           Margin="2,0,0,8" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding WorldsView}"
                         Style="{StaticResource ContinuityList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="54" Height="40" VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" />
                                        <TextBlock Text="&#xE909;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                             CornerRadius="8"
                                                             DecodeWidth="108"
                                                             ImageOpacity="1" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastSeenText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Details"
                                                Style="{StaticResource SmallButton}"
                                                Padding="8,4"
                                                FontSize="10"
                                                IsEnabled="{Binding CanOpenWorld}"
                                                Command="{Binding DataContext.OpenWorldDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Open this world in VRChat" />
                                        <Button Content="Open"
                                                Style="{StaticResource SmallButton}"
                                                Padding="8,4"
                                                FontSize="10"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.SelectWorldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="18"
                    Visibility="{Binding IsWorldDetailVisible, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedWorld.DisplayName}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="Close"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CloseWorldCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding SelectedWorld.AuthorName}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SelectedWorld.WorldId}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   Foreground="{StaticResource DimBrush}"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8,4" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedWorld.TimeText}" Style="{StaticResource MutedText}" FontSize="10" />
                            </Border>
                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="8,4">
                                <TextBlock Text="{Binding SelectedWorld.VisitText}" Style="{StaticResource MutedText}" FontSize="10" />
                            </Border>
                        </StackPanel>
                        <Button Content="Open world details"
                                Style="{StaticResource SecondaryButton}"
                                Padding="11,6"
                                FontSize="10.5"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                IsEnabled="{Binding SelectedWorld.CanOpenWorld}"
                                Command="{Binding OpenWorldDetailsCommand}"
                                CommandParameter="{Binding SelectedWorld}" />

                        <TextBlock Text="Visits"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,18,0,6" />
                        <ListBox ItemsSource="{Binding WorldSessions}"
                                 Style="{StaticResource ContinuityList}"
                                 MaxHeight="380">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ContinuityRowButton}"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="View this session">
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DateText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding DetailsText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="9.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    Padding="20"
                    Visibility="{Binding IsWorldsListVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Pick a world"
                               Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Worlds are ordered by the time you have actually spent there, using real sessions from your imported history."
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sources -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsSourcesTab, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Continuity reads these local sources without changing them. Nothing is uploaded."
                       Style="{StaticResource MutedText}"
                       Margin="2,0,0,8" />
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Sources}"
                     Style="{StaticResource ContinuityList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <Border Background="{StaticResource InputBrush}"
                                                CornerRadius="7"
                                                Padding="7,2"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="9" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               Foreground="{StaticResource DimBrush}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatsText}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10.5"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ImportedText}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Private to this Windows account · stored in %LOCALAPPDATA%\VrcCompanion\continuity.db"
                   Style="{StaticResource MutedText}"
                   FontSize="9.5"
                   Foreground="{StaticResource DimBrush}"
                   Margin="2,10,0,0" />

        <!-- Session detail popup: same information and profile links as the
             rest of the app, without leaving the Continuity page. -->
        <Grid Grid.RowSpan="5"
              Panel.ZIndex="20"
              Background="#C0080B12"
              Visibility="{Binding IsSessionDetailVisible, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding CloseSessionCommand}"
                    Focusable="False"
                    Cursor="Arrow"
                    ToolTip="Close session">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="780"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource Card}"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="132" Height="74" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" />
                                <TextBlock Text="&#xE909;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="{StaticResource VioletBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <controls:AsyncImage SourceUrl="{Binding SelectedSession.ThumbnailUrl}"
                                                     CornerRadius="10"
                                                     DecodeWidth="264"
                                                     ImageOpacity="1" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedSession.WorldName}"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedSession.DetailsText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11"
                                           Margin="0,5,0,0" />
                                <TextBlock Text="{Binding SelectedSession.Location}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="9.5"
                                           Foreground="{StaticResource DimBrush}"
                                           Margin="0,5,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="Close"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CloseSessionCommand}"
                                    VerticalAlignment="Top" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Open world"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="12,7"
                                    FontSize="10.5"
                                    IsEnabled="{Binding SelectedSession.CanOpenWorld}"
                                    Command="{Binding OpenSessionWorldCommand}"
                                    CommandParameter="{Binding SelectedSession}" />
                            <Button Content="Copy location"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,7"
                                    FontSize="10.5"
                                    Margin="8,0,0,0"
                                    Command="{Binding CopySessionLocationCommand}" />
                            <TextBlock Text="{Binding NoteStatus}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasNoteStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="People observed in this session"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,20,0,6" />
                        <ListBox ItemsSource="{Binding SessionPeople}"
                                 ItemContainerStyle="{StaticResource ContinuityPersonRow}"
                                 Style="{StaticResource ContinuityList}"
                                 MaxHeight="360"
                                 Visibility="{Binding HasSessionPeople, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}" Margin="0,0,0,5" Padding="10,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="17" />
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource VioletBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                     CornerRadius="17"
                                                                     DecodeWidth="68"
                                                                     ImageOpacity="1" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FriendText}"
                                                           Style="{StaticResource MutedText}"
                                                           FontSize="9.5" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Profile"
                                                    Style="{StaticResource SmallButton}"
                                                    Padding="9,4"
                                                    FontSize="10"
                                                    IsEnabled="{Binding CanOpenProfile}"
                                                    Command="{Binding DataContext.OpenSessionPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Open this person's VRChat profile" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="The source recorded no player names for this visit."
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasSessionPeople, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
