<UserControl x:Class="VrcCompanion.Controls.ContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VrcCompanion.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ContextListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContextList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ContextListItem}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Account / refresh -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="52" Height="52" VerticalAlignment="Top">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="26" />
                    <TextBlock Text="&#xE77B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{StaticResource VioletBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <controls:AsyncImage SourceUrl="{Binding AccountAvatarUrl}"
                                         CornerRadius="26"
                                         DecodeWidth="104"
                                         ImageOpacity="1" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountName}"
                               Style="{StaticResource SectionTitle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="{Binding TrustText}" Style="{StaticResource MutedText}" FontSize="9.5" />
                        </Border>
                        <Border Background="{StaticResource InputBrush}" CornerRadius="7" Padding="8,3">
                            <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource MutedText}" FontSize="9.5" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="12,7"
                            FontSize="11" />
                    <Button Content="Copy context"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CopySnapshotCommand}"
                            Padding="13,8"
                            FontSize="11"
                            Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- World -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="124" Height="70" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" />
                    <TextBlock Text="&#xE909;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource VioletBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <controls:AsyncImage SourceUrl="{Binding WorldImageUrl}"
                                         CornerRadius="10"
                                         DecodeWidth="248"
                                         ImageOpacity="1" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="15,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WorldTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding WorldAuthor}"
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Location}"
                               Style="{StaticResource MutedText}"
                               FontSize="9.5"
                               Foreground="{StaticResource DimBrush}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Join a world in VRChat to fill this card with live instance data."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Foreground="{StaticResource DimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"
                               Visibility="{Binding IsInWorld, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="10,5" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PlayerCountText}" Style="{StaticResource MutedText}" FontSize="10" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <TextBlock Text="{Binding AccessText}" Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding RegionText}" Style="{StaticResource MutedText}" FontSize="9.5" />
                    </StackPanel>
                    <Button Content="Open world"
                            Style="{StaticResource SmallButton}"
                            Padding="9,4"
                            FontSize="9.5"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0"
                            Command="{Binding OpenWorldCommand}"
                            CommandParameter="{Binding WorldId}"
                            Visibility="{Binding IsInWorld, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,0,0,10"
                Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Showing the last saved local context. Refresh while signed in and in a world for live values."
                       Style="{StaticResource MutedText}"
                       FontSize="10.5"
                       TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Players -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="In this instance" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding PlayersText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="10"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ListBox ItemsSource="{Binding Players}"
                                     Style="{StaticResource ContextList}"
                                     Margin="0,10,0,0"
                                     Visibility="{Binding HasPlayers, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}" Padding="10,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="17" />
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource VioletBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                         CornerRadius="17"
                                                                         DecodeWidth="68"
                                                                         ImageOpacity="1" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding BlockedMarker}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource RedBrush}"
                                                                   ToolTip="{Binding BlockedToolTip}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="5,0,0,0"
                                                                   Visibility="{Binding HasBlockedMarker, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border Background="{StaticResource InputBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TrustText}" Style="{StaticResource MutedText}" FontSize="8.5" />
                                                    </Border>
                                                    <Button Content="Profile"
                                                            Style="{StaticResource SmallButton}"
                                                            Padding="7,3"
                                                            FontSize="8.5"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,3,0,0"
                                                            IsEnabled="{Binding CanOpenProfile}"
                                                            Command="{Binding DataContext.OpenPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Open this person's VRChat profile" />
                                                    <TextBlock Text="{Binding BadgeText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="8.5"
                                                               Foreground="{StaticResource VioletBrush}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No player observations yet. The instance roster fills in from VRChat and your local log."
                                       Style="{StaticResource MutedText}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding HasPlayers, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Today's sessions" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding TodayText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       Margin="0,4,0,8" />
                            <ListBox ItemsSource="{Binding TodaySessions}"
                                     Style="{StaticResource ContextList}"
                                     Visibility="{Binding HasTodaySessions, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ContextRowButton}"
                                                Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="View this session">
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="10,7" Margin="0,0,0,5">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WorldName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailsText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="9.5"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Friends and recent people -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Friends here" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding FriendsHereText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       Margin="0,4,0,8" />
                            <ListBox ItemsSource="{Binding FriendsHere}"
                                     Style="{StaticResource ContextList}"
                                     Visibility="{Binding HasFriendsHere, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}" Padding="10,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="15" />
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource VioletBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                         CornerRadius="15"
                                                                         DecodeWidth="60"
                                                                         ImageOpacity="1" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="9.5" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Profile"
                                                        Style="{StaticResource SmallButton}"
                                                        Padding="7,3"
                                                        FontSize="8.5"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanOpenProfile}"
                                                        Command="{Binding DataContext.OpenPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Open this person's VRChat profile" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Recent people" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="From your durable local history."
                                       Style="{StaticResource MutedText}"
                                       FontSize="10"
                                       Margin="0,4,0,8" />
                            <ListBox ItemsSource="{Binding RecentPeople}"
                                     Style="{StaticResource ContextList}"
                                     Visibility="{Binding HasRecentPeople, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="9,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="28" Height="28" VerticalAlignment="Center">
                                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="14" />
                                                    <TextBlock Text="{Binding Initial}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource VioletBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                         CornerRadius="14"
                                                                         DecodeWidth="56"
                                                                         ImageOpacity="1" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LastSeenText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="9" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SessionsText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="8.5"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="Profile"
                                                            Style="{StaticResource SmallButton}"
                                                            Padding="7,3"
                                                            FontSize="8.5"
                                                            Margin="5,0,0,0"
                                                            IsEnabled="{Binding CanOpenProfile}"
                                                            Command="{Binding DataContext.OpenPersonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Open this person's VRChat profile" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource MutedText}"
                       FontSize="10"
                       Foreground="{StaticResource VioletBrush}"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding SnapshotPath, StringFormat=Read-only snapshot: {0}}"
                       Style="{StaticResource MutedText}"
                       FontSize="9"
                       Foreground="{StaticResource DimBrush}"
                       Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
