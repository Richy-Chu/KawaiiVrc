<UserControl x:Class="VrcCompanion.Controls.EmbeddedBrowser"
             x:Name="BrowserRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:models="clr-namespace:VrcCompanion.Models"
             Background="{StaticResource InputBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Tag="BrowserNormalToolbar"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource InverseBoolToVis}}">
            <Button Content="Back"
                    Style="{StaticResource SmallButton}"
                    Margin="0,0,6,0"
                    IsEnabled="{Binding CanGoBack, ElementName=BrowserRoot}"
                    AutomationProperties.Name="Back"
                    Click="Back_Click" />
            <Button Content="Forward"
                    Style="{StaticResource SmallButton}"
                    Margin="0,0,6,0"
                    IsEnabled="{Binding CanGoForward, ElementName=BrowserRoot}"
                    AutomationProperties.Name="Forward"
                    Click="Forward_Click" />
            <Button Content="Refresh"
                    Style="{StaticResource SmallButton}"
                    AutomationProperties.Name="Refresh"
                    Click="Refresh_Click" />
            <Button x:Name="ShieldsButton"
                    Style="{StaticResource SmallButton}"
                    Margin="6,0,0,0"
                    Padding="8,3"
                    AutomationProperties.AutomationId="BraveShieldsButton"
                    AutomationProperties.Name="Brave Shields"
                    ToolTip="Brave Shields"
                    Click="ShieldsButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="{StaticResource BraveOrangeBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Shields"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Tag="BrowserFocusToolbar"
                Margin="0,0,0,8"
                Padding="6,4"
                Background="{StaticResource InputBrush}"
                BorderBrush="{StaticResource SoftBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsFocusMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Content="&#xE72B;"
                            Style="{StaticResource SmallButton}"
                            Padding="7,3"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanGoBack, ElementName=BrowserRoot}"
                            ToolTip="Back (Alt+Left)"
                            AutomationProperties.AutomationId="BrowserFocusBackButton"
                            AutomationProperties.Name="Back"
                            Click="Back_Click" />
                    <Button Content="&#xE72A;"
                            Style="{StaticResource SmallButton}"
                            Padding="7,3"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Margin="0,0,4,0"
                            IsEnabled="{Binding CanGoForward, ElementName=BrowserRoot}"
                            ToolTip="Forward (Alt+Right)"
                            AutomationProperties.AutomationId="BrowserFocusForwardButton"
                            AutomationProperties.Name="Forward"
                            Click="Forward_Click" />
                    <Button Content="&#xE72C;"
                            Style="{StaticResource SmallButton}"
                            Padding="7,3"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            ToolTip="Refresh (F5 or Ctrl+R)"
                            AutomationProperties.AutomationId="BrowserFocusRefreshButton"
                            AutomationProperties.Name="Refresh"
                            Click="Refresh_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding BrowserTitle}"
                               ToolTip="{Binding BrowserTitle}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="FocusAddressBox"
                             Text="{Binding BrowserUrl, Mode=OneWay}"
                             Style="{StaticResource InputBox}"
                             Margin="0,1,0,0"
                             Height="22"
                             Padding="6,1"
                             FontSize="10"
                             VerticalContentAlignment="Center"
                             ToolTip="Enter an address and press Enter"
                             AutomationProperties.AutomationId="BrowserFocusAddressBox"
                             AutomationProperties.Name="Address"
                             KeyDown="FocusAddressBox_KeyDown" />
                    <TextBlock x:Name="FocusAddressError"
                               Text="{Binding BrowserError}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               FontSize="10"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.AutomationId="BrowserFocusAddressError"
                               AutomationProperties.LiveSetting="Assertive">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrowserError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="FocusShieldsButton"
                            Style="{StaticResource SmallButton}"
                            Padding="7,3"
                            Margin="0,0,4,0"
                            ToolTip="Brave Shields"
                            AutomationProperties.AutomationId="BraveShieldsFocusButton"
                            AutomationProperties.Name="Brave Shields"
                            Click="ShieldsButton_Click">
                        <TextBlock Text="&#xEA18;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{StaticResource BraveOrangeBrush}" />
                    </Button>
                    <Button AutomationProperties.AutomationId="BrowserFocusExitButton"
                            Content="Exit focus"
                            Style="{StaticResource SmallButton}"
                            Padding="8,3"
                            ToolTip="Exit focus mode (Esc)"
                            AutomationProperties.Name="Exit focus"
                            Click="ExitFocus_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" />

        <Popup x:Name="ShieldsPopup"
               Placement="Bottom"
               VerticalOffset="6"
               HorizontalOffset="-245"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="390"
                    MaxHeight="640"
                    Background="#F21A1D27"
                    BorderBrush="#3B4054"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18"
                    AutomationProperties.AutomationId="BraveShieldsPanel">
                <ScrollViewer MaxHeight="604"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32"
                                    Background="#33FB542B"
                                    CornerRadius="9"
                                    VerticalAlignment="Top">
                                <TextBlock Text="&#xEA18;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="{StaticResource BraveOrangeBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SiteLabel}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="2"
                                      Style="{StaticResource BraveShieldsSwitch}"
                                      IsChecked="{Binding ShieldsEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding HasSite}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="BraveShieldsUpToggle"
                                      AutomationProperties.Name="Shields up for this site" />
                        </Grid>

                        <Border Background="{StaticResource InputBrush}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,14,0,0">
                            <TextBlock Text="{Binding BlockedSummary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextAlignment="Center" />
                        </Border>

                        <Expander Header="Advanced options"
                                  IsExpanded="{Binding IsAdvancedOpen, Mode=TwoWay}"
                                  Margin="0,12,0,0"
                                  Foreground="{StaticResource MutedBrush}">
                            <StackPanel Margin="0,4,0,0"
                                        IsEnabled="{Binding ShieldsEnabled}">
                                <StackPanel Margin="0,7">
                                    <TextBlock Text="Block trackers &amp; ads"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Standard blocks third-party trackers; aggressive also applies first-party cosmetic filtering."
                                               FontSize="9"
                                               Foreground="{StaticResource DimBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,4" />
                                    <ComboBox Style="{StaticResource BraveShieldsComboBox}"
                                              SelectedValue="{Binding AdBlockMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.Name="Trackers and ads mode">
                                        <ComboBoxItem Content="Aggressively block trackers &amp; ads"
                                                      Tag="{x:Static models:BraveAdBlockMode.Aggressive}" />
                                        <ComboBoxItem Content="Block trackers &amp; ads"
                                                      Tag="{x:Static models:BraveAdBlockMode.Standard}" />
                                        <ComboBoxItem Content="Allow all trackers &amp; ads"
                                                      Tag="{x:Static models:BraveAdBlockMode.Allow}" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,7">
                                    <TextBlock Text="Upgrade connections to HTTPS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Only connect with HTTPS is strict; standard upgrades when the site supports it."
                                               FontSize="9"
                                               Foreground="{StaticResource DimBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,4" />
                                    <ComboBox Style="{StaticResource BraveShieldsComboBox}"
                                              SelectedValue="{Binding HttpsUpgradeMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.Name="HTTPS upgrade mode">
                                        <ComboBoxItem Content="Only connect with HTTPS"
                                                      Tag="{x:Static models:BraveHttpsUpgradeMode.Strict}" />
                                        <ComboBoxItem Content="Upgrade connections to HTTPS"
                                                      Tag="{x:Static models:BraveHttpsUpgradeMode.Standard}" />
                                        <ComboBoxItem Content="Don't upgrade HTTP connections"
                                                      Tag="{x:Static models:BraveHttpsUpgradeMode.Disabled}" />
                                    </ComboBox>
                                </StackPanel>

                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Block scripts"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Stops page scripts. Some sites may stop working."
                                                   FontSize="9"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource BraveShieldsSwitch}"
                                              IsChecked="{Binding BlockScripts, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Block scripts" />
                                </Grid>

                                <StackPanel Margin="0,7">
                                    <TextBlock Text="Block fingerprinting"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Standard applies balanced farbling; aggressive applies stricter canvas and device protection."
                                               FontSize="9"
                                               Foreground="{StaticResource DimBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,4" />
                                    <ComboBox Style="{StaticResource BraveShieldsComboBox}"
                                              SelectedValue="{Binding FingerprintMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.Name="Fingerprinting mode">
                                        <ComboBoxItem Content="Aggressively block fingerprinting"
                                                      Tag="{x:Static models:BraveFingerprintMode.Strict}" />
                                        <ComboBoxItem Content="Block fingerprinting"
                                                      Tag="{x:Static models:BraveFingerprintMode.Standard}" />
                                        <ComboBoxItem Content="Allow fingerprinting"
                                                      Tag="{x:Static models:BraveFingerprintMode.Allow}" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,7">
                                    <TextBlock Text="Block third-party cookies"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="Use Brave's full cookie modes: block all, block third-party, or allow all."
                                               FontSize="9"
                                               Foreground="{StaticResource DimBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,4" />
                                    <ComboBox Style="{StaticResource BraveShieldsComboBox}"
                                              SelectedValue="{Binding CookieMode, Mode=TwoWay}"
                                              SelectedValuePath="Tag"
                                              AutomationProperties.Name="Cookie blocking mode">
                                        <ComboBoxItem Content="Block all cookies"
                                                      Tag="{x:Static models:BraveCookieMode.BlockAll}" />
                                        <ComboBoxItem Content="Block third-party cookies"
                                                      Tag="{x:Static models:BraveCookieMode.BlockThirdParty}" />
                                        <ComboBoxItem Content="Allow all cookies"
                                                      Tag="{x:Static models:BraveCookieMode.AllowAll}" />
                                    </ComboBox>
                                </StackPanel>

                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Forget me when I close this site"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Clears cookies and other site data when you close a site."
                                                   FontSize="9"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1"
                                              Style="{StaticResource BraveShieldsSwitch}"
                                              IsChecked="{Binding ForgetMeOnClose, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Forget me when I close this site" />
                                </Grid>

                                <TextBlock Text="Changing these settings might break sites."
                                           FontSize="9"
                                           FontStyle="Italic"
                                           Foreground="{StaticResource DimBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="If this site seems broken, try Shields down."
                                   FontSize="9"
                                   Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Filter lists"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BraveShieldsFilterListsButton"
                                    Click="FilterLists_Click" />
                            <Button Grid.Column="1"
                                    Content="Global Settings"
                                    Style="{StaticResource SmallButton}"
                                    Margin="4,0,0,0"
                                    AutomationProperties.AutomationId="BraveShieldsGlobalSettingsButton"
                                    Click="GlobalSettings_Click" />
                        </Grid>

                        <Border Background="{StaticResource InputBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,8,0,0"
                                Visibility="{Binding ShowFilterLists, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ACTIVE FILTER LISTS"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="✓  EasyList + uBlock Origin filters" FontSize="10" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="✓  EasyPrivacy + uBlock privacy filters" FontSize="10" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
                                <TextBlock Text="✓  Brave-specific and first-party rules" FontSize="10" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
                                <TextBlock Text="✓  Cosmetic filtering and element hiding" FontSize="10" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
                                <TextBlock Text="Powered by Brave's adblock-rust engine with the official filter lists compiled into the app."
                                           FontSize="9"
                                           Foreground="{StaticResource DimBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InputBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,8,0,0"
                                Visibility="{Binding ShowGlobalSettings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="GLOBAL SHIELDS"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,5" />
                                <TextBlock Text="New sites start with Shields up and the saved default protections. Resetting removes this site's overrides."
                                           FontSize="9"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <Button Content="Reset this site to defaults"
                                        Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        Click="ResetSite_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
