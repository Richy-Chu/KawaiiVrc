<Window x:Class="VrcCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:VrcCompanion.Controls"
        xmlns:behaviors="clr-namespace:VrcCompanion.Behaviors"
        xmlns:converters="clr-namespace:VrcCompanion.Converters"
        xmlns:m="clr-namespace:VrcCompanion.Models"
        xmlns:sys="clr-namespace:System"
        mc:Ignorable="d"
        d:DesignWidth="1280" d:DesignHeight="840"
        Title="VRChat Companion"
        Icon="Assets/app-icon.png"
        Width="1280" Height="840"
        MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- Small reusable pieces                                     -->
        <!-- ========================================================= -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="ErrorBannerPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
        </Style>

        <Style x:Key="InfoBannerPanel" TargetType="Border">
            <Setter Property="Background" Value="#13251F" />
            <Setter Property="BorderBrush" Value="#24543F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
        </Style>

        <Style x:Key="BareListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource BareListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style x:Key="FriendListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="9,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#151B28" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1E2537" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendListBox" TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FriendListItem}" />
            <!-- Only the rows in view are ever built, for any list size. -->
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="1" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        </Style>

        <Style x:Key="WorldListBox" TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorldCardButton" TargetType="Button">
            <Setter Property="Width" Value="262" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource PanelAltBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyStateCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="30,26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <Style x:Key="ChoiceListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChoiceBorder"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#3B455C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="RegionPillStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PillBorder"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3B455C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegionPillList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RegionPillStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- Content section templates                                 -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="ProfileTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>

                    <!-- Identity card -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="140" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2B1E4A" Offset="0" />
                                        <GradientStop Color="#3C2A6B" Offset="0.55" />
                                        <GradientStop Color="#1B1230" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" Opacity="0.45" />
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,-40,24,22">
                                <Grid Width="92" Height="92" Margin="0,0,18,0">
                                    <Ellipse Fill="{StaticResource InputBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="3" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding AvatarInitial}"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding UsernameHandle}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />

                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource TagChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding ProfileStatusLabel}"
                                                           Style="{StaticResource TagText}"
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource TagChip}">
                                            <TextBlock Text="{Binding TrustLabel}" Style="{StaticResource TagText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsVrcPlus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VRC+" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsAgeVerified, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Age verified" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding HasPronouns, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PronounsText}" Style="{StaticResource TagText}" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ProfileStatusDescription}"
                                               MaxWidth="520"
                                               Margin="0,9,0,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasProfileStatusDescription, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- At a glance -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="AT A GLANCE" Style="{StaticResource FieldLabel}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,12"
                                        Margin="0,0,12,10"
                                        MinWidth="190">
                                    <StackPanel>
                                        <TextBlock Text="FRIENDS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding FriendsSummary}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,12"
                                        Margin="0,0,12,10"
                                        MinWidth="190">
                                    <StackPanel>
                                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding NotificationsSummary}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16,12"
                                        Margin="0,0,12,10"
                                        MinWidth="190">
                                    <StackPanel>
                                        <TextBlock Text="ON VRCHAT SINCE" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding JoinedText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Padding="14,8"
                                        Margin="0,0,8,0"
                                        Content="Mark notifications read"
                                        Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding MarkAllReadCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Creator tools: only rendered when signed in as the creator -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding IsCreatorAccount, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="CREATOR TOOLS" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Only your account can see this. Turning it on unlocks the profile location injector used to test Join."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Padding="14,8"
                                        Command="{Binding ToggleDevToolsCommand}">
                                    <TextBlock Text="{Binding DevToolsButtonText}" />
                                </Button>
                                <TextBlock Text="On: the DEV button appears in profile popups."
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Friends: list + profile detail                            -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="FriendsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Width="290">
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding FriendFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search by name or username"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FriendFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                  Content="Online only"
                                  IsChecked="{Binding ShowOnlineOnly}"
                                  VerticalAlignment="Center" />
                        <Button Content="Friend changes"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5"
                                FontSize="10.5"
                                Margin="14,0,0,0"
                                Command="{Binding OpenFriendChangesCommand}"
                                ToolTip="Friended and unfriended events seen since the last refresh" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Grid.ColumnSpan="3"
                             ItemsSource="{Binding FriendFilters}"
                             SelectedItem="{Binding SelectedFriendFilter, Mode=TwoWay}"
                             Style="{StaticResource RegionPillList}"
                             Margin="0,8,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="8"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding FriendsSummary}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Friend list -->
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="6">
                        <Grid>
                            <ListBox Style="{StaticResource FriendListBox}"
                                     ItemsSource="{Binding FriendsView}"
                                     SelectedItem="{Binding SelectedFriend, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="42" Height="42" Margin="0,0,11,0">
                                                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AvatarUrl}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding AvatarUrl, Converter={StaticResource StringEmptyToVis}}" />
                                                <Ellipse Width="11" Height="11"
                                                         Fill="{Binding StatusBrush}"
                                                         Stroke="{StaticResource PanelBrush}"
                                                         StrokeThickness="2"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-1,-1" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubText}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" />
                                                <TextBlock Text="{Binding LocationText}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <Border Background="{StaticResource InputBrush}"
                                                        CornerRadius="8"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBrush}" />
                                                </Border>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="Join"
                                                        Padding="8,2"
                                                        FontSize="9.5"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsJoinable, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding ActivityText}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding HasNoVisibleFriends, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE716;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FriendsEmptyMessage}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,10,0,0"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                </Grid>

                <!-- Launch mode bar -->
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LAUNCH AS"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="LaunchMode"
                                         Content="Desktop"
                                         Foreground="{StaticResource TextBrush}"
                                         IsChecked="{Binding IsDesktopDefault, Mode=TwoWay}"
                                         Margin="0,0,14,0" />
                            <RadioButton GroupName="LaunchMode"
                                         Content="VR"
                                         Foreground="{StaticResource TextBrush}"
                                         IsChecked="{Binding IsVrDefault, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LaunchDefaultText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="18,0,12,0"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="3"
                                Style="{StaticResource SecondaryButton}"
                                Content="Open VRChat"
                                Padding="12,6"
                                FontSize="11"
                                Command="{Binding OpenVrChatCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Notifications                                             -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="NotificationsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NotificationsSummary}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SmallButton}"
                            Content="Mark all read"
                            Command="{Binding MarkAllReadCommand}"
                            Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Notification filters -->
                    <ListBox ItemsSource="{Binding NotificationFilters}"
                             SelectedItem="{Binding SelectedNotificationFilter, Mode=TwoWay}"
                             Style="{StaticResource RegionPillList}"
                             Margin="0,0,0,12"
                             Grid.Row="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="8"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Notification list + detail -->
                    <Grid Grid.Row="1">

                    <!-- Notification list -->
                    <Border
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="6">
                        <Grid>
                            <ListBox Style="{StaticResource BareListBox}"
                                     ItemsSource="{Binding Notifications}"
                                     SelectedItem="{Binding SelectedNotification, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}" Background="{Binding RowBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="3"
                                                        Background="{Binding TypeBrush}"
                                                        CornerRadius="2"
                                                        Margin="0,1,12,1"
                                                        Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />

                                                <Border Grid.Column="1"
                                                        Background="{StaticResource InputBrush}"
                                                        BorderBrush="{Binding TypeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="7,4"
                                                        Width="60"
                                                        Height="42"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,13,0">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               FontSize="8.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TypeBrush}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MessageText}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SenderLine}"
                                                               Style="{StaticResource MutedText}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding DetailsText}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>

                                                <WrapPanel Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Accept"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Accept this friend request"
                                                            Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanAcceptFriendRequest, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Join"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Launch VRChat into this instance"
                                                            Command="{Binding DataContext.JoinInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanJoinInvite, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Mark read"
                                                            ToolTip="Mark this notification as read"
                                                            Command="{Binding DataContext.MarkNotificationSeenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding HasNoNotifications, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xEA8F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="26"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="You're all caught up."
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Invites, friend requests, and group updates will show up here."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Notification detail popup -->
                    <Grid Visibility="{Binding HasSelectedNotification, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding ClearNotificationSelectionCommand}"
                                Focusable="False"
                                Cursor="Arrow"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="560"
                                MaxHeight="740"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,18,18,22">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          DataContext="{Binding NotificationDetail}">
                                <StackPanel Margin="0,0,0,0">
                                    <!-- Sender avatar + name -->
                                    <StackPanel Margin="0,0,0,14">
                                        <Ellipse Width="72" Height="72">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding SenderAvatarUrl}"
                                                            Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding SenderName}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,2" />
                                        <TextBlock Text="{Binding SenderHandle}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SenderStatusLabel}"
                                                   FontSize="9.5"
                                                   Foreground="{Binding SenderStatusBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="From" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SenderName}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding SenderProfileUrl}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />

                                    <Button Style="{StaticResource GhostButton}"
                                            Content="Open profile on vrchat.com"
                                            Padding="0,4"
                                            FontSize="10.5"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding DataContext.OpenFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding SenderProfileUrl}"
                                            Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}" />

                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="View full profile"
                                            Height="36"
                                            Margin="0,10,0,0"
                                            Command="{Binding DataContext.ShowSenderProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}" />

                                    <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,16,0,12" />

                                    <!-- Type & details -->
                                    <TextBlock Text="Details" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding TypeBrush}"
                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TypeBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding MessageText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding DetailsText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasDetailsText, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ReceivedText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0" />

                                    <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,16,0,12" />

                                    <!-- Actions -->
                                    <TextBlock Text="Actions" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Accept friend request"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanAcceptFriendRequest, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Join instance"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.JoinInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanJoinInvite, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{Binding UserLocationLine, StringFormat='Join their world ({0})'}"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.JoinNotificationUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanJoinUser, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Mark as read"
                                            Height="40"
                                            Command="{Binding DataContext.MarkNotificationSeenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />

                                    <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,16,0,12" />

                                    <!-- World info -->
                                    <Border Visibility="{Binding HasWorld, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="Invited world" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding WorldName}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding WorldAuthorText}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,0" />
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="Open world details"
                                                    Padding="0,4"
                                                    FontSize="10.5"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Notification.InviteLocation}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Tap a notification on the left to see who it's from."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasSelectedNotification, Converter={StaticResource InverseBoolToVis}}" />
                                 </StackPanel>
                             </ScrollViewer>
                         </Border>
                     </Grid>
                 </Grid>
                 </Grid>
             </Grid>
         </DataTemplate>

        <!-- ========================================================= -->
        <!-- Worlds                                                    -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="WorldsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,0">
                            <TextBlock Text="Search worlds" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,9,0,0">
                                <TextBox x:Name="WorldSearchBox"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding WorldQuery, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="WorldSearchBox_KeyDown" />
                                <TextBlock Text="Search the public VRChat world catalogâ€¦"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorldQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="Try"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="The Great Pug"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="The Great Pug" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="Black Cat"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="Black Cat" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="Midnight Rooftop"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="Midnight Rooftop" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="Search"
                                Padding="20,9"
                                VerticalAlignment="Bottom"
                                Command="{Binding SearchWorldsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="16,13"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Quick join an instance" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Paste a vrchat:// launch link, vrch.at short link, full world:instance location, or instance ID."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,9" />
                            <Grid>
                                <TextBox x:Name="QuickJoinBox"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding QuickJoinInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="QuickJoinBox_KeyDown" />
                                <TextBlock Text="vrchat://launch?ref=vrchat.com&amp;id=wrld_â€¦:â€¦"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickJoinInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Content="Join"
                                Padding="22,9"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"
                                Command="{Binding QuickJoinCommand}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding WorldsSummary}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,9" />

                <Grid Grid.Row="3">
                    <ListBox Style="{StaticResource WorldListBox}"
                             ItemsSource="{Binding Worlds}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WorldCardButton}"
                                        ToolTip="Open world details, create or join an instance"
                                        Command="{Binding DataContext.OpenWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid Height="132" Margin="0,0,0,9">
                                            <Border CornerRadius="10" Background="{StaticResource AccentGradient}" />
                                            <TextBlock Text="&#xE909;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="30"
                                                       Foreground="{StaticResource WhiteBrush}"
                                                       Opacity="0.55"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#CC0B0D12"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    Margin="8">
                                                <TextBlock Text="{Binding PlatformsText}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AuthorText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding MetaText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"
                                                   Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TagsText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Open details"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                            <TextBlock Text="&#xE8A7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource EmptyStateCard}"
                            Visibility="{Binding HasNoWorlds, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="&#xE909;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WorldsEmptyMessage}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Settings: backdrop, appearance, app preferences             -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="SettingsTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>

                    <!-- Backdrop / appearance -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Background" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Make the app come alive with an animated backdrop."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,12" />

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Style" Style="{StaticResource FieldLabel}" />
                                <ListBox ItemsSource="{Binding BackdropStyles}"
                                         SelectedItem="{Binding SelectedBackdropStyle, Mode=TwoWay}"
                                         Style="{StaticResource RegionPillList}"
                                         MaxHeight="60">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Animated" Style="{StaticResource FieldLabel}" />
                                <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                          Content="Animate the backdrop"
                                          IsChecked="{Binding AnimateBackdrop}"
                                          Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Dim overlay" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Darkens the backdrop so content stays readable."
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,8" />
                                <Slider Minimum="0" Maximum="0.7"
                                        Value="{Binding BackdropDim}"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,4,0,0" />
                                <TextBlock Text="{Binding BackdropDim, StringFormat={}{0:P0}}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Custom image" Style="{StaticResource FieldLabel}" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Choose PNG / GIFâ€¦"
                                        Padding="12,7"
                                        FontSize="11"
                                        Margin="10,0,0,0"
                                        Command="{Binding ChooseBackdropCommand}" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Reset"
                                        Padding="10,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearBackdropCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding BackdropFileName}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding HasCustomBackdrop, Converter={StaticResource BoolToVis}}" />

                            <!-- URL paste input -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Or paste an image URL" Style="{StaticResource FieldLabel}" />
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding BackdropUrlInput, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InputBox}">
                                                <Setter Property="Tag" Value="https://example.com/image.gif" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                        <Setter Property="Tag" Value="https://example.com/image.gif" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Download"
                                            Padding="12,7"
                                            FontSize="11"
                                            Margin="8,0,0,0"
                                            Command="{Binding DownloadBackdropFromUrlCommand}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Profile popup background -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Profile popup background" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Use a PNG or GIF behind friend and profile popups. GIFs animate."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Choose PNG / GIF…"
                                        Padding="12,7"
                                        FontSize="11"
                                        Command="{Binding ChooseProfileBackdropCommand}" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Reset"
                                        Padding="10,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearProfileBackdropCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding ProfileBackdropFileName}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- New feature settings -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Activity Feed" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Configure how the activity timeline behaves."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,12" />

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Default filter" Style="{StaticResource FieldLabel}" />
                                <ListBox SelectedItem="{Binding ActivityDefaultFilter}"
                                         Style="{StaticResource RegionPillList}"
                                         MaxHeight="44">
                                    <ListBox.Items>
                                        <sys:String>all</sys:String>
                                        <sys:String>FriendOnline</sys:String>
                                        <sys:String>FriendJoinedWorld</sys:String>
                                        <sys:String>FriendOffline</sys:String>
                                    </ListBox.Items>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource InputBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,10">
                                <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                          Content="Show offline friends in activity feed"
                                          IsChecked="{Binding ActivityShowOfflineFriends}"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Multi-Account" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Manage multiple VRChat accounts. Only auth cookies are stored, encrypted with Windows DPAPI."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,12" />

                            <TextBlock Text="Last active account" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding LastActiveAccountId, TargetNullValue='(none)'}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Switch accounts in the Accounts section."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,12" />
                        </StackPanel>
                    </Border>

                    <!-- App info -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="VRChat Companion"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Unofficial VRChat companion app."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Your auth cookie is encrypted with Windows DPAPI. Your password is never stored."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Sign out"
                                    Command="{Binding LogoutCommand}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- New section templates                                     -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="AvatarsTemplate">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18"
                          Visibility="{Binding AvatarViewModel.IsAvatarDetailsOpen, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <!-- Search bar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Search avatars" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AvatarViewModel.SearchTerm, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource InputBox}"
                                         Tag="Search by name, author, or tags..." />
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Search"
                                        Padding="14,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding AvatarViewModel.SearchCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Refresh"
                                        Padding="14,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding AvatarViewModel.RefreshCommand}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AvatarViewModel.SummaryText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,5"
                                            FontSize="10.5"
                                            Margin="0,0,6,0"
                                            Command="{Binding AvatarViewModel.RevertPreviousAvatarCommand}"
                                            Visibility="{Binding AvatarViewModel.CanRevertPrevious, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Go back to the avatar you were wearing before the last change">
                                        <TextBlock Text="{Binding AvatarViewModel.PreviousAvatarName, StringFormat='Back to {0}'}" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,5"
                                            FontSize="10.5"
                                            Command="{Binding AvatarViewModel.WearOriginalAvatarCommand}"
                                            Visibility="{Binding AvatarViewModel.CanRevertAvatar, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Put back the avatar you were wearing when the app started">
                                        <TextBlock Text="{Binding AvatarViewModel.OriginalAvatarName, StringFormat='Session start: {0}'}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Avatar grid -->
                    <ItemsControl ItemsSource="{Binding AvatarViewModel.Avatars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}"
                                        Width="220"
                                        Margin="0,0,16,16"
                                        Command="{Binding DataContext.AvatarViewModel.OpenAvatarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Avatar image -->
                                        <Border Grid.Row="0"
                                                Width="140" Height="140"
                                                CornerRadius="10"
                                                Background="{StaticResource InputBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top">
                                            <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                 DecodeWidth="256" />
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding AuthorName}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="6"
                                                    Padding="7,3"
                                                    Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding IsWearing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="WEARING"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>

                                            <WrapPanel Margin="0,8,0,0">
                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource InputBrush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="6,2"
                                                                    Margin="0,0,4,4">
                                                                <TextBlock Text="{Binding}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>

                                            <StackPanel Orientation="Horizontal"
                                                      Margin="0,10,0,0"
                                                      HorizontalAlignment="Right">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE735;|&#xE734;}"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AvatarViewModel.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Busy / error -->
                    <TextBlock Text="Loading your avatarsâ€¦"
                               Style="{StaticResource MutedText}"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding AvatarViewModel.StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource GreenBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.StatusMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding AvatarViewModel.ErrorMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </ScrollViewer>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarSearchTemplate">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="26,2,18,18"
                              behaviors:ScrollViewerBehavior.PageToken="{Binding AvatarViewModel.ResultsPageToken}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Search every VRChat avatar" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding AvatarViewModel.GlobalSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}"
                                             Tag="Avatar name or author..." />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="Search"
                                            Padding="14,7"
                                            FontSize="11"
                                            Margin="8,0,0,0"
                                            Command="{Binding AvatarViewModel.GlobalSearchCommand}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Clear"
                                            Padding="14,7"
                                            FontSize="11"
                                            Margin="8,0,0,0"
                                            Command="{Binding AvatarViewModel.ClearGlobalSearchCommand}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox Content="Public only"
                                              IsChecked="{Binding AvatarViewModel.PublicOnly, Mode=TwoWay}"
                                              Foreground="{StaticResource MutedBrush}"
                                              FontSize="11"
                                              VerticalAlignment="Center"
                                              ToolTip="Hide private avatars from results" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Refresh browse"
                                            Padding="12,6"
                                            FontSize="10.5"
                                            Margin="14,0,0,0"
                                            Command="{Binding AvatarViewModel.RefreshBrowseCommand}"
                                            ToolTip="Reload the community public list" />
                                </StackPanel>
                                <TextBlock Text="{Binding AvatarViewModel.GlobalSummaryText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AvatarViewModel.CommunityStatusText}"
                                           FontSize="9"
                                           Foreground="{StaticResource DimBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AvatarViewModel.GlobalError}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding AvatarViewModel.GlobalResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="220" Margin="0,0,16,16">
                                        <StackPanel>
                                            <Button Style="{StaticResource CardButton}"
                                                    Command="{Binding DataContext.AvatarViewModel.OpenAvatarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}">
                                                <StackPanel>
                                                    <Border Width="140" Height="140"
                                                            CornerRadius="10"
                                                            Background="{StaticResource InputBrush}"
                                                            HorizontalAlignment="Center">
                                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="256" />
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,10,0,2" />
                                                    <TextBlock Text="{Binding AuthorName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border CornerRadius="5"
                                                            Padding="6,2"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Left">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource InputBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ReleaseStatusBadge}"
                                                                   FontSize="8.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding PrivacyHint}"
                                                               FontSize="9.5"
                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding SourceLabel}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding HasSourceName, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource SmallButton}"
                                                        Content="Wear"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AvatarViewModel.WearAvatarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE735;|&#xE734;}"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.AvatarViewModel.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding IsLocalFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE840;|&#xE718;}"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.AvatarViewModel.ToggleLocalFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,12">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Previous"
                                    Padding="14,8"
                                    Margin="0,0,10,0"
                                    Command="{Binding AvatarViewModel.PreviousGlobalPageCommand}"
                                    Visibility="{Binding AvatarViewModel.HasPreviousGlobal, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Next"
                                    Padding="14,8"
                                    Command="{Binding AvatarViewModel.NextGlobalPageCommand}"
                                    Visibility="{Binding AvatarViewModel.HasNextGlobal, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FavoritesTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Favourite avatars on VRChat" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding AvatarViewModel.FavoritesSummaryText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AvatarViewModel.VrcPlusFavoritesText}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource DimBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AvatarViewModel.FavoritesLoadingText}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding AvatarViewModel.FavoriteSlots}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="0,0,8,8"
                                                Cursor="Hand"
                                                ToolTip="Show only this favourite slot"
                                                AutomationProperties.Name="{Binding Label, StringFormat='Show {0}'}"
                                                Command="{Binding DataContext.AvatarViewModel.SelectSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Border BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="10,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource InputBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Summary, StringFormat=' Â· {0}'}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding AvatarViewModel.ActiveSlotText}"
                                       FontSize="10"
                                       Foreground="{StaticResource DimBrush}"
                                       Margin="0,2,0,0" />

                            <Button Style="{StaticResource GhostButton}"
                                    Padding="9,5"
                                    FontSize="10.5"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding AvatarViewModel.RevertPreviousAvatarCommand}"
                                    Visibility="{Binding AvatarViewModel.CanRevertPrevious, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Go back to the avatar you were wearing before the last change">
                                <TextBlock Text="{Binding AvatarViewModel.PreviousAvatarName, StringFormat='Back to {0}'}" />
                            </Button>

                            <StackPanel Margin="0,4,0,0"
                                        Visibility="{Binding AvatarViewModel.HasUnresolvedFavorites, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AvatarViewModel.UnresolvedFavoritesText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding AvatarViewModel.UnresolvedFavoriteIds}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="Open favourite on vrchat.com"
                                                    Margin="0,0,6,6"
                                                    Command="{Binding DataContext.AvatarViewModel.OpenAvatarOnWebCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding AvatarViewModel.FavoriteAvatars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Width="220"
                                        Margin="0,0,16,16">
                                    <StackPanel>
                                        <Button Style="{StaticResource CardButton}"
                                                Command="{Binding DataContext.AvatarViewModel.OpenAvatarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="Open this avatar">
                                            <StackPanel>
                                                <Border Width="140" Height="140"
                                                        CornerRadius="10"
                                                        Background="{StaticResource InputBrush}"
                                                        HorizontalAlignment="Center">
                                                    <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="256" />
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,10,0,2" />
                                                <TextBlock Text="{Binding AuthorName}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="7,3"
                                                Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsWearing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="WEARING"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="Wear"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.AvatarViewModel.WearAvatarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE735;|&#xE734;}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    Margin="0,0,6,0"
                                                    ToolTip="VRChat favourite: add or remove"
                                                    Command="{Binding DataContext.AvatarViewModel.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding IsLocalFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE840;|&#xE718;}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    ToolTip="Local slot: save without VRChat's limit"
                                                    Command="{Binding DataContext.AvatarViewModel.ToggleLocalFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource EmptyStateCard}"
                            Visibility="{Binding AvatarViewModel.FavoriteAvatars.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="&#xE735;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="No favourite avatars yet"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="Star an avatar on the Avatars tab and it is saved to your VRChat favourites."
                                       Style="{StaticResource MutedText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="GroupsTemplate">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Create Group"
                                Padding="14,8"
                                FontSize="11"
                                Command="{Binding GroupViewModel.CreateGroupCommand}"
                            />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Refresh"
                                Padding="12,8"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Command="{Binding LoadGroupsCommand}" />
                    </StackPanel>

                    <!-- Joined group filter -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SEARCH YOUR GROUPS" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GroupViewModel.GroupFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Tag="Filter joined groups by name..." />
                        </StackPanel>
                    </Border>

                    <!-- Group discovery -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DISCOVER GROUPS" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Search VRChat for public groups by name or group ID."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,8"
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GroupViewModel.GroupDiscoveryQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         Margin="0,0,8,0"
                                         Tag="Group name or grp_... ID" />
                                <Button Grid.Column="1"
                                        Content="Search"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,8"
                                        FontSize="11"
                                        Command="{Binding GroupViewModel.SearchGroupsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding GroupViewModel.GroupSearchMessage}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding GroupViewModel.GroupSearchResults}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="8"
                                                        Background="#151A24" Margin="0,0,10,0">
                                                    <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                         DecodeWidth="96"
                                                                         CornerRadius="8" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MemberCount, StringFormat='{}{0} members'}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="View"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,5"
                                                        FontSize="10.5"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.GroupViewModel.OpenDiscoveredGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <TextBlock Text="{Binding GroupViewModel.ErrorMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding GroupViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                    <!-- Group list -->
                    <ListBox ItemsSource="{Binding GroupViewModel.VisibleGroups}"
                             SelectedItem="{Binding GroupViewModel.SelectedGroup, Mode=TwoWay}"
                             Style="{StaticResource BareListBox}"
                             ItemContainerStyle="{StaticResource BareListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="16,14"
                                        Cursor="Hand"
                                        ToolTip="Open group details"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Group icon -->
                                        <Border Grid.Column="0"
                                                Width="56" Height="56"
                                                CornerRadius="14"
                                                Background="{StaticResource InputBrush}"
                                                Margin="0,0,14,0">
                                            <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                 DecodeWidth="128" />
                                        </Border>

                                        <!-- Group info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding MemberCount, StringFormat='{}{0} members'}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <Border Visibility="{Binding GroupViewModel.VisibleGroups.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"
                            Style="{StaticResource EmptyStateCard}">
                        <StackPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="32" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GroupViewModel.GroupListEmptyText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="{Binding GroupViewModel.GroupListEmptyHint}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

                <!-- Group details popup -->
                <Grid Visibility="{Binding GroupViewModel.IsGroupDetailsOpen, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding GroupViewModel.CloseGroupDetailsCommand}"
                            Focusable="False"
                            Cursor="Arrow"
                            ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#C4060810" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Width="620"
                            MaxHeight="740"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            DataContext="{Binding GroupViewModel.SelectedGroup}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="20,16"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52" Height="52"
                                            CornerRadius="14"
                                            Background="{StaticResource InputBrush}"
                                            Margin="0,0,14,0">
                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="128" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MemberCount, StringFormat='{}{0} members'}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Padding="7,4"
                                            Command="{Binding DataContext.GroupViewModel.CloseGroupDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Close">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="20,16,20,20">
                                <StackPanel>
                                    <TextBlock Text="ABOUT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               LineHeight="19"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Group details"
                                                Padding="12,6"
                                                FontSize="11"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.GroupViewModel.OpenSelectedGroupInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Instances, membership and join or leave" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Open on vrchat.com"
                                                Padding="12,6"
                                                FontSize="11"
                                                Command="{Binding DataContext.GroupViewModel.OpenSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Refresh members"
                                                Padding="12,6"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.GroupViewModel.RefreshMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,16,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="ACTIVE INSTANCES" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            <Button Content="Refresh"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.GroupViewModel.RefreshInstancesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBlock Text="Loading instances…"
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding DataContext.GroupViewModel.IsLoadingInstances, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="No group instances are open right now."
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding DataContext.GroupViewModel.NoInstances, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Instances, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="10"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="40" Height="40" CornerRadius="8" Background="#151A24" Margin="0,0,10,0">
                                                                <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="96" CornerRadius="8" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding WorldName}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DetailsText}" FontSize="10"
                                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Content="Join"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="10,5"
                                                                    FontSize="10.5"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.GroupViewModel.JoinGroupInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="{Binding DataContext.GroupViewModel.MembersSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,14,0,6" />

                                    <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Members, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource InputBrush}"
                                                        CornerRadius="8"
                                                        Padding="10,6"
                                                        Margin="0,0,0,5">
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>
                    <!-- Filter chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Filter" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                        <ListBox SelectedItem="{Binding ActivityFeedViewModel.SelectedFilter, Mode=TwoWay}"
                                 Style="{StaticResource RegionPillList}"
                                 MaxHeight="44">
                            <ListBox.Items>
                                <x:Static Member="m:ActivityType.FriendOnline" />
                                <x:Static Member="m:ActivityType.FriendJoinedWorld" />
                                <x:Static Member="m:ActivityType.FriendOffline" />
                                <x:Static Member="m:ActivityType.BioChanged" />
                                <x:Static Member="m:ActivityType.AvatarChanged" />
                                <x:Static Member="m:ActivityType.FriendAdded" />
                                <x:Static Member="m:ActivityType.FriendRemoved" />
                            </ListBox.Items>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Search -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Search activity" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ActivityFeedViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Tag="Search by friend name, world, or activity..." />
                        </StackPanel>
                    </Border>

                    <!-- Activity list -->
                    <ItemsControl ItemsSource="{Binding ActivityFeedViewModel.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14,12"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar (clickable for avatar changes) -->
                                        <Button Grid.Column="0"
                                                Width="40" Height="40"
                                                Margin="0,0,12,0"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                IsEnabled="{Binding HasAvatar}"
                                                ToolTip="Open this avatar's details to wear or favourite it"
                                                Command="{Binding DataContext.OpenActivityAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Background="{StaticResource InputBrush}">
                                                <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                     DecodeWidth="96" />
                                            </Border>
                                        </Button>

                                        <!-- Activity details (opens the live VRChat profile) -->
                                        <Button Grid.Column="1"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                ToolTip="Open this person's VRChat profile"
                                                Command="{Binding DataContext.OpenActivityUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text=" Â· " Style="{StaticResource MutedText}" />
                                                    <TextBlock Text="{Binding Details}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding RelativeTime}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource DimBrush}" />
                                                    <TextBlock Text=" Â· " Style="{StaticResource MutedText}" FontSize="10" />
                                                    <TextBlock Text="{Binding Type}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Refresh -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Refresh"
                                Padding="12,6"
                                FontSize="11"
                                Command="{Binding LoadActivityFeedCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="AccountsTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Switch between multiple VRChat accounts."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Active account -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Active Account" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding MultiAccountViewModel.ActiveAccountLabel}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Only auth cookies are stored, encrypted with Windows DPAPI."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Save the signed-in account -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Save Account" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Saves the session of the account you are signed in with, so you can switch back to it later."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,8" />
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Save current account"
                                    Padding="14,7"
                                    FontSize="11"
                                    HorizontalAlignment="Left"
                                    Command="{Binding MultiAccountViewModel.AddAccountCommand}" />
                            <TextBlock Text="{Binding MultiAccountViewModel.ErrorMessage}"
                                       Style="{StaticResource MutedText}"
                                       Foreground="{StaticResource ErrorTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding MultiAccountViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <!-- Account list -->
                    <TextBlock Text="Registered Accounts" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding MultiAccountViewModel.Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="14,12"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Id}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Switch"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.MultiAccountViewModel.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="Remove"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.MultiAccountViewModel.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="MediaTemplate">
            <Grid Margin="28,24,28,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaViewModel.SummaryText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E6E9F0" />
                        <TextBlock Text="{Binding MediaViewModel.RootPath}"
                                   Foreground="#5F6779" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{Binding MediaViewModel.ShowAllText}"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.ToggleShowAllCommand}"
                                Padding="12,6" FontSize="11"
                                Margin="0,0,8,0"
                                Visibility="{Binding MediaViewModel.HasHiddenPictures, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.OpenFolderCommand}"
                                Padding="12,6" FontSize="11" />
                        <Button Content="Refresh"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.RefreshCommand}"
                                Padding="12,6" FontSize="11" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MediaViewModel.DisplayedGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#E6E9F0" FontWeight="SemiBold"
                                               Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="0" BorderThickness="0"
                                                        Background="Transparent"
                                                        Margin="0,0,8,8"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding FileName}"
                                                        Command="{Binding DataContext.MediaViewModel.OpenViewerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter x:Name="Card" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border Width="220" Height="140"
                                                            CornerRadius="8"
                                                            ClipToBounds="True"
                                                            Background="#151A24">
                                                        <controls:AsyncImage SourceUrl="{Binding Path}"
                                                                             DecodeWidth="320"
                                                                             CornerRadius="8" />
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           Text="{Binding MediaViewModel.LoadingText}"
                           Foreground="#8C93A6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding MediaViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding MediaViewModel.HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{StaticResource ErrorTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MediaViewModel.ErrorMessage}"
                               Foreground="#C9CEDC"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               MaxWidth="420"
                               TextWrapping="Wrap" />
                    <Button Content="Retry"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding MediaViewModel.RefreshCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding MediaViewModel.EmptyMessage}"
                           Foreground="#8C93A6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding MediaViewModel.IsEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- In-app picture viewer (popup instead of the Windows photo app) -->
                <Grid Grid.RowSpan="2" Panel.ZIndex="10"
                      Visibility="{Binding MediaViewModel.IsViewerOpen, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding MediaViewModel.CloseViewerCommand}"
                            Focusable="False"
                            Cursor="Arrow"
                            ToolTip="Close picture">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F2070910" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Margin="26,18,26,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="{Binding MediaViewModel.ViewerTitle}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#E6E9F0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,240,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Open in Explorer"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="11,6"
                                        FontSize="11"
                                        Command="{Binding MediaViewModel.OpenSelectedInShellCommand}" />
                                <Button Content="Close"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="11,6"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding MediaViewModel.CloseViewerCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="#0B0D12"
                                BorderBrush="{StaticResource SoftBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Image Source="{Binding MediaViewModel.ViewerImage}"
                                   Stretch="Uniform"
                                   Margin="10" />
                        </Border>

                        <Button Grid.Row="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}"
                                Padding="12,16"
                                FontSize="16"
                                Content="&#xE76B;"
                                FontFamily="Segoe MDL2 Assets"
                                Command="{Binding MediaViewModel.PreviousImageCommand}" />
                        <Button Grid.Row="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource GhostButton}"
                                Padding="12,16"
                                FontSize="16"
                                Content="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"
                                Command="{Binding MediaViewModel.NextImageCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChatboxTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18">
                <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Magic Chatbox" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="VRChat must have OSC enabled: Action Menu → Options → OSC → Enabled. Messages go to the local VRChat client over UDP."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,12" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding ChatboxViewModel.MessageText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="144"
                                     ToolTip="Up to 144 characters, like VRChat's chatbox" />
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="{Binding ChatboxViewModel.MessageCountText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Add to rotation"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,6"
                                            FontSize="11"
                                            Margin="0,0,8,0"
                                            Command="{Binding ChatboxViewModel.AddToRotationCommand}" />
                                    <Button Content="Send now"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,7"
                                            FontSize="11"
                                            Command="{Binding ChatboxViewModel.SendCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Now playing" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ChatboxViewModel.NowPlayingText}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,5,90,0" />
                                    <TextBlock Text="{Binding ChatboxViewModel.RemainingText}"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Margin="0,2,90,0" />
                                    <TextBlock Text="Detected from Windows media sessions, including Spotify and YouTube in your browser."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="#2A1E4A"
                                        CornerRadius="5"
                                        Padding="7,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding ChatboxViewModel.HasNowPlaying, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ChatboxViewModel.NowPlayingSource}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentHoverBrush}" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Use now playing"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        FontSize="11"
                                        Margin="0,0,8,0"
                                        Command="{Binding ChatboxViewModel.UseNowPlayingCommand}" />
                                <Button Content="Add now playing to rotation"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        FontSize="11"
                                        Command="{Binding ChatboxViewModel.AddNowPlayingToRotationCommand}" />
                            </StackPanel>
                            <TextBlock Text="Tip: put {music} in any message and it is replaced with the current track when sent."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0" />
                            <CheckBox Content="Keep the current track in rotation ({music})"
                                      Style="{StaticResource FriendlyCheckBox}"
                                      IsChecked="{Binding ChatboxViewModel.IncludeNowPlayingInRotation, Mode=TwoWay}"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Lyrics" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ChatboxViewModel.LyricsText}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="{Binding ChatboxViewModel.LyricsStatusText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ChatboxViewModel.LyricsMatchText}"
                                       Style="{StaticResource MutedText}"
                                       Visibility="{Binding ChatboxViewModel.HasLyricsMatch, Converter={StaticResource BoolToVis}}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="Show lyrics on the VRChat chatbox"
                                          Style="{StaticResource FriendlyCheckBox}"
                                          IsChecked="{Binding ChatboxViewModel.ShowLyricsOnVrchat, Mode=TwoWay}"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <Button Content="Retry lyrics"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        FontSize="11"
                                        Margin="0,0,8,0"
                                        Command="{Binding ChatboxViewModel.RetryLyricsCommand}" />
                                <Button Content="Send lyric line"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="12,6"
                                        FontSize="11"
                                        Margin="0,0,8,0"
                                        Command="{Binding ChatboxViewModel.SendLyricCommand}" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Content="Pause lyrics after my message"
                                          Style="{StaticResource FriendlyCheckBox}"
                                          IsChecked="{Binding ChatboxViewModel.PauseLyricsAfterMessage, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Text="for"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBox Width="54"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding ChatboxViewModel.LyricsPauseSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0" />
                                <TextBlock Text="seconds"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>
                            <Button Content="Resume lyrics now"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ChatboxViewModel.ResumeLyricsCommand}" />
                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="10"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Search LRCLIB manually"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Find the right lyrics when the automatic match is wrong."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,3,0,7" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding ChatboxViewModel.LyricsSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Song, artist, or both" />
                                        <Button Grid.Column="1"
                                                Content="Search"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,6"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding ChatboxViewModel.SearchLyricsCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ChatboxViewModel.LyricsSearchStatusText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap" />
                                    <ListBox ItemsSource="{Binding ChatboxViewModel.LyricsCandidates}"
                                             SelectedItem="{Binding ChatboxViewModel.SelectedLyricsCandidate, Mode=TwoWay}"
                                             Style="{StaticResource ChoiceListBox}"
                                             MaxHeight="170"
                                             Margin="0,6,0,0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Visibility="{Binding ChatboxViewModel.HasLyricsCandidates, Converter={StaticResource BoolToVis}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Snippet}"
                                                               FontSize="10.5"
                                                               FontStyle="Italic"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Use selected lyrics"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,6"
                                            FontSize="11"
                                            Margin="0,7,0,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ChatboxViewModel.UseSelectedLyricsCommand}" />
                                </StackPanel>
                            </Border>
                            <CheckBox Content="Show lyrics in rotation ({lyrics})"
                                      Style="{StaticResource FriendlyCheckBox}"
                                      IsChecked="{Binding ChatboxViewModel.ShowLyricsInRotation, Mode=TwoWay}"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="Shows the song on the VRChat chatbox and adds the current lyric when free lyrics are available. A typed message pauses automatic lyrics for the time above. Lyrics come from LRCLIB."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Rotation" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Cycle through these lines so the chatbox keeps changing."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Rotate messages automatically"
                                          Style="{StaticResource FriendlyCheckBox}"
                                          IsChecked="{Binding ChatboxViewModel.IsRotating, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="Every"
                                           Style="{StaticResource MutedText}"
                                           Margin="16,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBox Width="72"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding ChatboxViewModel.RotationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="Seconds between messages (minimum 5)" />
                                <TextBlock Text="seconds (minimum 5)"
                                           Style="{StaticResource MutedText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding ChatboxViewModel.RotationMessages}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,7"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <TextBlock Text="{Binding}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,80,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="Remove"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="8,3"
                                                        FontSize="10"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.ChatboxViewModel.RemoveMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No rotation messages yet. Type a message above and choose Add to rotation."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,10,0,0"
                                       Visibility="{Binding ChatboxViewModel.HasNoRotationMessages, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="OSC connection" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="These are saved automatically. VRChat listens on 127.0.0.1:9000 by default."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="220" Margin="0,0,12,0">
                                    <TextBlock Text="HOST" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding ChatboxViewModel.Host, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Width="110">
                                    <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding ChatboxViewModel.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ChatboxViewModel.StatusText}"
                               Foreground="{StaticResource AccentHoverBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="2,0,0,8" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- Section switching swaps ContentTemplate, which rebuilds each tab's visual
             tree; that recreation is what returns a tab to the top. Checked on
             friends (29 rows), notifications (24 items / 65 texts) and worlds (35
             rows) with the offset going 100 -> 0 and the same row counts, plus an
             active Avatar Search (50 cards, same status line). If these hosts are ever cached to keep tabs alive, each
             tab will need its own scroll reset or the offset will persist. -->
        <Style x:Key="SectionSwitcher" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource ProfileTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="friends">
                    <Setter Property="ContentTemplate" Value="{StaticResource FriendsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="notifications">
                    <Setter Property="ContentTemplate" Value="{StaticResource NotificationsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="worlds">
                    <Setter Property="ContentTemplate" Value="{StaticResource WorldsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="settings">
                    <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="avatars">
                    <Setter Property="ContentTemplate" Value="{StaticResource AvatarsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="favorites">
                    <Setter Property="ContentTemplate" Value="{StaticResource FavoritesTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="avatarsearch">
                    <Setter Property="ContentTemplate" Value="{StaticResource AvatarSearchTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="groups">
                    <Setter Property="ContentTemplate" Value="{StaticResource GroupsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="activity">
                    <Setter Property="ContentTemplate" Value="{StaticResource ActivityTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="accounts">
                    <Setter Property="ContentTemplate" Value="{StaticResource AccountsTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="media">
                    <Setter Property="ContentTemplate" Value="{StaticResource MediaTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedSection.Key}" Value="chatbox">
                    <Setter Property="ContentTemplate" Value="{StaticResource ChatboxTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

