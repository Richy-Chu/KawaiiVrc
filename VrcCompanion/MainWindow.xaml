                                        Content="Use authenticator instead"
                                        Padding="0,2"
                                        Margin="0,0,12,0"
                                        FontSize="10.5"
                                        Command="{Binding UseTotpCodeCommand}"
                                        Visibility="{Binding ShowTotpSwitchLink, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Use a recovery code"
                                        Padding="0,2"
                                        Margin="0,0,12,0"
                                        FontSize="10.5"
                                        Command="{Binding UseRecoveryCodeCommand}"
                                        Visibility="{Binding ShowRecoverySwitchLink, Converter={StaticResource BoolToVis}}" />
