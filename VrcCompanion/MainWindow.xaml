                                                    CommandParameter="{Binding Id}">
                                                <StackPanel>
                                                    <Border Width="140" Height="140"
                                                            CornerRadius="10"
                                                            Background="{StaticResource InputBrush}"
                                                            HorizontalAlignment="Center">
                                                        <Grid>
                                                            <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="160">
                                                                <controls:AsyncImage.Style>
                                                                    <Style TargetType="{x:Type controls:AsyncImage}">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasSecurityCheckFailed}" Value="True">
