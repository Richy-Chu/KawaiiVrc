                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->

        <!-- ========================================================= -->
                    <!-- Friend detail popup -->
                    <Grid x:Name="FriendProfileOverlay"
                          Panel.ZIndex="{Binding ProfileZIndex}"
                          AutomationProperties.AutomationId="FriendProfileOverlay"
                          Visibility="{Binding HasSelectedFriend, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding CloseFriendDetailCommand}"
                                Focusable="False"
                                Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="640"
                                MaxHeight="760"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{Binding SelectedFriendDetail.ProfileButtonBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Border CornerRadius="15" ClipToBounds="True"
                                        Visibility="{Binding HasProfileBackdrop, Converter={StaticResource BoolToVis}}">
                                    <controls:ImageBackdrop SourcePath="{Binding ProfileBackdropPath}"
                                                            Animate="{Binding AnimateBackdrop}" />
                                </Border>
                                <Border Background="#B30B0D12" CornerRadius="15"
                                        AutomationProperties.AutomationId="ProfileBackdropScrim"
                                        Visibility="{Binding HasProfileBackdrop, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          DataContext="{Binding SelectedFriendDetail}">
                                <ScrollViewer.Resources>
                                    <Style x:Key="ProfileSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                        <Setter Property="Foreground" Value="{Binding ProfileNameBrush}" />
                                    </Style>
                                    <Style x:Key="ProfileMutedText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Foreground" Value="{Binding ProfileSubtextBrush}" />
                                    </Style>
                                    <Style x:Key="ProfileSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Foreground" Value="{Binding ProfileButtonBrush}" />
                                        <Setter Property="BorderBrush" Value="{Binding ProfileButtonBrush}" />
                                    </Style>
                                    <Style x:Key="ProfileGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Foreground" Value="{Binding ProfileButtonBrush}" />
                                    </Style>
                                    <Style x:Key="ProfilePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Background" Value="{Binding ProfileButtonBrush}" />
                                        <Setter Property="Foreground" Value="{Binding ProfileButtonTextBrush}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ButtonBorder"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="10"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                                                            <Setter Property="Cursor" Value="Arrow" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ProfileScrollThumbStyle" TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBorder"
                                                            Background="{Binding ProfileButtonBrush}"
                                                            CornerRadius="4"
                                                            Margin="2,0" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.82" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <ControlTemplate x:Key="ProfileVerticalScrollBarTemplate" TargetType="ScrollBar">
                                        <Grid Width="10" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                                  Opacity="0"
                                                                  Focusable="False"
                                                                  IsTabStop="False" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ProfileScrollThumbStyle}" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                                  Opacity="0"
                                                                  Focusable="False"
                                                                  IsTabStop="False" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template" Value="{StaticResource ProfileVerticalScrollBarTemplate}" />
                                        <Style.Triggers>
                                            <Trigger Property="Orientation" Value="Horizontal">
                                                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel Margin="20,18,18,22">
