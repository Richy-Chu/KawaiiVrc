                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ReleaseStatusBadge}"
                                                                   FontSize="8.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource DimBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagChip}"
                                                            Padding="6,2"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding HasPlatforms, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding PlatformsText}"
                                                                   Style="{StaticResource TagText}"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                    <ContentControl Content="{Binding TagLabels}"
                                                                    ContentTemplate="{StaticResource AvatarTagChips}"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="0,4,0,0"
                                                                    Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding PrivacyHint}"
                                                               FontSize="9.5"
                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding ShowPrivacyHint, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding SourceLabel}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding HasSourceName, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource SmallButton}"
