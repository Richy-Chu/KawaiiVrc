                                                Visibility="{Binding HasPronouns, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PronounsText}" Style="{StaticResource TagText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}" BorderBrush="{Binding ProfileButtonBrush}">
                                            <TextBlock Text="{Binding PlatformText}" Style="{StaticResource TagText}"
                                                       Foreground="{Binding ProfileButtonBrush}" />
                                        </Border>
                                    </WrapPanel>

                                    <Border Style="{StaticResource ErrorBannerPanel}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ErrorTextBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ErrorMessage}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ErrorTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,12,0,0"
                                               Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Style="{StaticResource ProfilePrimaryButton}"
                                                Padding="15,8"
                                                FontSize="11.5"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Join" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ProfileSecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.SelfInviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                Visibility="{Binding CanJoin, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Send yourself an invite to this instance; accept it inside VRChat">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Self-invite" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ProfileSecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Invite this friend to your instance, or request theirs, with an optional message">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Invite" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ProfileSecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.RequestInviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                Visibility="{Binding CanRequestInvite, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Request invite" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="BoopActionButton"
                                                Style="{StaticResource ProfileSecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding ToggleBoopPickerCommand}"
                                                Visibility="{Binding ShowBoopAction, Converter={StaticResource BoolToVis}}"
                                                IsEnabled="{Binding CanBoop}"
                                                ToolTip="Send a boop to this friend. Make sure booping is enabled in your VRChat settings.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Boop" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ProfileSecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.OpenFriendWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="World details" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.CopyFriendLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Copy world location">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.CopyFriendUserIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Copy user ID">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.CopyFriendProfileLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Copy profile link">
                                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.OpenFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Open profile on vrchat.com">
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,0,7"
                                                Command="{Binding DataContext.RefreshFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Reload this profile">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button x:Name="FriendActionsButton"
                                                Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,0,7"
                                                Command="{Binding ToggleFriendMenuCommand}"
                                                ToolTip="Friend actions">
                                            <TextBlock Text="&#xE712;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" />
                                        </Button>

                                        <Popup DataContext="{Binding}"
                                               PlacementTarget="{Binding ElementName=FriendActionsButton}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               IsOpen="{Binding IsFriendMenuOpen, Mode=TwoWay}">
                                            <Border Width="190"
                                                    Margin="0,4,0,0"
                                                    Padding="8"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FriendshipLabel}"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding ProfileSubtextBrush}"
                                                               Margin="7,3,7,6" />
                                                    <Button Style="{StaticResource ProfileSecondaryButton}"
                                                            Content="{Binding FriendActionLabel}"
                                                            Command="{Binding ToggleFriendshipCommand}"
                                                            CommandParameter="{Binding}"
                                                            Padding="10,7"
                                                            HorizontalContentAlignment="Left" />
                                                    <Border Height="1"
                                                            Background="{StaticResource SoftBorderBrush}"
                                                            Margin="4,6" />
                                                    <Button Style="{StaticResource ProfileGhostButton}"
                                                            Content="Show instance history"
                                                            Command="{Binding ShowInstanceHistoryCommand}"
                                                            Padding="10,7"
                                                            HorizontalContentAlignment="Left" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,0,7"
                                                Content="DEV: check live world"
                                                FontSize="10"
                                                ToolTip="Dev only: re-read their live VRChat location and only offer Join for the world they are really in"
                                                Command="{Binding DataContext.InjectSenderLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding DataContext.IsDevMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                        <Popup DataContext="{Binding}"
                                               PlacementTarget="{Binding ElementName=BoopActionButton}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade"
                                               IsOpen="{Binding IsBoopPickerOpen, Mode=TwoWay}">
                                            <Border Width="372"
                                                    Margin="0,4,0,0"
                                                    Padding="12"
                                                    Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock Text="SEND A BOOP"
                                                               Style="{StaticResource FieldLabel}"
                                                               Foreground="{Binding ProfileButtonBrush}" />
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,4,0,2" />
                                                    <TextBlock Text="Only friends can be booped. Pick an emoji or send a plain boop; VRC+ custom emoji are included automatically."
                                                               Style="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               FontSize="10"
                                                               Margin="0,0,0,9" />
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Content="Just boop, no emoji"
                                                            Command="{Binding SendPlainBoopCommand}"
                                                            Padding="12,7"
                                                            HorizontalContentAlignment="Left" />
                                                    <TextBlock Text="EMOJI"
                                                               Style="{StaticResource FieldLabel}"
                                                               Foreground="{Binding ProfileSubtextBrush}"
                                                               Margin="0,12,0,6" />
                                                    <ScrollViewer MaxHeight="250"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding BoopEmojis}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Width="74"
                                                                            Height="74"
                                                                            Margin="0,0,5,5"
                                                                            Padding="5"
                                                                            Background="{StaticResource InputBrush}"
                                                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                                                            BorderThickness="1"
                                                                            Command="{Binding DataContext.SendBoopCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{Binding Name}">
                                                                        <StackPanel>
                                                                            <controls:AsyncImage SourceUrl="{Binding ImageUrl}"
                                                                                                 Width="38"
                                                                                                 Height="38"
                                                                                                 DecodeWidth="64"
                                                                                                 HorizontalAlignment="Center" />
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="9"
                                                                                       Foreground="{StaticResource MutedBrush}"
                                                                                       TextAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <TextBlock Text="{Binding BoopStatusText}"
                                                               Visibility="{Binding HasBoopStatus, Converter={StaticResource BoolToVis}}"
                                                               Foreground="{StaticResource ErrorTextBrush}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Margin="0,8,0,0" />
                                                    <Button Style="{StaticResource ProfileGhostButton}"
                                                            Content="Close"
                                                            Command="{Binding CloseBoopPickerCommand}"
                                                            Padding="8,5"
                                                            HorizontalAlignment="Right"
                                                            Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </WrapPanel>

                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="11,8"
                                            Margin="0,0,0,8"
                                            Visibility="{Binding HasBoopStatus, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BoopStatusText}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                    <WrapPanel Margin="0,12,0,0"
                                               Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Content="Copy user ID"
                                                Command="{Binding DataContext.CopyFriendUserIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                Padding="11,7"
                                                Margin="0,0,7,7"
                                                ToolTip="Copy your VRChat user ID" />
                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                Content="Copy profile link"
                                                Command="{Binding DataContext.CopyFriendProfileLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                Padding="11,7"
                                                Margin="0,0,7,7"
                                                ToolTip="Copy your VRChat profile link" />
                                    </WrapPanel>

                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,9"
                                            Margin="0,2,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding ProfileButtonBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WorldLine}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Margin="7,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActivityText}"
                                                       FontSize="10"
                                                       Foreground="{Binding ProfileSubtextBrush}"
                                                       Margin="18,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,10"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding ProfileButtonBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Your note"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="7,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="Only on this PC"
                                                           FontSize="10"
                                                           Foreground="{Binding ProfileSubtextBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MinHeight="54"
                                                     MaxHeight="140"
                                                     MaxLength="4000" />
                                            <Grid Margin="0,7,0,0">
                                                <TextBlock Text="{Binding NoteStatusText}"
                                                           FontSize="10"
                                                           Foreground="{Binding ProfileSubtextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,90,0" />
                                                <Button Content="Save note"
                                                        Style="{StaticResource ProfileSecondaryButton}"
                                                        Padding="11,5"
                                                        FontSize="10.5"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding SaveNoteCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,14,0,0">
                                        <Grid Margin="0,0,0,7">
                                            <TextBlock Text="AVATARS" Style="{StaticResource ProfileSectionLabel}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Checking avatars…"
                                                           FontSize="9.5"
                                                           Foreground="{Binding ProfileSubtextBrush}"
                                                           Margin="0,0,8,0"
                                                           Visibility="{Binding IsLoadingAvatars, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding AvatarsSummary}"
                                                           FontSize="9.5"
                                                           Foreground="{Binding ProfileSubtextBrush}"
                                                           VerticalAlignment="Center" />
                                                <Button Content="{Binding AvatarsToggleText}"
                                                        Style="{StaticResource ProfileGhostButton}"
                                                        FontSize="9.5"
                                                        Padding="7,2"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding ToggleAvatarsCommand}"
                                                        Visibility="{Binding CanToggleAvatars, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Show or hide this person's previously seen avatars" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding VisibleAvatars}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.OpenAvatarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Padding="0"
                                                            Margin="0,0,8,8"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTip="{Binding DisplayName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter x:Name="AvatarCard" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="AvatarCard" Property="Opacity" Value="0.82" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="AvatarCard" Property="Opacity" Value="0.68" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Border Width="126"
                                                                Background="{StaticResource InputBrush}"
                                                                BorderBrush="{StaticResource SoftBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="6">
                                                            <StackPanel>
                                                                <Border Width="112" Height="112"
                                                                        CornerRadius="8"
                                                                        Background="#151A24"
                                                                        ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="&#xE77B;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="28"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="224" />
                                                                        <Border Background="#99060810"
                                                                                Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="&#xE72E;"
                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="20"
                                                                                       Foreground="White"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Background="{StaticResource AccentHoverBrush}"
                                                                                CornerRadius="4"
                                                                                Padding="5,1"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Top"
                                                                                Margin="5"
                                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="CURRENT"
                                                                                       FontSize="7.5"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="White" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextAlignment="Center"
                                                                           Margin="0,6,0,2" />
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding PrivacyGlyph}"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="9"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,3,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding PrivacyLabel}"
                                                                               FontSize="9"
                                                                               VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                                                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding SeenLabel}"
                                                                           FontSize="8.5"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           TextAlignment="Center"
                                                                           Margin="0,1,0,0"
                                                                           Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVis}}" />
                                                                <ContentControl Content="{Binding TagLabels}"
                                                                                ContentTemplate="{StaticResource AvatarTagChips}"
                                                                                HorizontalAlignment="Left"
                                                                                Margin="0,5,0,0"
                                                                                Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Public avatars found in the avatar indexes."
                                                   FontSize="10"
                                                   Foreground="{Binding ProfileSubtextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasIndexedAvatars, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="No public avatars were found for this person in VRChat or the public avatar indexes."
                                                   FontSize="10"
                                                   Foreground="{Binding ProfileSubtextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding ShowNoAvatarsMessage, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ABOUT" Style="{StaticResource ProfileSectionLabel}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MutualText}"
                                                   FontSize="9.5"
                                                   Foreground="{Binding ProfileSubtextBrush}"
                                                   Margin="0,0,0,6" />
                                    </Grid>
                                    <TextBlock Text="{Binding BioText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               LineHeight="18.5"
                                               Foreground="{Binding ProfileSubtextBrush}" />

                                    <ItemsControl ItemsSource="{Binding BioLinks}"
                                                  Visibility="{Binding HasBioLinks, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,7,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChip}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TagText}"
                                                               Foreground="{Binding ProfileButtonBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Style="{StaticResource KawaiiStatCard}"
                                            Margin="0,14,0,0"
                                            Visibility="{Binding HasMemberSince, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding MemberSinceDetailText}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30"
                                                    CornerRadius="9"
                                                    VerticalAlignment="Center"
                                                    Background="#3860A5FA">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BlueBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="ON VRCHAT SINCE"
                                                           Style="{StaticResource KawaiiSectionLabel}" />
                                                <TextBlock Text="{Binding MemberSinceText}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#C9E2FF"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,14,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="GROUPS" Style="{StaticResource ProfileSectionLabel}" VerticalAlignment="Center" />
                                            <Button Content="View all groups"
                                                    Style="{StaticResource ProfileGhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.OpenGroupsCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    ToolTip="See every group on this profile" />
                                        </Grid>
                                        <Button Command="{Binding OpenGroupCommand}"
                                                CommandParameter="{Binding RepresentedGroup}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                ToolTip="Open the represented group"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Visibility="{Binding HasRepresentedGroup, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter x:Name="RepresentedChip" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RepresentedChip" Property="Opacity" Value="0.8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RepresentedGroup.Name}"
                                                               Style="{StaticResource TagText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="220" />
                                                    <Border Background="{Binding ProfileButtonBrush}"
                                                            CornerRadius="4"
                                                            Padding="4,0"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding RepresentedGroup.HasMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RepresentedGroup.MembershipLabel}"
                                                                   FontSize="8.5"
                                                                   Foreground="{Binding ProfileButtonTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                        <TextBlock Text="None"
                                                   Style="{StaticResource ProfileMutedText}"
                                                   ToolTip="Not representing a group"
                                                   Visibility="{Binding HasNoRepresentedGroup, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}"
                                                Margin="0,14,0,0">
                                        <TextBlock Text="BADGES" Style="{StaticResource ProfileSectionLabel}" />
                                        <ItemsControl ItemsSource="{Binding Badges}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="7,4"
                                                            Margin="0,0,6,6"
                                                            ToolTip="{Binding BadgeDescription}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding BadgeImageUrl}" Width="16" Height="16" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding BadgeName}" FontSize="9.5" Foreground="{Binding ProfileSubtextBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="Selecting a friend loads their public profile. Some details stay hidden by VRChat's privacy settings."
                                               FontSize="9"
                                               Foreground="{Binding ProfileSubtextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,16,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- All groups on the open friend profile -->
                    <Grid x:Name="ProfileGroupsOverlay"
                          Panel.ZIndex="{Binding DataContext.ProfilePopupZIndex, RelativeSource={RelativeSource AncestorType=Window}}"
                          AutomationProperties.AutomationId="ProfileGroupsOverlay"
                          Background="Transparent"
                          DataContext="{Binding SelectedFriendDetail}"
                          Visibility="{Binding IsGroupsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Button Command="{Binding CloseGroupsCommand}"
                                Focusable="False"
                                Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="540" MaxHeight="640"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Groups" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="Pick a group to see details, open instances and membership."
                                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding MutualGroupsText}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding HasMutualGroups, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="{Binding TheirGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding ShowProfileGroupsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProfileGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#BE185D" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding MutualGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding ShowMutualGroupsCommand}"
                                                        Visibility="{Binding HasMutualGroups, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMutualGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#BE185D" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding MyGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Command="{Binding ShowMyGroupsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMyGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#BE185D" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostButton}" Padding="7,4"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding CloseGroupsCommand}" ToolTip="Close">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
                                    <StackPanel>
                                        <TextBlock Text="No groups in this list."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="4,8,0,8"
                                                   Visibility="{Binding VisibleGroups.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding VisibleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Margin="0,0,0,6"
                                                        ToolTip="Open this group">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter x:Name="Row" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Opacity" Value="0.8" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="9" Background="#151A24" Margin="0,0,10,0">
                                                                <controls:AsyncImage SourceUrl="{Binding IconUrl}" DecodeWidth="96" CornerRadius="9" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <Border Background="#2A1E4A"
                                                                        CornerRadius="4"
                                                                        Padding="5,1"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding MembershipLabel}"
                                                                               FontSize="8.5"
                                                                               Foreground="{StaticResource AccentHoverBrush}" />
                                                                </Border>
                                                                <TextBlock Text="View →"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Group info popup (from any group chip) -->
                    <Grid x:Name="GroupInfoOverlay"
                          Panel.ZIndex="{Binding ProfilePopupZIndex}"
                          AutomationProperties.AutomationId="GroupInfoOverlay"
                          Visibility="{Binding GroupViewModel.IsGroupInfoOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Button Command="{Binding GroupViewModel.CloseGroupInfoCommand}"
                                Focusable="False"
                                Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="540"
                                MaxHeight="620"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="20,16"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource InputBrush}" Margin="0,0,14,0">
                                            <controls:AsyncImage SourceUrl="{Binding GroupViewModel.GroupInfo.ThumbnailUrl}" DecodeWidth="104" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfo.Name}"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfo.MemberCount, StringFormat='{}{0} members'}"
                                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="7,4"
                                                Command="{Binding GroupViewModel.CloseGroupInfoCommand}" ToolTip="Close">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="Loading group…"
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding GroupViewModel.IsGroupInfoBusy, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding GroupViewModel.GroupInfoError}"
                                                   Foreground="{StaticResource ErrorTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding GroupViewModel.GroupInfoError, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                                        <TextBlock Text="ABOUT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding GroupViewModel.GroupInfo.Description}"
                                                   TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                                   Foreground="{StaticResource MutedBrush}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfoMemberText}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#2A1E4A"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding GroupViewModel.HasGroupInfoMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding GroupViewModel.GroupInfoMembershipLabel}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>
                                            <Border Background="#2A1E4A"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding GroupViewModel.GroupInfoIsMutual, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Mutual with this profile"
                                                           FontSize="9"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GroupViewModel.GroupJoinHint}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />

                                        <Border Style="{StaticResource ErrorBannerPanel}"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding GroupViewModel.IsLeaveGroupConfirmOpen, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Leave this group?"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="This removes your membership on VRChat. You can rejoin public groups later."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Yes, leave group"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="11,5" FontSize="10.5"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding GroupViewModel.LeaveGroupInfoCommand}" />
                                                    <Button Content="Keep membership"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="11,5" FontSize="10.5"
                                                            Command="{Binding GroupViewModel.CancelLeaveGroupCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="OPEN INSTANCES" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfoInstancesText}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,6"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding GroupViewModel.GroupInfoInstances}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource InputBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="10"
                                                                Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="38" Height="38" CornerRadius="8" Background="#151A24" Margin="0,0,10,0">
                                                                    <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="96" CornerRadius="8" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding WorldName}" FontSize="11.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                                               Text="{Binding UsersText}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="Join"
                                                                        Style="{StaticResource SecondaryButton}"
                                                                        Padding="10,5" FontSize="10.5"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.GroupViewModel.JoinGroupInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="{Binding GroupViewModel.GroupJoinButtonText}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.JoinGroupInfoCommand}"
                                                    Visibility="{Binding GroupViewModel.IsMemberOfGroupInfo, Converter={StaticResource InverseBoolToVis}}"
                                                    IsEnabled="{Binding GroupViewModel.CanUseGroupJoinButton}"
                                                    ToolTip="{Binding GroupViewModel.GroupJoinButtonToolTip}" />
                                            <Button Content="Leave group"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.RequestLeaveGroupCommand}"
                                                    Visibility="{Binding GroupViewModel.IsMemberOfGroupInfo, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Leave this group (asks first)" />
                                            <Button Content="Open on vrchat.com"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.OpenGroupInfoOnWebCommand}" />
                                        </WrapPanel>

                                        <TextBlock Text="Moderation and role changes stay on vrchat.com; joins, join requests and leaving happen here."
                                                   FontSize="9" Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
        <!-- ========================================================= -->
        <!-- Sign out confirmation                                     -->
        <!-- ========================================================= -->
        <Grid x:Name="SignOutConfirmationOverlay"
              Panel.ZIndex="30"
              Visibility="{Binding IsLogoutConfirmationOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CancelLogoutCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Keep me signed in">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="410"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22,18">
                <StackPanel>
                    <TextBlock Text="Sign out of VRChat?"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="The saved session is removed from this PC. You will need to sign in again, with your password and any code your account asks for."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"
                                Command="{Binding CancelLogoutCommand}" />
                        <Button Content="Sign out"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmLogoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Friend locations popup                                    -->
        <!-- ========================================================= -->
        <Grid x:Name="FriendLocationsOverlay"
              Panel.ZIndex="23"
              Visibility="{Binding IsFriendLocationsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CloseFriendLocationsCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Width="680" MaxHeight="720"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Friend locations" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Who is online, which world they are in, and whether you can join."
                                           Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding FriendLocationsSummary}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseFriendLocationsCommand}"
                                    Padding="7,4" ToolTip="Close">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,10,16">
                            <ItemsControl ItemsSource="{Binding FriendLocationsPage.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Background="Transparent" BorderThickness="0"
                                                        Padding="0" HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        ToolTip="Open this friend and their world details"
                                                        Command="{Binding DataContext.OpenFriendLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40" CornerRadius="20"
                                                                Background="{StaticResource PanelBrush}"
                                                                Margin="0,0,10,0">
                                                            <Grid>
                                                                <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="96" />
                                                                <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                                        IntroUrl="{Binding IconFrameIntroUrl}"
                                                                                        DecodeWidth="128"
                                                                                        Width="52"
                                                                                        Height="52"
                                                                                     HorizontalAlignment="Center"
                                                                                     VerticalAlignment="Center"
                                                                                     Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{Binding TrustBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding TrustLabel}"
                                                                           FontSize="9" FontWeight="SemiBold"
                                                                           Foreground="{Binding TrustBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LocationTitle}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding LocationDetail}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="Join"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="13,7" FontSize="11"
                                                            Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsJoinable, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="Not joinable"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               Visibility="{Binding IsJoinable, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No friends are in a joinable world right now."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasFriendLocations, Converter={StaticResource InverseBoolToVis}}" />
                        <controls:ListPager Grid.Row="1"
                                            DataContext="{Binding FriendLocationsPage}"
                                            Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Recently played with popup                                -->
        <!-- ========================================================= -->
        <Grid x:Name="RecentPlayersOverlay"
              Panel.ZIndex="25"
              AutomationProperties.AutomationId="RecentPlayersOverlay"
              Visibility="{Binding RecentPlayersViewModel.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CloseRecentPlayersCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close recent people">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="920"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    DataContext="{Binding RecentPlayersViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="20,16"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Recently played with"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding DescriptionText}"
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SummaryText}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Command="{Binding CloseCommand}"
                                    Padding="7,4"
                                    ToolTip="Close">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,14,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox Style="{StaticResource InputBox}"
                                     AutomationProperties.AutomationId="RecentPlayersSearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search people, friends, or worlds" />
                            <TextBlock Text="Search people, friends, or worlds"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ListBox Grid.Column="1"
                                 ItemsSource="{Binding SortOptions}"
                                 SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                 Style="{StaticResource RegionPillList}"
                                 Margin="12,0,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource InputBrush}"
                                            CornerRadius="8"
                                            Padding="9,5">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="16,6,16,8">
                        <ListBox x:Name="RecentPlayersList"
                                 ItemsSource="{Binding PlayersPage.Items}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,0,4,0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 IsVisibleChanged="RecentPlayersList_IsVisibleChanged"
                                 Loaded="RecentPlayersList_Loaded"
                                 ScrollViewer.ScrollChanged="RecentPlayersList_ScrollChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="46"
                                                            Height="46"
                                                            CornerRadius="23"
                                                            Background="{StaticResource PanelBrush}"
                                                            Margin="0,0,11,0">
                                                        <Grid>
                                                            <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                 DecodeWidth="96"
                                                                                 CornerRadius="23" />
                                                            <TextBlock Text="&#xE77B;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="15"
                                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Style="{StaticResource TagChip}"
                                                                    Margin="8,0,0,0"
                                                                    Visibility="{Binding IsFriend, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="FRIEND"
                                                                           Style="{StaticResource TagText}"
                                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource TagChip}"
                                                                    Margin="8,0,0,0"
                                                                    Visibility="{Binding IsFriend, Converter={StaticResource InverseBoolToVis}}">
                                                                <TextBlock Text="NOT A FRIEND"
                                                                           Style="{StaticResource TagText}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="{Binding SummaryText, Mode=OneWay}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding LastSeenText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding LastWorldText, StringFormat='Last seen in {0}'}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource DimBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Content="Profile"
                                                            Padding="12,6"
                                                            FontSize="10.5"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding OpenProfileCommand}"
                                                            ToolTip="Open this person's VRChat profile" />
                                                </Grid>

                                                <ItemsControl Grid.Row="1"
                                                              ItemsSource="{Binding VisibleSessions}"
                                                              Margin="57,9,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource PanelBrush}"
                                                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="8,6"
                                                                    Margin="0,0,0,4">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="74" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding WhenText}"
                                                                               FontSize="9.5"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource GhostButton}"
                                                                            HorizontalContentAlignment="Left"
                                                                            Padding="6,2"
                                                                            Command="{Binding OpenWorldCommand}"
                                                                            ToolTip="Open this world">
                                                                        <TextBlock Text="{Binding WorldName}"
                                                                                   FontSize="10.5"
                                                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </Button>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding DurationText}"
                                                                               FontSize="10"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Grid.Row="2"
                                                        Style="{StaticResource GhostButton}"
                                                        Command="{Binding ToggleSessionsCommand}"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="6,2"
                                                        Margin="57,2,0,0"
                                                        Visibility="{Binding HasMoreSessions, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Show or hide every session with this person">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding MoreSessionsText}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                                        <TextBlock Text="&#xE70D;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="8"
                                                                   Margin="5,0,0,0"
                                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource EmptyStateCard}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="&#xE81C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="26"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{Binding EmptyMessage}"
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="16,10"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="Sessions are recorded from VRChat's local log, so they survive restarts."
                                       FontSize="9.5"
                                       Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center" />
                            <controls:ListPager DataContext="{Binding PlayersPage}"
                                                Margin="0,-2"
                                                Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right"
                                    Padding="9,5"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="Reload recent people">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Friend-list changes popup                                 -->
        <!-- ========================================================= -->
        <Grid x:Name="FriendChangesOverlay"
              Panel.ZIndex="24"
              Visibility="{Binding IsFriendChangesOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CloseFriendChangesCommand}"
                    Focusable="False" Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True" ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Width="590" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Friend changes" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Detected when the full friend list refreshes."
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            <ListBox ItemsSource="{Binding FriendChangeFilters}"
                                     SelectedItem="{Binding SelectedFriendChangeFilter, Mode=TwoWay}"
                                     Style="{StaticResource RegionPillList}"
                                     Margin="0,10,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="9,5">
                                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding FriendChangesSummary}"
                                       FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,10,16">
                            <ItemsControl ItemsSource="{Binding FriendChangesView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                Margin="0,0,0,7"
                                                Command="{Binding DataContext.OpenFriendChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{StaticResource InputBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="19"
                                                            Background="{StaticResource PanelBrush}" Margin="0,0,10,0">
                                                        <Grid>
                                                            <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="96" />
                                                            <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                                    IntroUrl="{Binding IconFrameIntroUrl}"
                                                                                    DecodeWidth="128"
                                                                                    Width="50"
                                                                                    Height="50"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding TrustBrush}" />
                                                        <TextBlock Text="{Binding TrustLabel}" FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="{Binding TrustBrush}" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ChangeLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding RelativeTime}" FontSize="9.5"
                                                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding TimestampText}" FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No friend-list changes yet. The first full refresh sets a baseline."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="330" TextAlignment="Center"
                                   Visibility="{Binding HasNoFriendChanges, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Avatar detail popup (Avatars, Favourites, Avatar Search)  -->
        <!-- ========================================================= -->
        <Grid x:Name="AvatarDetailsOverlay"
              Panel.ZIndex="40"
              Visibility="{Binding AvatarViewModel.IsAvatarDetailsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <Button Command="{Binding AvatarViewModel.CloseAvatarDetailsCommand}"
                    Focusable="False"
                    IsTabStop="False"
                    ClickMode="Press"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close avatar details">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="860"
                    MaxHeight="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
            <!-- Avatar detail view: opens in its own page when a card is clicked -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,2,12,12"
                          MaxHeight="760">
                <StackPanel>
                    <Button Style="{StaticResource GhostButton}"
                            Content="{Binding AvatarViewModel.AvatarDetailsBackLabel}"
                            HorizontalAlignment="Left"
                            Padding="0,0,12,10"
                            Command="{Binding AvatarViewModel.CloseAvatarDetailsCommand}" />

                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="300" Height="300"
                                    CornerRadius="16"
                                    Background="{StaticResource InputBrush}"
                                    Margin="0,0,24,0">
                                <Grid>
                                    <controls:AsyncImage SourceUrl="{Binding AvatarViewModel.SelectedAvatar.DisplayImageUrl}"
                                                         DecodeWidth="512">
                                        <controls:AsyncImage.Style>
                                            <Style TargetType="controls:AsyncImage">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvatarViewModel.SelectedAvatar.CanUse}" Value="False">
                                                        <Setter Property="Opacity" Value="0.68" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:AsyncImage.Style>
                                    </controls:AsyncImage>
                                    <Border Background="#660B0714"
                                            CornerRadius="16"
                                            Visibility="{Binding AvatarViewModel.SelectedAvatar.CanUse, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="24">
                                            <Border Width="54" Height="54"
                                                    CornerRadius="27"
                                                    Background="#38F472B6"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE72E;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="21"
                                                           Foreground="#FFD8EA"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="VIEW ONLY"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#FFD8EA"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,9,0,0" />
                                            <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.UseHint}"
                                                       FontSize="10"
                                                       Foreground="#D8C8F2"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="220"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.DisplayName}"
                                               Style="{StaticResource PageTitle}"
                                               FontSize="26"
                                               TextWrapping="Wrap" />
                                    <Border Background="{StaticResource GreenBrush}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="10,6,0,0"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding AvatarViewModel.SelectedAvatar.IsWearing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="WEARING"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#08110C" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.AuthorName, StringFormat='by {0}'}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />

                                <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.SourceLabel}"
                                           FontSize="10"
                                           Foreground="{StaticResource DimBrush}"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding AvatarViewModel.SelectedAvatar.HasSourceName, Converter={StaticResource BoolToVis}}" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.ReleaseStatusLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                    </Border>
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,4"
                                            Margin="0,0,6,6"
                                            Visibility="{Binding AvatarViewModel.SelectedAvatar.HasPlatforms, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.PlatformsText, StringFormat='For {0}'}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.PrivacyHint}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0"
                                           Visibility="{Binding AvatarViewModel.SelectedAvatar.ShowPrivacyHint, Converter={StaticResource BoolToVis}}" />

                                <Border Background="#D9080C10"
                                        BorderBrush="#2E6E55"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="12,9"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding AvatarViewModel.SelectedAvatar.HasSecurityCheckFailed, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="Assets/security-check-failed.png"
                                               Width="30"
                                               Height="30"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                        <TextBlock Text="The security checks on this avatar have failed and it cannot be used or favorited"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F4F7F5"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Wear this avatar"
                                            IsEnabled="{Binding AvatarViewModel.SelectedAvatar.CanUse}"
                                            ToolTip="{Binding AvatarViewModel.SelectedAvatar.UseHint}"
                                            Command="{Binding AvatarViewModel.WearAvatarCommand}"
                                            CommandParameter="{Binding AvatarViewModel.SelectedAvatar.Id}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Content="{Binding AvatarViewModel.SelectedAvatar.IsAnyFavorite, Converter={StaticResource BoolToText}, ConverterParameter=Favourited — remove|Add to favourites}"
                                            IsEnabled="{Binding AvatarViewModel.SelectedAvatar.CanUse}"
                                            ToolTip="{Binding AvatarViewModel.SelectedAvatar.UseHint}"
                                            Command="{Binding AvatarViewModel.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding AvatarViewModel.SelectedAvatar.Id}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Content="Refresh"
                                            Command="{Binding AvatarViewModel.RefreshCommand}" />
                                </StackPanel>

                                <TextBlock Text="{Binding AvatarViewModel.StatusMessage}"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Visibility="{Binding AvatarViewModel.StatusMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="About this avatar" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.DescriptionText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="110" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Created" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.CreatedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="1" Text="Updated" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.UpdatedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="2" Text="Platforms" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.PlatformsText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3" Text="Tags" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,4"
                                                       Visibility="{Binding AvatarViewModel.SelectedAvatar.HasTags, Converter={StaticResource BoolToVis}}" />
                                            <ContentControl Grid.Row="3" Grid.Column="1"
                                                            Content="{Binding AvatarViewModel.SelectedAvatar.TagLabels}"
                                                            ContentTemplate="{StaticResource AvatarTagChips}"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding AvatarViewModel.SelectedAvatar.HasTags, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>

        <!-- Which favourite slot?                                     -->
        <Grid x:Name="FavoriteSlotPickerOverlay"
              Panel.ZIndex="50"
              Visibility="{Binding AvatarViewModel.IsSlotPickerOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}">
            <Button Command="{Binding AvatarViewModel.CancelFavoriteSlotCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Cancel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Save to which favourite slot?"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding AvatarViewModel.PendingFavoriteAvatarName}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AvatarViewModel.SlotPickerMessage}"
                               FontSize="10.5"
                               Foreground="{StaticResource AccentHoverBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                                        <StackPanel Margin="0,12,0,0">
                    <!-- Listed here rather than from a collection: the picker must never
                         be able to come up as an empty dialog. -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            AutomationProperties.Name="Slot 1"
                            Command="{Binding AvatarViewModel.ChooseFavoriteSlotCommand}"
                            CommandParameter="avatars1">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Slot 1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Always available"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Listed here rather than from a collection: the picker must never
                         be able to come up as an empty dialog. -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            AutomationProperties.Name="Slot 2"
                            Command="{Binding AvatarViewModel.ChooseFavoriteSlotCommand}"
                            CommandParameter="avatars2">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Slot 2"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="VRC+ slot"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Listed here rather than from a collection: the picker must never
                         be able to come up as an empty dialog. -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            AutomationProperties.Name="Slot 3"
                            Command="{Binding AvatarViewModel.ChooseFavoriteSlotCommand}"
                            CommandParameter="avatars3">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Slot 3"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="VRC+ slot"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Listed here rather than from a collection: the picker must never
                         be able to come up as an empty dialog. -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            AutomationProperties.Name="Slot 4"
                            Command="{Binding AvatarViewModel.ChooseFavoriteSlotCommand}"
                            CommandParameter="avatars4">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Slot 4"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="VRC+ slot"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Listed here rather than from a collection: the picker must never
                         be able to come up as an empty dialog. -->
                    <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,8"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            AutomationProperties.Name="Local (unlimited)"
                            Command="{Binding AvatarViewModel.ChooseFavoriteSlotCommand}"
                            CommandParameter="local">
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="12,9">
                            <StackPanel>
                                <TextBlock Text="Local (unlimited)"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="Kept by the app, no VRChat limit"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Button>
                    </StackPanel>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            FontSize="11"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding AvatarViewModel.CancelFavoriteSlotCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Instance history                                           -->
        <!-- ========================================================= -->
        <Grid x:Name="InstanceHistoryOverlay"
              Panel.ZIndex="32"
              AutomationProperties.AutomationId="InstanceHistoryOverlay"
              Visibility="{Binding InstanceHistoryViewModel.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding InstanceHistoryViewModel.CloseCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close instance history">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="980"
                    MaxHeight="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    DataContext="{Binding InstanceHistoryViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="20,16"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Instance History"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding DescriptionText}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Center"
                                    Padding="8,5"
                                    Command="{Binding BackToProfileCommand}"
                                    Visibility="{Binding CanReturnToProfile, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Back to profile">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="Back to profile" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="9,5"
                                        Margin="0,0,8,0"
                                        Content="Show all"
                                        Command="{Binding ClearFilterCommand}"
                                        Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Clear the shared-instance filter" />
                                <TextBlock Text="{Binding SummaryText}"
                                           FontSize="10"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="9,5"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="Reload instance history">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="9,5"
                                        Margin="4,0,0,0"
                                        Command="{Binding CloseCommand}"
                                        ToolTip="Close instance history">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,14,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}"
                                 AutomationProperties.AutomationId="InstanceHistorySearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search instance history" />
                        <TextBlock Grid.Column="1"
                                   Text="Recorded from VRChat's local log"
                                   FontSize="9.5"
                                   Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="16,6,16,8">
                        <!-- A ListBox rather than an ItemsControl in a ScrollViewer:
                             the page rows are only realised as they scroll into
                             view instead of every row being built at once. -->
                        <ListBox Style="{StaticResource BareListBox}"
                                 ItemsSource="{Binding EntriesView}"
                                 Padding="4,0,4,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}"
                                                Padding="10,8"
                                                Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="128" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.ColumnSpan="5"
                                                        AutomationProperties.AutomationId="InstanceHistoryEntryButton"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        ToolTip="Open instance details"
                                                        Command="{Binding OpenCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="128" />
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="140" />
                                                            <ColumnDefinition Width="58" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DateText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                Background="{StaticResource InputBrush}"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RegionCode}"
                                                                       FontSize="8"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Border>
                                                        <Grid Grid.Column="2" Margin="10,0,8,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34"
                                                                    CornerRadius="6"
                                                                    Background="{StaticResource InputBrush}"
                                                                    Margin="0,0,8,0">
                                                                <controls:AsyncImage SourceUrl="{Binding WorldThumbnailUrl}"
                                                                                     DecodeWidth="96"
                                                                                     CornerRadius="6" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding WorldName}"
                                                                               FontSize="11.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               MaxWidth="360" />
                                                                    <TextBlock Text="{Binding AccessText}"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="7,0,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DetailLocationText}"
                                                                           FontSize="8.5"
                                                                           Foreground="{StaticResource DimBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding CreatorDisplayText}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding TimeText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Margin="0,0,8,0" />
                                                    </Grid>
                                                </Button>

                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}"
                                                            AutomationProperties.AutomationId="InstanceHistoryLaunchButton"
                                                            Padding="7,5"
                                                            Command="{Binding LaunchCommand}"
                                                            ToolTip="Launch instance">
                                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}"
                                                            AutomationProperties.AutomationId="InstanceHistoryOpenButton"
                                                            Padding="7,5"
                                                            Margin="2,0,0,0"
                                                            Command="{Binding OpenInGameCommand}"
                                                            ToolTip="Join in VRChat — attaches to the running game, or starts VRChat if it is closed">
                                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button Style="{StaticResource GhostButton}"
                                                            AutomationProperties.AutomationId="InstanceHistorySelfInviteButton"
                                                            Padding="7,5"
                                                            Margin="2,0,0,0"
                                                            Command="{Binding SelfInviteCommand}"
                                                            ToolTip="Self-invite">
                                                        <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button x:Name="HistoryActionsButton"
                                                            AutomationProperties.AutomationId="InstanceHistoryActionsButton"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="7,5"
                                                            Margin="2,0,0,0"
                                                            Command="{Binding ToggleMenuCommand}"
                                                            ToolTip="More instance actions">
                                                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                                    </Button>
                                                    <Popup DataContext="{Binding}"
                                                           PlacementTarget="{Binding ElementName=HistoryActionsButton}"
                                                           Placement="Bottom"
                                                           StaysOpen="False"
                                                           AllowsTransparency="True"
                                                           PopupAnimation="Fade"
                                                           IsOpen="{Binding IsMenuOpen, Mode=TwoWay}">
                                                        <Border Width="180"
                                                                Margin="0,4,0,0"
                                                                Padding="7"
                                                                Background="{StaticResource PanelBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9">
                                                            <StackPanel>
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Command="{Binding CopyInstanceIdCommand}"
                                                                        Content="Copy instance ID"
                                                                        Padding="9,7"
                                                                        HorizontalContentAlignment="Left" />
                                                                <Button Style="{StaticResource GhostButton}"
                                                                        Command="{Binding DeleteCommand}"
                                                                        Content="Delete"
                                                                        Foreground="{StaticResource ErrorTextBrush}"
                                                                        Padding="9,7"
                                                                        Margin="0,2,0,0"
                                                                        HorizontalContentAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource EmptyStateCard}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoEntries, Converter={StaticResource BoolToVis}}">
                            <StackPanel>                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="26"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyTitle}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,9,0,0" />
                                <TextBlock Text="{Binding EmptyMessage}"
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Padding="20,9"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Instance history details                                   -->
        <!-- ========================================================= -->
        <Grid x:Name="InstanceHistoryDetailOverlay"
              Panel.ZIndex="33"
              AutomationProperties.AutomationId="InstanceHistoryDetailOverlay"
              Visibility="{Binding InstanceHistoryViewModel.IsDetailVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#D9060810" />
            <Border Width="900"
                    MaxHeight="680"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    DataContext="{Binding InstanceHistoryViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="20,14"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="8,5"
                                        Command="{Binding BackCommand}"
                                        ToolTip="Back to instance history">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="Back" Margin="5,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Instance Details"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="8,5"
                                        Command="{Binding SelectedEntry.CopyInstanceIdCommand}"
                                        ToolTip="Copy instance ID">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                </Button>
                                <Button Style="{StaticResource GhostButton}"
                                        Padding="8,5"
                                        Margin="4,0,0,0"
                                        Command="{Binding CloseCommand}"
                                        ToolTip="Close instance details">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20,14,20,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="122" Height="88"
                                CornerRadius="9"
                                Background="{StaticResource InputBrush}"
                                VerticalAlignment="Top">
                            <controls:AsyncImage SourceUrl="{Binding SelectedEntry.AvatarUrl}"
                                                 DecodeWidth="244"
                                                 CornerRadius="9" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding SelectedEntry.WorldName}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedEntry.DetailLocationText}"
                                       FontSize="10"
                                       Foreground="{StaticResource DimBrush}"
                                       Margin="0,3,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Date" Style="{StaticResource MutedText}" FontSize="9.5" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedEntry.DateLongText}" FontSize="10" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="2" Text="Time" Style="{StaticResource MutedText}" FontSize="9.5" />
                                <TextBlock Grid.Column="3" Text="{Binding SelectedEntry.TimeRangeText}" FontSize="10" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Row="1" Text="Creator" Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntry.CreatorDisplayText}" FontSize="10" Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Access" Style="{StaticResource MutedText}" FontSize="9.5" Margin="0,7,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedEntry.AccessText}" FontSize="10" Foreground="{StaticResource TextBrush}" Margin="0,7,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding DetailDurationText}"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="20,0,20,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Players"
                                    Padding="11,5"
                                    FontSize="10.5"
                                    Command="{Binding ShowPlayersCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlayersTab}" Value="True">
                                                <Setter Property="Background" Value="#BE185D" />
                                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Timeline"
                                    Padding="11,5"
                                    FontSize="10.5"
                                    Margin="6,0,0,0"
                                    Command="{Binding ShowTimelineCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimelineTab}" Value="True">
                                                <Setter Property="Background" Value="#BE185D" />
                                                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailPlayerCountText}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="20,0,20,10">
                        <Grid Visibility="{Binding IsPlayersTab, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="4,0,4,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Display Name" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                                <TextBlock Grid.Column="1" Text="Visits" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                                <TextBlock Grid.Column="2" Text="Joined" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                                <TextBlock Grid.Column="3" Text="Left" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                                <TextBlock Grid.Column="4" Text="Time" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding SelectedEntry.Players}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ListRow}"
                                                    Padding="9,7"
                                                    Margin="0,0,0,4">
                                                <Button Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        IsEnabled="{Binding CanOpenProfile}"
                                                        ToolTip="Open this player's profile"
                                                        Command="{Binding OpenProfileCommand}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="62" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Width="27" Height="27" Margin="0,0,8,0">
                                                                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                                <Border CornerRadius="14" ClipToBounds="True" Background="{StaticResource InputBrush}">
                                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                         DecodeWidth="64"
                                                                                         CornerRadius="14" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Initial}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                                           Visibility="{Binding AvatarUrl, Converter={StaticResource StringEmptyToVis}}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="10.5"
                                                                       Foreground="{Binding NameBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding VisitsText}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding JoinedText}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding LeftText}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding TimeText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <Grid Visibility="{Binding IsTimelineTab, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding SelectedEntry.TimelineSummary}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="4,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding SelectedEntry.Timeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,0,0,0" MinHeight="30">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center" />
                                                <Grid Grid.Column="1">
                                                    <Rectangle Width="1" Fill="{StaticResource SoftBorderBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <Ellipse Width="7" Height="7"
                                                             Fill="{StaticResource AccentHoverBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Text}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="4"
                            Padding="20,8"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Launch chooser                                            -->
        <!-- ========================================================= -->
        <Grid x:Name="LaunchChooserOverlay"
              Panel.ZIndex="35"
              Visibility="{Binding IsLaunchChooserOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CancelLaunchChoiceCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{Binding LaunchChoiceTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LaunchChoiceSubtitle}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0"
                            Padding="14,11"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ChooseLaunchModeCommand}"
                            CommandParameter="vr">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Launch in VR" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0"
                            Padding="14,11"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ChooseLaunchModeCommand}"
                            CommandParameter="desktop">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Launch on Desktop" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Margin="0,8,0,0"
                            Padding="14,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding SelfInviteLaunchCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Self-invite" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Padding="12,5"
                            Margin="0,12,0,0"
                            Command="{Binding CancelLaunchChoiceCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Advanced launch profiles -->
        <Grid x:Name="AdvancedLaunchOverlay"
              Panel.ZIndex="62"
              Visibility="{Binding IsAdvancedLaunchOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CancelAdvancedLaunchCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#D4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="740"
                    MaxHeight="620"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Advanced launch profiles"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="Steam-style extra arguments for VRChat. The selected profile applies whenever this app opens VRChat or joins a world."
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ActiveLaunchProfileLabel}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource AccentHoverBrush}"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding LaunchProfiles}"
                                     SelectedItem="{Binding SelectedLaunchProfile, Mode=TwoWay}"
                                     Style="{StaticResource ChoiceListBox}"
                                     MinHeight="310"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceListItem}">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="Padding" Value="9,7" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="9.5"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="1" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="New"
                                        Height="30"
                                        Padding="10,3"
                                        FontSize="10.5"
                                        HorizontalAlignment="Left"
                                        Command="{Binding NewLaunchProfileCommand}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Content="Duplicate"
                                        Height="30"
                                        Padding="8,3"
                                        FontSize="10.5"
                                        Command="{Binding DuplicateLaunchProfileCommand}" />
                            </Grid>
                        </Grid>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PROFILE NAME"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding LaunchProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="48"
                                     IsEnabled="{Binding CanEditLaunchProfile}" />

                            <TextBlock Text="EXTRA LAUNCH ARGUMENTS"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,12,0,6" />
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding LaunchProfileArguments, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="1024"
                                     Height="118"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     IsEnabled="{Binding CanEditLaunchProfile}" />
                            <TextBlock Text="Examples:  --fps=120   --profile=1   -screen-fullscreen 1 -screen-width 1920 -screen-height 1080 -monitor 1"
                                       Style="{StaticResource MutedText}"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0" />
                            <TextBlock Text="Desktop mode adds --no-vr automatically. Profiles only apply when VRChat starts; a running client accepts joins without new arguments."
                                       Style="{StaticResource MutedText}"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />

                            <Border Style="{StaticResource ErrorBannerPanel}"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding HasLaunchProfileError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LaunchProfileError}"
                                           FontSize="11"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Use this profile"
                                        Height="34"
                                        Padding="12,5"
                                        FontSize="11"
                                        HorizontalAlignment="Left"
                                        Command="{Binding UseLaunchProfileCommand}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Save"
                                        Height="34"
                                        Padding="10,5"
                                        FontSize="11"
                                        Margin="7,0,0,0"
                                        IsEnabled="{Binding CanSaveLaunchProfile}"
                                        Command="{Binding SaveLaunchProfileCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Content="Delete"
                                        Height="34"
                                        Padding="9,5"
                                        FontSize="11"
                                        Margin="7,0,0,0"
                                        IsEnabled="{Binding CanDeleteLaunchProfile}"
                                        Command="{Binding DeleteLaunchProfileCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Style="{StaticResource GhostButton}"
                            Content="Close"
                            HorizontalAlignment="Right"
                            Padding="12,5"
                            Margin="0,12,0,0"
                            Command="{Binding CancelAdvancedLaunchCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- World details modal                                       -->
        <!-- ========================================================= -->
        <Grid x:Name="WorldDialogOverlay"
              Panel.ZIndex="20"
              Visibility="{Binding HasWorldDialog, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#B8060810" />
            <Grid Margin="24">
                <Border Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        MaxWidth="1020"
                        MaxHeight="780"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        DataContext="{Binding WorldDialog}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Modal header -->
                        <Border BorderBrush="{StaticResource SoftBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE909;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AuthorText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.RefreshWorldDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Refresh world and instance data">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,6"
                                            Command="{Binding DataContext.CloseWorldDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Close (Esc)">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Modal body -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18,14,14,18">
                            <StackPanel>
                                <!-- Hero -->
                                <Grid Height="148">
                                    <Border CornerRadius="12" Background="{StaticResource AccentGradient}" />
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#22080A11" Offset="0" />
                                                <GradientStop Color="#E6080A11" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,12">
                                        <WrapPanel>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding OccupancyText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding PlatformsText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding ReleaseStatusText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6"
                                                    Visibility="{Binding HasCreatedInstance, Converter={StaticResource InverseBoolToVis}}"
                                                    ToolTip="Favorites">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FavoritesText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6"
                                                    ToolTip="Visits">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VisitsText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AuthorText}"
                                                   FontSize="11.5"
                                                   Foreground="#D9E9EDF5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="380" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="350" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: details and instances -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="About this world" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           LineHeight="17.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,6,0,0" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource TagChip}">
                                                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource TagText}" Foreground="{StaticResource VioletBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagChip}"
                                                            Visibility="{Binding HasCreatedText, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagChip}"
                                                            Visibility="{Binding HasUpdatedText, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                </WrapPanel>
                                                <Button Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left"
                                                        Padding="0,4"
                                                        Margin="0,2,0,0"
                                                        Command="{Binding DataContext.OpenWorldInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Summary}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="View on vrchat.com" FontSize="10.5" Foreground="{StaticResource BlueBrush}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Active instances" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="{Binding Instances.Count, StringFormat={}{0} live}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource GreenBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Only public and friends-visible instances are shown. Group instances link to their group, where you can join it."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,8" />

                                                <ItemsControl ItemsSource="{Binding Instances}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource InputBrush}"
                                                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="10,6"
                                                                    Margin="0,0,0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="6" Height="6"
                                                                                     Fill="{StaticResource GreenBrush}"
                                                                                     VerticalAlignment="Center"
                                                                                     Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="11.5"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding DetailText}"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   Margin="12,3,0,0" />
                                                                        <Button Style="{StaticResource GhostButton}"
                                                                                HorizontalAlignment="Left"
                                                                                Padding="0,2"
                                                                                Margin="12,1,0,0"
                                                                                Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                                                                Command="{Binding DataContext.OpenWorldInstanceGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="Open the group: members, join or leave, and its instances">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                                                                           Foreground="{StaticResource VioletBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding GroupChipText}" FontSize="10"
                                                                                           Foreground="{StaticResource VioletBrush}" Margin="5,0,0,0" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Content="Join"
                                                                            Padding="13,5"
                                                                            FontSize="10.5"
                                                                            Margin="10,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding DataContext.JoinWorldInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="No active instances found right now. Create one on the right."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasActiveInstances, Converter={StaticResource InverseBoolToVis}}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ErrorBannerPanel}"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ErrorTextBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,8,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ErrorMessage}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ErrorTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: create or join -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Create an instance" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Pick who can join and where it runs."
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,8" />

                                                <TextBlock Text="ACCESS" Style="{StaticResource FieldLabel}" />
                                                <ListBox Style="{StaticResource ChoiceListBox}"
                                                         ItemsSource="{Binding InstanceTypes}"
                                                         SelectedItem="{Binding SelectedType, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="9.5"
                                                                           Foreground="{StaticResource DimBrush}"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="REGION" Style="{StaticResource FieldLabel}" Margin="0,3,0,5" />
                                                <ListBox Style="{StaticResource RegionPillList}"
                                                         ItemsSource="{Binding Regions}"
                                                         SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <Button Style="{StaticResource PrimaryButton}"
                                                        Content="Create instance"
                                                        Margin="0,6,0,0"
                                                        Command="{Binding DataContext.CreateInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                <Border Background="{StaticResource AccentSoftBrush}"
                                                        BorderBrush="{StaticResource AccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,8"
                                                        Margin="0,10,0,0"
                                                        Visibility="{Binding HasCreatedInstance, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CreatedTitle}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                                        <TextBlock Text="{Binding CreatedMeta}"
                                                                   FontSize="9.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button Style="{StaticResource PrimaryButton}"
                                                                    Content="Launch VRChat"
                                                                    Padding="12,6"
                                                                    FontSize="10.5"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.LaunchCreatedInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Button Style="{StaticResource SecondaryButton}"
                                                                    Content="Copy share link"
                                                                    Padding="11,6"
                                                                    FontSize="10.5"
                                                                    Command="{Binding DataContext.CopyCreatedInstanceLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="Join a specific instance" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Paste a launch URL, short code, or location for this world."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,7" />
                                                <Grid>
                                                    <TextBox Style="{StaticResource InputBox}"
                                                             Text="{Binding JoinInstanceInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Instance link or short code"
                                                               Margin="13,0,0,0"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding JoinInstanceInput}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="Join this world"
                                                        Margin="0,7,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.JoinDialogInputCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Profile invite / request composer -->
        <Grid x:Name="InviteComposerOverlay"
              Panel.ZIndex="60"
              Visibility="{Binding IsInviteComposerOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CancelInviteComposerCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#D4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{Binding InviteComposerTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InviteComposerSubtitle}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding InviteComposerLocationHint}"
                               Foreground="#F5A623"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasInviteComposerLocationHint, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="MESSAGE (OPTIONAL)"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding InviteComposerMessage, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="64"
                             Height="82"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding InviteComposerMessageCount}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0" />

                    <TextBlock Text="MESSAGE PRESETS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6" />
                    <ListBox ItemsSource="{Binding InviteMessages}"
                             SelectedItem="{Binding SelectedInviteMessage, Mode=TwoWay}"
                             Style="{StaticResource ChoiceListBox}"
                             MaxHeight="116"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceListItem}">
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SlotLabel}"
                                                   FontSize="9.5"
                                                   Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CooldownText}"
                                               FontSize="9.5"
                                               Style="{StaticResource MutedText}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding InviteMessagesStatus}"
                               Style="{StaticResource MutedText}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding InvitePresetStatus}"
                               FontSize="10"
                               Foreground="#F5A623"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Content="Save preset"
                                Height="30"
                                Padding="10,3"
                                FontSize="10.5"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanSaveInvitePreset}"
                                Command="{Binding SaveInvitePresetCommand}"
                                ToolTip="Save the text box into the selected preset slot" />
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Content="Clear selection"
                                Height="30"
                                Padding="8,3"
                                FontSize="10.5"
                                Margin="6,0,0,0"
                                Command="{Binding ClearInvitePresetCommand}"
                                ToolTip="Type a one-off message instead of editing a preset" />
                    </Grid>

                    <Border Style="{StaticResource ErrorBannerPanel}"
                            Margin="0,7,0,0"
                            Visibility="{Binding HasComposerError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ComposerError}"
                                   FontSize="11"
                                   Foreground="{StaticResource ErrorTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="CHOOSE ONE WAY"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Height="38"
                                Padding="8,6"
                                FontSize="11"
                                HorizontalContentAlignment="Center"
                                Content="Invite them to my world"
                                Command="{Binding SelectInviteComposerModeCommand}"
                                CommandParameter="invite">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InviteComposerMode}" Value="invite">
                                            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1"
                                Height="38"
                                Padding="8,6"
                                FontSize="11"
                                Margin="7,0,0,0"
                                HorizontalContentAlignment="Center"
                                Content="Request their invite"
                                Command="{Binding SelectInviteComposerModeCommand}"
                                CommandParameter="request">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InviteComposerMode}" Value="request">
                                            <Setter Property="Background" Value="{StaticResource AccentGradient}" />
                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="{Binding InviteComposerSendLabel}"
                            Height="40"
                            Margin="0,8,0,0"
                            Command="{Binding SendInviteChoiceCommand}"
                            CommandParameter="{Binding InviteComposerMode}" />

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Padding="12,5"
                            Margin="0,12,0,0"
                            Command="{Binding CancelInviteComposerCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Decline with a custom message -->
        <Grid x:Name="ResponseComposerOverlay"
              Panel.ZIndex="61"
              Visibility="{Binding IsResponseComposerOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding CancelResponseComposerCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#D4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{Binding ResponseComposerTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ResponseComposerSubtitle}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <TextBlock Text="MESSAGE"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding ResponseComposerMessage, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="64"
                             Height="82"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{Binding ResponseComposerMessageCount}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0" />

                    <TextBlock Text="MESSAGE PRESETS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,12,0,6" />
                    <ListBox ItemsSource="{Binding InviteMessages}"
                             SelectedItem="{Binding SelectedInviteMessage, Mode=TwoWay}"
                             Style="{StaticResource ChoiceListBox}"
                             MaxHeight="96"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceListItem}">
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Preview}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SlotLabel}"
                                                   FontSize="9.5"
                                                   Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CooldownText}"
                                               FontSize="9.5"
                                               Style="{StaticResource MutedText}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding InviteMessagesStatus}"
                               Style="{StaticResource MutedText}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding InvitePresetStatus}"
                               FontSize="10"
                               Foreground="#F5A623"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButton}"
                                Content="Save preset"
                                Height="30"
                                Padding="10,3"
                                FontSize="10.5"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanSaveInvitePreset}"
                                Command="{Binding SaveInvitePresetCommand}"
                                ToolTip="Save the text box into the selected reply preset slot" />
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Content="Clear selection"
                                Height="30"
                                Padding="8,3"
                                FontSize="10.5"
                                Margin="6,0,0,0"
                                Command="{Binding ClearInvitePresetCommand}"
                                ToolTip="Type a one-off reply instead of editing a preset" />
                    </Grid>

                    <Border Style="{StaticResource ErrorBannerPanel}"
                            Margin="0,7,0,0"
                            Visibility="{Binding HasComposerError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ComposerError}"
                                   FontSize="11"
                                   Foreground="{StaticResource ErrorTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Send and decline"
                            Height="40"
                            Margin="0,14,0,0"
                            Command="{Binding SendDeclineWithMessageCommand}" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Padding="12,5"
                            Margin="0,9,0,0"
                            Command="{Binding CancelResponseComposerCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Update popup                                              -->
        <!-- ========================================================= -->
        <Grid x:Name="UpdateOverlay"
              Panel.ZIndex="400"
              AutomationProperties.AutomationId="UpdateOverlay"
              Visibility="{Binding UpdateViewModel.IsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Button Command="{Binding UpdateViewModel.CloseCommand}"
                    Focusable="False"
                    Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                    ToolTip="Later">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="560"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="20,16"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateViewModel.Title}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding UpdateViewModel.VersionSummary}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Padding="7,4"
                                    Command="{Binding UpdateViewModel.CloseCommand}"
                                    ToolTip="Close">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,14,20,16"
                                  MaxHeight="330">
                        <StackPanel>
                            <StackPanel Visibility="{Binding UpdateViewModel.HasNotes, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="WHAT'S NEW" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding UpdateViewModel.NotesText}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           LineHeight="19"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>

                            <Border Style="{StaticResource ErrorBannerPanel}"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding UpdateViewModel.HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UpdateViewModel.ErrorText}"
                                           FontSize="11"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ProgressBar Height="8"
                                         Margin="0,14,0,0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding UpdateViewModel.Progress, Mode=OneWay}"
                                         Background="{StaticResource InputBrush}"
                                         Foreground="{StaticResource AccentGradientPink}"
                                         BorderThickness="0"
                                         Visibility="{Binding UpdateViewModel.ShowProgress, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{Binding UpdateViewModel.StatusText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding UpdateViewModel.HasStatusText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="20,12"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Style="{StaticResource GhostButton}"
                                    Content="Release notes"
                                    HorizontalAlignment="Left"
                                    Command="{Binding UpdateViewModel.OpenReleasePageCommand}"
                                    Visibility="{Binding UpdateViewModel.HasUpdate, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Later"
                                        Margin="0,0,8,0"
                                        Command="{Binding UpdateViewModel.CloseCommand}"
                                        Visibility="{Binding UpdateViewModel.IsDownloading, Converter={StaticResource InverseBoolToVis}}" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="Cancel download"
                                        Margin="0,0,8,0"
                                        Command="{Binding UpdateViewModel.CloseCommand}"
                                        Visibility="{Binding UpdateViewModel.IsDownloading, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Padding="16,9"
                                        Content="Download update"
                                        Command="{Binding UpdateViewModel.DownloadCommand}"
                                        Visibility="{Binding UpdateViewModel.ShowDownloadAction, Converter={StaticResource BoolToVis}}" />
                                <Button Style="{StaticResource PrimaryButton}"
                                        Padding="16,9"
                                        Content="Install &amp; restart"
                                        Command="{Binding UpdateViewModel.InstallCommand}"
                                        Visibility="{Binding UpdateViewModel.ShowInstallAction, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
