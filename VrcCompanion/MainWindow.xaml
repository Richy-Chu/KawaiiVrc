                                                Visibility="{Binding IsVrcPlus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VRC+" Style="{StaticResource TagText}" Foreground="{Binding ProfileButtonBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsAgeVerified, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Age verified" Style="{StaticResource TagText}" Foreground="{Binding ProfileButtonBrush}" />
                                        </Border>
