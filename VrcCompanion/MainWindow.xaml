                            <Button Style="{StaticResource GhostButton}"
                                    Content="Back to sign in"
                                    Padding="0,2"
                                    FontSize="10.5"
                                    HorizontalAlignment="Left"
                                    Margin="0,4,0,0"
                                    Command="{Binding CancelTwoFactorCommand}" />

                            <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,18,0,14" />

                            <TextBlock Text="If you use an authenticator app, the code changes every 30 seconds. Recovery codes also work."
                                       FontSize="9.5"
                                       LineHeight="14"
                                       Foreground="{StaticResource DimBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->

        <!-- ========================================================= -->
                    <!-- Friend detail popup -->
                    <Grid Visibility="{Binding HasSelectedFriend, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding CloseFriendDetailCommand}"
                                Focusable="False"
                                Cursor="Arrow"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="640"
                                MaxHeight="760"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"
                                                  Color="#000000" />
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="15" ClipToBounds="True"
                                        Visibility="{Binding HasProfileBackdrop, Converter={StaticResource BoolToVis}}">
                                    <controls:ImageBackdrop SourcePath="{Binding ProfileBackdropPath}"
                                                            Animate="{Binding AnimateBackdrop}" />
                                </Border>
                                <Border Background="#E60B0D12" CornerRadius="15"
                                        Visibility="{Binding HasProfileBackdrop, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          DataContext="{Binding SelectedFriendDetail}">
                                <StackPanel Margin="20,18,18,22">
                                    <Grid Height="112" Margin="0,0,0,0">
                                        <Rectangle RadiusX="11" RadiusY="11" Fill="{Binding BannerBrush}" />
                                        <Rectangle RadiusX="11" RadiusY="11">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{Binding BannerImage}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle RadiusX="11" RadiusY="11">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#B30B0D12" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <Button Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="7,4"
                                                Margin="6"
                                                Command="{Binding DataContext.CloseFriendDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Close profile">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <Grid Margin="14,-30,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Width="76" Height="76" Margin="0,0,14,0">
                                            <Ellipse Fill="{StaticResource AccentGradient}" />
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="26"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WhiteBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding AvatarImage, Converter={StaticResource NullToVis}}" />
                                            <Ellipse Stroke="{StaticResource PanelBrush}" StrokeThickness="3"
                                                     Visibility="{Binding AvatarImage, Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,7,0" />
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding UsernameHandle}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource TagChip}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Style="{StaticResource TagText}"
                                                       Foreground="{Binding StatusBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}">
                                            <TextBlock Text="{Binding TrustLabel}" Style="{StaticResource TagText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsVrcPlus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VRC+" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsAgeVerified, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Age verified" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding HasPronouns, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PronounsText}" Style="{StaticResource TagText}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}">
                                            <TextBlock Text="{Binding PlatformText}" Style="{StaticResource TagText}" />
                                        </Border>
                                    </WrapPanel>

                                    <Border Style="{StaticResource ErrorBannerPanel}"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ErrorTextBrush}"
                                                       VerticalAlignment="Top"
                                                       Margin="0,1,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ErrorMessage}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ErrorTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <WrapPanel Margin="0,12,0,0"
                                               Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Padding="15,8"
                                                FontSize="11.5"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Join" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.InviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Invite this friend to your current instance">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Invite" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.RequestInviteFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                Visibility="{Binding CanRequestInvite, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="Request invite" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource SecondaryButton}"
                                                Padding="12,7"
                                                Margin="0,0,7,7"
                                                Command="{Binding DataContext.OpenFriendWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="World details" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.CopyFriendLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Copy world location">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,4,7"
                                                Command="{Binding DataContext.OpenFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Friend}"
                                                ToolTip="Open profile on vrchat.com">
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,0,7"
                                                Command="{Binding DataContext.RefreshFriendProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Reload this profile">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                        </Button>

                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="9,6"
                                                Margin="0,0,0,7"
                                                Content="DEV: check live world"
                                                FontSize="10"
                                                ToolTip="Dev only: re-read their live VRChat location and only offer Join for the world they are really in"
                                                Command="{Binding DataContext.InjectSenderLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding DataContext.IsDevMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                    </WrapPanel>

                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,9"
                                            Margin="0,2,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WorldLine}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           Margin="7,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ActivityText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource DimBrush}"
                                                       Margin="18,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource SoftBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,10"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding IsSelf, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="Your note"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="7,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="Only on this PC"
                                                           FontSize="10"
                                                           Foreground="{StaticResource DimBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     MinHeight="54"
                                                     MaxHeight="140"
                                                     MaxLength="4000" />
                                            <Grid Margin="0,7,0,0">
                                                <TextBlock Text="{Binding NoteStatusText}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,90,0" />
                                                <Button Content="Save note"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="11,5"
                                                        FontSize="10.5"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding SaveNoteCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ABOUT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MutualText}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"
                                                   Margin="0,0,0,6" />
                                    </Grid>
                                    <TextBlock Text="{Binding BioText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               LineHeight="18.5"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <ItemsControl ItemsSource="{Binding BioLinks}"
                                                  Visibility="{Binding HasBioLinks, Converter={StaticResource BoolToVis}}"
                                                  Margin="0,7,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TagChip}">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TagText}"
                                                               Foreground="{StaticResource BlueBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Margin="0,14,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="GROUPS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            <Button Content="View all groups"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.OpenGroupsCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                    ToolTip="See every group on this profile" />
                                        </Grid>
                                        <Button Command="{Binding OpenGroupCommand}"
                                                CommandParameter="{Binding RepresentedGroup}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                ToolTip="Open the represented group"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Visibility="{Binding HasRepresentedGroup, Converter={StaticResource BoolToVis}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter x:Name="RepresentedChip" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RepresentedChip" Property="Opacity" Value="0.8" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Border Style="{StaticResource TagChip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RepresentedGroup.Name}"
                                                               Style="{StaticResource TagText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="220" />
                                                    <Border Background="#2A1E4A"
                                                            CornerRadius="4"
                                                            Padding="4,0"
                                                            Margin="5,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding RepresentedGroup.HasMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding RepresentedGroup.MembershipLabel}"
                                                                   FontSize="8.5"
                                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                        <TextBlock Text="None"
                                                   Style="{StaticResource MutedText}"
                                                   ToolTip="Not representing a group"
                                                   Visibility="{Binding HasNoRepresentedGroup, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasBadges, Converter={StaticResource BoolToVis}}"
                                                Margin="0,14,0,0">
                                        <TextBlock Text="BADGES" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding Badges}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="7,4"
                                                            Margin="0,0,6,6"
                                                            ToolTip="{Binding BadgeDescription}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding BadgeImageUrl}" Width="16" Height="16" Margin="0,0,5,0" />
                                                            <TextBlock Text="{Binding BadgeName}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="Selecting a friend loads their public profile. Some details stay hidden by VRChat's privacy settings."
                                               FontSize="9"
                                               Foreground="{StaticResource DimBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,16,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- All groups on the open friend profile -->
                    <Grid Panel.ZIndex="24"
                          Background="Transparent"
                          DataContext="{Binding SelectedFriendDetail}"
                          Visibility="{Binding IsGroupsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Button Command="{Binding CloseGroupsCommand}"
                                Focusable="False"
                                Cursor="Arrow"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="540" MaxHeight="640"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Groups" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="Pick a group to see details, open instances and membership."
                                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding MutualGroupsText}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding HasMutualGroups, Converter={StaticResource BoolToVis}}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Content="{Binding TheirGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding ShowProfileGroupsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProfileGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#4C1D95" />
                                                                    <Setter Property="BorderBrush" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding MutualGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Margin="0,0,6,0"
                                                        Command="{Binding ShowMutualGroupsCommand}"
                                                        Visibility="{Binding HasMutualGroups, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMutualGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#4C1D95" />
                                                                    <Setter Property="BorderBrush" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{Binding MyGroupsTabText}"
                                                        FontSize="10.5"
                                                        Padding="9,4"
                                                        Command="{Binding ShowMyGroupsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMyGroupsTab}" Value="True">
                                                                    <Setter Property="Background" Value="#4C1D95" />
                                                                    <Setter Property="BorderBrush" Value="#8B5CF6" />
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Style="{StaticResource GhostButton}" Padding="7,4"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding CloseGroupsCommand}" ToolTip="Close">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,14">
                                    <StackPanel>
                                        <TextBlock Text="No groups in this list."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="4,8,0,8"
                                                   Visibility="{Binding VisibleGroups.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding VisibleGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Margin="0,0,0,6"
                                                        ToolTip="Open this group">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <ContentPresenter x:Name="Row" />
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Opacity" Value="0.8" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="9" Background="#151A24" Margin="0,0,10,0">
                                                                <controls:AsyncImage SourceUrl="{Binding IconUrl}" DecodeWidth="96" CornerRadius="9" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <Border Background="#2A1E4A"
                                                                        CornerRadius="4"
                                                                        Padding="5,1"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding MembershipLabel}"
                                                                               FontSize="8.5"
                                                                               Foreground="{StaticResource AccentHoverBrush}" />
                                                                </Border>
                                                                <TextBlock Text="View →"
                                                                           FontSize="10.5"
                                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Group info popup (from any group chip) -->
                    <Grid Panel.ZIndex="25"
                          Visibility="{Binding GroupViewModel.IsGroupInfoOpen, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding GroupViewModel.CloseGroupInfoCommand}"
                                Focusable="False"
                                Cursor="Arrow"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="540"
                                MaxHeight="620"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="20,16"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource InputBrush}" Margin="0,0,14,0">
                                            <controls:AsyncImage SourceUrl="{Binding GroupViewModel.GroupInfo.ThumbnailUrl}" DecodeWidth="128" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfo.Name}"
                                                       FontSize="17" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfo.MemberCount, StringFormat='{}{0} members'}"
                                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="7,4"
                                                Command="{Binding GroupViewModel.CloseGroupInfoCommand}" ToolTip="Close">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,20"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="Loading group…"
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding GroupViewModel.IsGroupInfoBusy, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding GroupViewModel.GroupInfoError}"
                                                   Foreground="{StaticResource ErrorTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding GroupViewModel.GroupInfoError, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                                        <TextBlock Text="ABOUT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding GroupViewModel.GroupInfo.Description}"
                                                   TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                                   Foreground="{StaticResource MutedBrush}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfoMemberText}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="#2A1E4A"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding GroupViewModel.HasGroupInfoMembershipLabel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding GroupViewModel.GroupInfoMembershipLabel}"
                                                           FontSize="9"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>
                                            <Border Background="#2A1E4A"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="7,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding GroupViewModel.GroupInfoIsMutual, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Mutual with this profile"
                                                           FontSize="9"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GroupViewModel.GroupJoinHint}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />

                                        <Border Style="{StaticResource ErrorBannerPanel}"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding GroupViewModel.IsLeaveGroupConfirmOpen, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Leave this group?"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="This removes your membership on VRChat. You can rejoin public groups later."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Yes, leave group"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="11,5" FontSize="10.5"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding GroupViewModel.LeaveGroupInfoCommand}" />
                                                    <Button Content="Keep membership"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="11,5" FontSize="10.5"
                                                            Command="{Binding GroupViewModel.CancelLeaveGroupCommand}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Margin="0,14,0,0">
                                            <TextBlock Text="OPEN INSTANCES" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding GroupViewModel.GroupInfoInstancesText}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,4,0,6"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding GroupViewModel.GroupInfoInstances}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource InputBrush}"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="9"
                                                                Padding="10"
                                                                Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="38" Height="38" CornerRadius="8" Background="#151A24" Margin="0,0,10,0">
                                                                    <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="96" CornerRadius="8" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding WorldName}" FontSize="11.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                                               Text="{Binding UsersText}" Margin="0,2,0,0" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Content="Join"
                                                                        Style="{StaticResource SecondaryButton}"
                                                                        Padding="10,5" FontSize="10.5"
                                                                        VerticalAlignment="Center"
                                                                        Command="{Binding DataContext.GroupViewModel.JoinGroupInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Join group"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.JoinGroupInfoCommand}"
                                                    Visibility="{Binding GroupViewModel.IsMemberOfGroupInfo, Converter={StaticResource InverseBoolToVis}}"
                                                    IsEnabled="{Binding GroupViewModel.IsGroupJoinOpen}"
                                                    ToolTip="Join this open group" />
                                            <Button Content="Leave group"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.RequestLeaveGroupCommand}"
                                                    Visibility="{Binding GroupViewModel.IsMemberOfGroupInfo, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Leave this group (asks first)" />
                                            <Button Content="Open on vrchat.com"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6" FontSize="11" Margin="0,0,8,6"
                                                    Command="{Binding GroupViewModel.OpenGroupInfoOnWebCommand}" />
                                        </WrapPanel>

                                        <TextBlock Text="Moderation and role changes stay on vrchat.com; this popup only joins or leaves public groups."
                                                   FontSize="9" Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
        <!-- ========================================================= -->
        <!-- Friend locations popup                                    -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="23"
              Visibility="{Binding IsFriendLocationsOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding CloseFriendLocationsCommand}"
                    Focusable="False"
                    Cursor="Arrow"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Width="680" MaxHeight="720"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Friend locations" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Who is online, which world they are in, and whether you can join."
                                           Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding FriendLocationsSummary}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CloseFriendLocationsCommand}"
                                    Padding="7,4" ToolTip="Close">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,10,16">
                            <ItemsControl ItemsSource="{Binding FriendLocationsView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Background="Transparent" BorderThickness="0"
                                                        Padding="0" HorizontalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        ToolTip="Open this friend and their world details"
                                                        Command="{Binding DataContext.OpenFriendLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="40" Height="40" CornerRadius="20"
                                                                Background="{StaticResource PanelBrush}"
                                                                Margin="0,0,10,0">
                                                            <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="96" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding LocationTitle}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,2,0,0" />
                                                            <TextBlock Text="{Binding LocationDetail}"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <Button Content="Join"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="13,7" FontSize="11"
                                                            Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsJoinable, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="Not joinable"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               Visibility="{Binding IsJoinable, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No friends are in a joinable world right now."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasFriendLocations, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Friend-list changes popup                                 -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="24"
              Visibility="{Binding IsFriendChangesOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding CloseFriendChangesCommand}"
                    Focusable="False" Cursor="Arrow" ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Width="590" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="20,16" BorderBrush="{StaticResource SoftBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Friend changes" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Detected when the full friend list refreshes."
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            <ListBox ItemsSource="{Binding FriendChangeFilters}"
                                     SelectedItem="{Binding SelectedFriendChangeFilter, Mode=TwoWay}"
                                     Style="{StaticResource RegionPillList}"
                                     Margin="0,10,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="9,5">
                                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding FriendChangesSummary}"
                                       FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,10,16">
                            <ItemsControl ItemsSource="{Binding FriendChangesView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                Margin="0,0,0,7"
                                                Command="{Binding DataContext.OpenFriendChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{StaticResource InputBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="19"
                                                            Background="{StaticResource PanelBrush}" Margin="0,0,10,0">
                                                        <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="96" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ChangeLabel}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding RelativeTime}" FontSize="9.5"
                                                                   Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No friend-list changes yet. The first full refresh sets a baseline."
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="330" TextAlignment="Center"
                                   Visibility="{Binding HasNoFriendChanges, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- Avatar detail popup (Avatars, Favourites, Avatar Search)  -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="26"
              Visibility="{Binding AvatarViewModel.IsAvatarDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding AvatarViewModel.CloseAvatarDetailsCommand}"
                    Focusable="False"
                    Cursor="Arrow"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="860"
                    MaxHeight="800"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="#000000" />
                </Border.Effect>
            <!-- Avatar detail view: opens in its own page when a card is clicked -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="26,2,18,18"
                          MaxHeight="760">
                <StackPanel>
                    <Button Style="{StaticResource GhostButton}"
                            Content="â† Back to all avatars"
                            HorizontalAlignment="Left"
                            Padding="0,0,12,10"
                            Command="{Binding AvatarViewModel.CloseAvatarDetailsCommand}" />

                    <Border Style="{StaticResource Card}" Padding="24" Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="300" Height="300"
                                    CornerRadius="16"
                                    Background="{StaticResource InputBrush}"
                                    Margin="0,0,24,0">
                                <controls:AsyncImage SourceUrl="{Binding AvatarViewModel.SelectedAvatar.ImageUrl}"
                                                     DecodeWidth="512" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.DisplayName}"
                                               Style="{StaticResource PageTitle}"
                                               FontSize="26"
                                               TextWrapping="Wrap" />
                                    <Border Background="{StaticResource GreenBrush}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="10,6,0,0"
                                            VerticalAlignment="Top"
                                            Visibility="{Binding AvatarViewModel.SelectedAvatar.IsWearing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="WEARING"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="#08110C" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.AuthorName, StringFormat='by {0}'}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0" />

                                <WrapPanel Margin="0,14,0,0">
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.ReleaseStatusLabel}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                    </Border>
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="9,4"
                                            Margin="0,0,6,6">
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.PlatformsText, StringFormat='For {0}'}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Wear this avatar"
                                            Command="{Binding AvatarViewModel.WearAvatarCommand}"
                                            CommandParameter="{Binding AvatarViewModel.SelectedAvatar.Id}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Content="{Binding AvatarViewModel.SelectedAvatar.IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=Favourite|Add to favourites}"
                                            Command="{Binding AvatarViewModel.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding AvatarViewModel.SelectedAvatar.Id}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0"
                                            Content="Refresh"
                                            Command="{Binding AvatarViewModel.RefreshCommand}" />
                                </StackPanel>

                                <TextBlock Text="{Binding AvatarViewModel.StatusMessage}"
                                           Foreground="{StaticResource GreenBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"
                                           Visibility="{Binding AvatarViewModel.StatusMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="About this avatar" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding AvatarViewModel.SelectedAvatar.DescriptionText}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="110" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Created" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,4" />
                                            <TextBlock Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.CreatedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="1" Text="Updated" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.UpdatedText}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="2" Text="Platforms" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,0,14,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvatarViewModel.SelectedAvatar.PlatformsText}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>

        <!-- Which favourite slot?                                     -->
        <Grid Panel.ZIndex="29"
              Visibility="{Binding AvatarViewModel.IsSlotPickerOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding AvatarViewModel.CancelFavoriteSlotCommand}"
                    Focusable="False"
                    Cursor="Arrow"
                    ToolTip="Cancel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Save to which favourite slot?"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding AvatarViewModel.PendingFavoriteAvatarName}"
                               Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AvatarViewModel.SlotPickerMessage}"
                               FontSize="10.5"
                               Foreground="{StaticResource AccentHoverBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <ItemsControl ItemsSource="{Binding AvatarViewModel.FavoriteSlotChoices}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,0,8"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.AvatarViewModel.ChooseFavoriteSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Tag}">
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="12,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                            <TextBlock Text="{Binding Hint}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            FontSize="11"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding AvatarViewModel.CancelFavoriteSlotCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Launch chooser                                            -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="30"
              Visibility="{Binding IsLaunchChooserOpen, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding CancelLaunchChoiceCommand}"
                    Focusable="False"
                    Cursor="Arrow"
                    ToolTip="Close">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#C4060810" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Border Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,20">
                <StackPanel>
                    <TextBlock Text="{Binding LaunchChoiceTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LaunchChoiceSubtitle}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,18,0,0"
                            Padding="14,11"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ChooseLaunchModeCommand}"
                            CommandParameter="vr">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Launch in VR" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0"
                            Padding="14,11"
                            HorizontalContentAlignment="Center"
                            Command="{Binding ChooseLaunchModeCommand}"
                            CommandParameter="desktop">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="Launch on Desktop" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            HorizontalAlignment="Right"
                            Padding="12,5"
                            Margin="0,12,0,0"
                            Command="{Binding CancelLaunchChoiceCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- World details modal                                       -->
        <!-- ========================================================= -->
        <Grid Panel.ZIndex="20"
              Visibility="{Binding HasWorldDialog, Converter={StaticResource BoolToVis}}">
            <Border Background="#B8060810" />
            <Grid Margin="24">
                <Border Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        MaxWidth="1020"
                        MaxHeight="780"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        DataContext="{Binding WorldDialog}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Modal header -->
                        <Border BorderBrush="{StaticResource SoftBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="36" Height="36"
                                        CornerRadius="10"
                                        Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE909;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AuthorText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Padding="10,6"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.RefreshWorldDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Refresh world and instance data">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,6"
                                            Command="{Binding DataContext.CloseWorldDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Close (Esc)">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Modal body -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="18,14,14,18">
                            <StackPanel>
                                <!-- Hero -->
                                <Grid Height="148">
                                    <Border CornerRadius="12" Background="{StaticResource AccentGradient}" />
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#22080A11" Offset="0" />
                                                <GradientStop Color="#E6080A11" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,12">
                                        <WrapPanel>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding OccupancyText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding PlatformsText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6">
                                                <TextBlock Text="{Binding ReleaseStatusText}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6"
                                                    Visibility="{Binding HasCreatedInstance, Converter={StaticResource InverseBoolToVis}}"
                                                    ToolTip="Favorites">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FavoritesText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#CC141826"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,3"
                                                    Margin="0,0,7,6"
                                                    ToolTip="Visits">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VisitsText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource WhiteBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AuthorText}"
                                                   FontSize="11.5"
                                                   Foreground="#D9E9EDF5"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="380" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="350" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: details and instances -->
                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="About this world" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="{Binding Description}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           LineHeight="17.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,6,0,0" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <Border Style="{StaticResource TagChip}">
                                                        <TextBlock Text="{Binding TagsText}" Style="{StaticResource TagText}" Foreground="{StaticResource VioletBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagChip}"
                                                            Visibility="{Binding HasCreatedText, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource TagChip}"
                                                            Visibility="{Binding HasUpdatedText, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource TagText}" />
                                                    </Border>
                                                </WrapPanel>
                                                <Button Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left"
                                                        Padding="0,4"
                                                        Margin="0,2,0,0"
                                                        Command="{Binding DataContext.OpenWorldInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Summary}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="View on vrchat.com" FontSize="10.5" Foreground="{StaticResource BlueBrush}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Active instances" Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="{Binding Instances.Count, StringFormat={}{0} live}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource GreenBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="Only public and friends-visible instances are shown. Private instances require an invite."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,8" />

                                                <ItemsControl ItemsSource="{Binding Instances}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource InputBrush}"
                                                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9"
                                                                    Padding="10,6"
                                                                    Margin="0,0,0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="6" Height="6"
                                                                                     Fill="{StaticResource GreenBrush}"
                                                                                     VerticalAlignment="Center"
                                                                                     Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontSize="11.5"
                                                                                       FontWeight="SemiBold"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding DetailText}"
                                                                                   FontSize="10"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   Margin="12,3,0,0" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="1"
                                                                            Style="{StaticResource SecondaryButton}"
                                                                            Content="Join"
                                                                            Padding="13,5"
                                                                            FontSize="10.5"
                                                                            Margin="10,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            Command="{Binding DataContext.JoinWorldInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="No active instances found right now. Create one on the right."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasActiveInstances, Converter={StaticResource InverseBoolToVis}}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource ErrorBannerPanel}"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE7BA;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ErrorTextBrush}"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,8,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ErrorMessage}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource ErrorTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: create or join -->
                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="Create an instance" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Pick who can join and where it runs."
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,8" />

                                                <TextBlock Text="ACCESS" Style="{StaticResource FieldLabel}" />
                                                <ListBox Style="{StaticResource ChoiceListBox}"
                                                         ItemsSource="{Binding InstanceTypes}"
                                                         SelectedItem="{Binding SelectedType, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="9.5"
                                                                           Foreground="{StaticResource DimBrush}"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <TextBlock Text="REGION" Style="{StaticResource FieldLabel}" Margin="0,3,0,5" />
                                                <ListBox Style="{StaticResource RegionPillList}"
                                                         ItemsSource="{Binding Regions}"
                                                         SelectedItem="{Binding SelectedRegion, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <Button Style="{StaticResource PrimaryButton}"
                                                        Content="Create instance"
                                                        Margin="0,6,0,0"
                                                        Command="{Binding DataContext.CreateInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                <Border Background="{StaticResource AccentSoftBrush}"
                                                        BorderBrush="{StaticResource AccentBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,8"
                                                        Margin="0,10,0,0"
                                                        Visibility="{Binding HasCreatedInstance, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CreatedTitle}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentHoverBrush}" />
                                                        <TextBlock Text="{Binding CreatedMeta}"
                                                                   FontSize="9.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0" />
                                                        <WrapPanel Margin="0,8,0,0">
                                                            <Button Style="{StaticResource PrimaryButton}"
                                                                    Content="Launch VRChat"
                                                                    Padding="12,6"
                                                                    FontSize="10.5"
                                                                    Margin="0,0,6,0"
                                                                    Command="{Binding DataContext.LaunchCreatedInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Button Style="{StaticResource SecondaryButton}"
                                                                    Content="Copy share link"
                                                                    Padding="11,6"
                                                                    FontSize="10.5"
                                                                    Command="{Binding DataContext.CopyCreatedInstanceLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="15">
                                            <StackPanel>
                                                <TextBlock Text="Join a specific instance" Style="{StaticResource SectionTitle}" />
                                                <TextBlock Text="Paste a launch URL, short code, or location for this world."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,7" />
                                                <Grid>
                                                    <TextBox Style="{StaticResource InputBox}"
                                                             Text="{Binding JoinInstanceInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="Instance link or short code"
                                                               Margin="13,0,0,0"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding JoinInstanceInput}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="Join this world"
                                                        Margin="0,7,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.JoinDialogInputCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
