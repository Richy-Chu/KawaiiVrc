                                                        <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                            <Grid>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" />
                                                                    <Border Style="{StaticResource KawaiiChip}" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding StateText}"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource KawaiiMutedBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding OrderText}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource KawaiiMutedBrush}"
                                                                           HorizontalAlignment="Right" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding DetailText}"
                                                                       Style="{StaticResource KawaiiMuted}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                                <CheckBox Content="VR"
                                                                          IsChecked="{Binding UseInVr, Mode=TwoWay}"
                                                                          IsEnabled="{Binding IsAvailable}"
                                                                          Style="{StaticResource FriendlyCheckBox}"
                                                                          ToolTip="Include this integration when SteamVR or Oculus is running" />
                                                                <CheckBox Content="Desktop"
                                                                          IsChecked="{Binding UseInDesktop, Mode=TwoWay}"
                                                                          IsEnabled="{Binding IsAvailable}"
                                                                          Style="{StaticResource FriendlyCheckBox}"
                                                                          Margin="12,0,0,0"
                                                                          ToolTip="Include this integration when VRChat is running without VR" />
                                                                <Border Style="{StaticResource KawaiiChip}" Margin="10,0,0,0">
                                                                    <TextBlock Text="{Binding Category}"
                                                                               FontSize="9"
                                                                               Foreground="{DynamicResource KawaiiMutedBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <Border Background="{DynamicResource KawaiiShellBrush}"
                                                                    CornerRadius="6"
                                                                    Padding="8,5"
                                                                    Margin="0,7,0,0"
                                                                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Preview}"
                                                                           Foreground="{DynamicResource KawaiiMutedBrush}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsAvailable}"
                                                                      ToolTip="{Binding DetailText}"
                                                                      Style="{StaticResource FriendlyCheckBox}"
                                                                      HorizontalAlignment="Right" />
