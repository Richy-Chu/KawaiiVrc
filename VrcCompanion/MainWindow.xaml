                                    Command="{Binding VerifyTwoFactorCommand}" />

                            <Border Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="10"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding BusyText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource GhostButton}"
                                        Content="Use email code instead"
                                        Padding="0,2"
                                        Margin="0,0,12,0"
                                        FontSize="10.5"
                                        Command="{Binding UseEmailCodeCommand}"
                                        Visibility="{Binding ShowEmailSwitchLink, Converter={StaticResource BoolToVis}}" />
