                                                                ContentTemplate="{StaticResource SecurityFailedChip}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Bottom"
                                                                Margin="6"
                                                                Visibility="{Binding HasSecurityCheckFailed, Converter={StaticResource BoolToVis}}" />
