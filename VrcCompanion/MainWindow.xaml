                                                                        Command="{Binding DataContext.ChatboxViewModel.MoveIntegrationDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Padding="7,3"
                                                                        ToolTip="Later in the chatbox line" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

<Border Style="{StaticResource KawaiiPanel}">
                                <StackPanel>
                                    <TextBlock Text="How VRChat receives it" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="The composed line is sent over OSC to VRChat's /chatbox/input endpoint, which is the only chatbox API VRChat provides. There is no true transparent chatbox; the minimal bubble trick only changes VRChat's own background."
