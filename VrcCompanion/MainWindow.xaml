                            <Border Background="{StaticResource InputBrush}"
                                    CornerRadius="8"
                                    Visibility="{Binding BraveBrowserViewModel.IsBrowserOpen, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="440">
