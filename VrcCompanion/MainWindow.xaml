                                                               FontSize="8.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource DimBrush}" />
                                                </Border>
                                                <Border Style="{StaticResource TagChip}"
                                                        Padding="6,2"
                                                        Margin="0,0,4,4"
                                                        Visibility="{Binding HasPlatforms, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding PlatformsText}"
                                                               Style="{StaticResource TagText}"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </WrapPanel>

                                            <Border Background="{StaticResource AccentSoftBrush}"
                                                    CornerRadius="6"
                                                    Padding="7,3"
                                                    Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding IsWearing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="WEARING"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentHoverBrush}" />
                                            </Border>

                                            <ContentControl Content="{Binding TagLabels}"
                                                            ContentTemplate="{StaticResource AvatarTagChips}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Orientation="Horizontal"
                                                      Margin="0,10,0,0"
                                                      HorizontalAlignment="Right">
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="{Binding IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE735;|&#xE734;}"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Padding="8,4"
                                                        IsEnabled="{Binding CanUse}"
                                                        ToolTip="{Binding SecurityCheckFailedHint}"
                                                        Command="{Binding DataContext.AvatarViewModel.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,6">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Previous"
                                Padding="18,8"
                                Margin="0,0,10,0"
                                Command="{Binding AvatarViewModel.PreviousAvatarPageCommand}"
                                IsEnabled="{Binding AvatarViewModel.HasPreviousAvatarPage}" />
                        <TextBlock Text="{Binding AvatarViewModel.AvatarPageText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Next"
                                Padding="22,8"
                                Command="{Binding AvatarViewModel.NextAvatarPageCommand}"
                                IsEnabled="{Binding AvatarViewModel.HasNextAvatarPage}" />
                    </StackPanel>

                    <!-- Busy / error -->
                    <TextBlock Text="Loading your uploaded avatarsâ€¦"
                               Style="{StaticResource MutedText}"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding AvatarViewModel.StatusMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource GreenBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.StatusMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding AvatarViewModel.ErrorMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding AvatarViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                </StackPanel>
            </ScrollViewer>

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarSearchTemplate">
