                                <TextBlock Text="{Binding TwoFactorMethodLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentHoverBrush}" />
                            </Border>

                            <Border Style="{StaticResource ErrorBannerPanel}"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{StaticResource ErrorTextBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               FontSize="11"
                                               Foreground="{StaticResource ErrorTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <TextBlock Text="VERIFICATION CODE"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,16,0,6" />
                            <TextBox x:Name="TwoFactorBox"
                                     Style="{StaticResource InputBox}"
                                     Text="{Binding TwoFactorCode, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="17"
                                     MaxLength="24"
                                     KeyDown="TwoFactorBox_KeyDown" />

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Verify &amp; sign in"
                                    Height="40"
                                    Margin="0,16,0,0"
