                                           FontSize="19"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="Two-factor check"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,4" />
