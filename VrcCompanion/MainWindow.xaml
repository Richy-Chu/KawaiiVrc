                                                                    DecodeWidth="900"
                                                                    Opacity="0.82" />
                                        </Border>
                                        <Rectangle RadiusX="11" RadiusY="11">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#B30B0D12" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>

                                        <Button Style="{StaticResource ProfileGhostButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="7,4"
                                                Margin="6"
