                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Same bound as the uploaded grid: only the
                                     cards near the viewport stay built.
                                     Measured row height is 303.7 px. -->
                                <controls:VirtualizingWrapPanel ItemWidth="236"
                                                                EstimatedItemHeight="304"
                                                                CacheViewports="0.75" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Width="220"
                                        Margin="0,0,16,16">
                                    <StackPanel>
                                        <Button Style="{StaticResource CardButton}"
                                                Command="{Binding DataContext.AvatarViewModel.OpenAvatarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="Open this avatar">
                                            <StackPanel>
                                                <Border Width="140" Height="140"
                                                        CornerRadius="10"
                                                        Background="{StaticResource InputBrush}"
                                                        HorizontalAlignment="Center">
                                                    <Grid>
                                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="256">
                                                            <controls:AsyncImage.Style>
                                                                <Style TargetType="{x:Type controls:AsyncImage}">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSecurityCheckFailed}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.35" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </controls:AsyncImage.Style>
                                                        </controls:AsyncImage>
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource SecurityFailedChip}"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Bottom"
                                                                        Margin="6"
                                                                        Visibility="{Binding HasSecurityCheckFailed, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,10,0,2" />
                                                <TextBlock Text="{Binding AuthorName}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ContentControl Content="{Binding TagLabels}"
                                                                ContentTemplate="{StaticResource AvatarTagChips}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,7,0,0"
                                                                Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="6"
                                                Padding="7,3"
                                                Margin="0,7,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding IsWearing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="WEARING"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource SmallButton}"
                                                    Content="Wear"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding CanUse}"
                                                    ToolTip="{Binding SecurityCheckFailedHint}"
                                                    Command="{Binding DataContext.AvatarViewModel.WearAvatarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding IsFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE735;|&#xE734;}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    Margin="0,0,6,0"
                                                    IsEnabled="{Binding CanUse}"
                                                    ToolTip="{Binding SecurityCheckFailedHint}"
                                                    Command="{Binding DataContext.AvatarViewModel.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="{Binding IsLocalFavorite, Converter={StaticResource BoolToText}, ConverterParameter=&#xE840;|&#xE718;}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    IsEnabled="{Binding CanUse}"
                                                    ToolTip="{Binding SecurityCheckFailedHint}"
                                                    Command="{Binding DataContext.AvatarViewModel.ToggleLocalFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource EmptyStateCard}"
                            Visibility="{Binding AvatarViewModel.FavoriteAvatars.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="&#xE735;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="No favourite avatars yet"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="Star an avatar on the Uploaded Avatars tab and it is saved to your VRChat favourites."
                                       Style="{StaticResource MutedText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="GroupsTemplate">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,2,12,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="Create Group"
                                Padding="14,8"
                                FontSize="11"
                                Command="{Binding GroupViewModel.CreateGroupCommand}"
                            />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Refresh"
                                Padding="12,8"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Command="{Binding LoadGroupsCommand}" />
                    </StackPanel>

                    <!-- Joined group filter -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="SEARCH YOUR GROUPS" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding GroupViewModel.GroupFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Tag="Filter joined groups by name..." />
                        </StackPanel>
                    </Border>

                    <!-- Group discovery -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="DISCOVER GROUPS" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="Search VRChat for public groups by name or group ID."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,8"
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding GroupViewModel.GroupDiscoveryQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         Margin="0,0,8,0"
                                         Tag="Group name or grp_... ID" />
                                <Button Grid.Column="1"
                                        Content="Search"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,8"
                                        FontSize="11"
                                        Command="{Binding GroupViewModel.SearchGroupsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding GroupViewModel.GroupSearchMessage}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding GroupViewModel.GroupSearchResultsPage.Items}"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="38" Height="38" CornerRadius="8"
                                                        Background="#151A24" Margin="0,0,10,0">
                                                    <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                         DecodeWidth="96"
                                                                         CornerRadius="8" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MemberCount, StringFormat='{}{0} members'}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="View"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="10,5"
                                                        FontSize="10.5"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.GroupViewModel.OpenDiscoveredGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <controls:ListPager DataContext="{Binding GroupViewModel.GroupSearchResultsPage}"
                                                Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <TextBlock Text="{Binding GroupViewModel.ErrorMessage}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding GroupViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />

                    <!-- Group list -->
                    <ListBox ItemsSource="{Binding GroupViewModel.VisibleGroupsPage.Items}"
                             SelectedItem="{Binding GroupViewModel.SelectedGroup, Mode=TwoWay}"
                             Style="{StaticResource BareListBox}"
                             ItemContainerStyle="{StaticResource BareListItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="16,14"
                                        Cursor="Hand"
                                        ToolTip="Open group details"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Group icon -->
                                        <Border Grid.Column="0"
                                                Width="56" Height="56"
                                                CornerRadius="14"
                                                Background="{StaticResource InputBrush}"
                                                Margin="0,0,14,0">
                                            <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                 DecodeWidth="112" />
                                        </Border>

                                        <!-- Group info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding MemberCount, StringFormat='{}{0} members'}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <controls:ListPager DataContext="{Binding GroupViewModel.VisibleGroupsPage}"
                                        Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />

                    <!-- Empty state -->
                    <Border Visibility="{Binding GroupViewModel.VisibleGroups.Count, Converter={StaticResource IntToVis}, ConverterParameter=invert}"
                            Style="{StaticResource EmptyStateCard}">
                        <StackPanel>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="32" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding GroupViewModel.GroupListEmptyText}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="{Binding GroupViewModel.GroupListEmptyHint}"
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

                <!-- Group details popup -->
                <Grid Visibility="{Binding GroupViewModel.IsGroupDetailsOpen, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding GroupViewModel.CloseGroupDetailsCommand}"
                            Focusable="False"
                            Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                            ToolTip="Close">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#C4060810" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Width="620"
                            MaxHeight="740"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            DataContext="{Binding GroupViewModel.SelectedGroup}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="20,16"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="52" Height="52"
                                            CornerRadius="14"
                                            Background="{StaticResource InputBrush}"
                                            Margin="0,0,14,0">
                                        <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="104" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DataContext.GroupViewModel.SelectedGroupMemberText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Padding="7,4"
                                            Command="{Binding DataContext.GroupViewModel.CloseGroupDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Close">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="20,16,20,20"
                                          behaviors:ScrollViewerBehavior.PageToken="{Binding DataContext.GroupViewModel.PopupPageToken, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid>
                                <StackPanel Visibility="{Binding DataContext.GroupViewModel.IsGroupModerationOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="ABOUT" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               LineHeight="19"
                                               Foreground="{StaticResource MutedBrush}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Group details"
                                                Padding="12,6"
                                                FontSize="11"
                                                Margin="0,0,8,0"
                                                Command="{Binding DataContext.GroupViewModel.OpenSelectedGroupInfoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Instances, membership and join or leave" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Open on vrchat.com"
                                                Padding="12,6"
                                                FontSize="11"
                                                Command="{Binding DataContext.GroupViewModel.OpenSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Refresh members"
                                                Padding="12,6"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.GroupViewModel.RefreshMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Group moderation"
                                                Padding="12,6"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="GroupModerationButton"
                                                ToolTip="Kick, ban, roles, join requests, invites and the audit log"
                                                Command="{Binding DataContext.GroupViewModel.OpenGroupModerationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,16,0,0">
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="ACTIVE INSTANCES" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                                            <Button Content="Refresh"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="10"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.GroupViewModel.RefreshInstancesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBlock Text="Loading instances…"
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding DataContext.GroupViewModel.IsLoadingInstances, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="No group instances are open right now."
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding DataContext.GroupViewModel.NoInstances, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Instances, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="9"
                                                            Padding="10"
                                                            Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="40" Height="40" CornerRadius="8" Background="#151A24" Margin="0,0,10,0">
                                                                <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}" DecodeWidth="96" CornerRadius="8" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding WorldName}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DetailsText}" FontSize="10"
                                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2"
                                                                    Content="Join"
                                                                    Style="{StaticResource SecondaryButton}"
                                                                    Padding="10,5"
                                                                    FontSize="10.5"
                                                                    VerticalAlignment="Center"
                                                                    Command="{Binding DataContext.GroupViewModel.JoinGroupInstanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <TextBlock Text="MEMBERS"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,18,0,4" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid MinHeight="32">
                                            <TextBox Text="{Binding DataContext.GroupViewModel.MemberSearchText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}"
                                                     Padding="12,6"
                                                     FontSize="11.5"
                                                     MinHeight="32"
                                                     AutomationProperties.AutomationId="GroupMemberSearchBox"
                                                     AutomationProperties.Name="Search group members">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.GroupViewModel.SearchMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <TextBlock Text="Search a display name, username or usr_ id…"
                                                       Margin="13,0,0,0"
                                                       FontSize="11.5"
                                                       FontStyle="Italic"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Visibility="{Binding DataContext.GroupViewModel.HasMemberSearchText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}" />
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Content="Search"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,6"
                                                FontSize="10.5"
                                                MinHeight="32"
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.GroupViewModel.SearchMembersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Grid.Column="2"
                                                Content="Clear"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,6"
                                                FontSize="10"
                                                MinHeight="32"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.GroupViewModel.ClearMemberSearchCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DataContext.GroupViewModel.MembersSummary, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />

                                    <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Members, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding OpenProfileCommand}"
                                                        Style="{StaticResource GhostButton}"
                                                        HorizontalContentAlignment="Stretch"
                                                        Padding="0"
                                                        Margin="0,0,0,4"
                                                        AutomationProperties.Name="{Binding DisplayName}"
                                                        ToolTip="View this member's profile">
                                                    <Border CornerRadius="9"
                                                            BorderThickness="1"
                                                            Padding="9,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                        <Setter Property="Background" Value="#2A1E3B" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="30" Height="30" CornerRadius="15"
                                                                    Background="#1B2130" Margin="0,0,10,0">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initial}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                         DecodeWidth="60"
                                                                                         CornerRadius="15" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding IdText}"
                                                                           FontSize="9"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           Opacity="0.85"
                                                                           Margin="0,1,0,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding IdText}" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2"
                                                                    Background="#1A1430"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="7"
                                                                    Padding="9,3"
                                                                    Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="Profile"
                                                                           FontSize="9.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource MutedBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,6,0,0"
                                                Visibility="{Binding DataContext.GroupViewModel.IsMemberSearchActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Content="First"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="10.5"
                                                ToolTip="Go to the first page"
                                                Command="{Binding DataContext.GroupViewModel.FirstMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Previous"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="10.5"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.GroupViewModel.PreviousMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <TextBox Text="{Binding DataContext.GroupViewModel.MemberPageInput, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBox}"
                                                 Width="46"
                                                 Padding="6,4"
                                                 Margin="8,0,0,0"
                                                 FontSize="10.5"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 AutomationProperties.AutomationId="GroupMemberPageBox"
                                                 AutomationProperties.Name="Member page number"
                                                 AutomationProperties.HelpText="{Binding DataContext.GroupViewModel.MembersPageText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 ToolTip="Type a page number and press Enter">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter"
                                                            Command="{Binding DataContext.GroupViewModel.JumpToMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <TextBlock Text="{Binding DataContext.GroupViewModel.MembersPageCountText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,8,0" />
                                        <Button Content="Next"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="10.5"
                                                Command="{Binding DataContext.GroupViewModel.NextMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Last"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="9,5"
                                                FontSize="10.5"
                                                Margin="4,0,0,0"
                                                ToolTip="Go to the last page"
                                                Command="{Binding DataContext.GroupViewModel.LastMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Group moderation (opens from the Group moderation button) -->
                                <StackPanel Visibility="{Binding DataContext.GroupViewModel.IsGroupModerationOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <StackPanel.Resources>
                                        <DataTemplate x:Key="ModerationEntryTemplate">
                                            <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="9,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="14" Background="#1B2130" Margin="0,0,9,0"
                                                            Cursor="Hand"
                                                            ToolTip="Open this player's profile">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenProfileCommand}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="56" CornerRadius="14" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                Cursor="Hand"
                                                                ToolTip="Open this player's profile">
                                                        <StackPanel.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenProfileCommand}" />
                                                        </StackPanel.InputBindings>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding IdText}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Unban" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding UnbanCommand}"
                                                                Visibility="{Binding IsBan, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Accept" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding AcceptCommand}"
                                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Reject" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="10" Margin="2,0,0,0"
                                                                Command="{Binding RejectCommand}"
                                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Block" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="10" Margin="2,0,0,0"
                                                                ToolTip="Reject and block future requests"
                                                                Command="{Binding BlockCommand}"
                                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="4,0,0,0"
                                                                Command="{Binding CancelInviteCommand}"
                                                                Visibility="{Binding IsInvite, Converter={StaticResource BoolToVis}}" />
                                                        <Button Content="Copy ID"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="8,4"
                                                                FontSize="10"
                                                                Margin="2,0,0,0"
                                                                ToolTip="Copy this player's usr_ id"
                                                                Command="{Binding CopyIdCommand}" />
                                                        <Button Content="Profile"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="8,4"
                                                                FontSize="10"
                                                                Margin="2,0,0,0"
                                                                ToolTip="Open this player's profile"
                                                                Command="{Binding OpenProfileCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </StackPanel.Resources>

                                    <Grid Margin="0,0,0,2">
                                        <StackPanel>
                                            <TextBlock Text="GROUP MODERATION" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.GroupName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.MemberTotalText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Content="Back to group"
                                                Style="{StaticResource GhostButton}"
                                                Padding="9,4"
                                                FontSize="10.5"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.GroupViewModel.CloseGroupModerationCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <Border Height="10" />

                                    <WrapPanel Margin="0,0,0,10"
                                               Visibility="{Binding DataContext.GroupViewModel.Moderation.HasModerationPermission, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{Binding DataContext.GroupViewModel.Moderation.MembersTabLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Members" />
                                        <Button Content="{Binding DataContext.GroupViewModel.Moderation.BansTabLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Bans" />
                                        <Button Content="{Binding DataContext.GroupViewModel.Moderation.RequestsTabLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Requests" />
                                        <Button Content="{Binding DataContext.GroupViewModel.Moderation.InvitesTabLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Invites" />
                                        <Button Content="{Binding DataContext.GroupViewModel.Moderation.RolesTabLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Roles" />
                                        <Button Content="Audit log"
                                                Style="{StaticResource ChipButton}"
                                                Command="{Binding DataContext.GroupViewModel.Moderation.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="Audit log" />
                                    </WrapPanel>

                                    <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.StatusMessage, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding DataContext.GroupViewModel.Moderation.HasStatusMessage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                                    <!-- Destructive actions ask once before touching the group -->
                                    <Border Background="#2A1430"
                                            BorderBrush="{StaticResource PinkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10,7"
                                            Margin="0,0,0,10"
                                            Visibility="{Binding DataContext.GroupViewModel.Moderation.IsConfirmOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.PendingAction, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <Button Content="Confirm" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="10.5"
                                                        Command="{Binding DataContext.GroupViewModel.Moderation.ConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="10.5" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.GroupViewModel.Moderation.CancelConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Members: pick one, then kick, ban or swap its roles -->
                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowMembers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Moderate opens that member's card — kick, ban, roles and staff notes in one place."
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Members, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="9,6" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1B2130" Margin="0,0,9,0">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}" DecodeWidth="56" CornerRadius="14" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding IdText}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding RoleText}" FontSize="9" Foreground="{StaticResource PinkBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding NoteText}" FontSize="9" Foreground="{StaticResource MutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="Moderate" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10"
                                                                        Command="{Binding SelectCommand}" />
                                                                <Button Content="Kick" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="10" Margin="2,0,0,0"
                                                                        Command="{Binding KickCommand}" />
                                                                <Button Content="Ban" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="10" Margin="2,0,0,0"
                                                                        Command="{Binding BanCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Previous" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="10.5"
                                                    Command="{Binding DataContext.GroupViewModel.Moderation.PreviousMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.MembersPageText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0" />
                                            <Button Content="Next" Style="{StaticResource SecondaryButton}" Padding="9,5" FontSize="10.5"
                                                    Command="{Binding DataContext.GroupViewModel.Moderation.NextMembersPageCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowBans, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Bans, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource ModerationEntryTemplate}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowRequests, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Requests, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource ModerationEntryTemplate}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowInvites, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding DataContext.GroupViewModel.Moderation.InviteUserId, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}"
                                                     Padding="12,6"
                                                     FontSize="11.5"
                                                     MinHeight="32"
                                                     AutomationProperties.Name="User id to invite">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter"
                                                                Command="{Binding DataContext.GroupViewModel.Moderation.InviteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </TextBox.InputBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="Invite" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="10.5" MinHeight="32" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.GroupViewModel.Moderation.InviteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <TextBlock Text="Invite a player by their usr_ id (VRChat shows it as Copy user ID on their profile). Click a name, avatar or Profile to open that player's profile."
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Invites, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      ItemTemplate="{StaticResource ModerationEntryTemplate}" />
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowRoles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Roles decide what members can do for the whole group."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0" />
                                            <Button Grid.Column="1"
                                                    Content="New role"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,5"
                                                    FontSize="10.5"
                                                    Command="{Binding DataContext.GroupViewModel.Moderation.StartNewRoleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Roles, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}" CornerRadius="9" Padding="10,7" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Description}" FontSize="9.5"
                                                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding FlagsText}" FontSize="9" Foreground="{StaticResource PinkBrush}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding MemberCountText}" Style="{StaticResource MutedText}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10"
                                                                        Command="{Binding EditCommand}" />
                                                                <Button Content="Delete" Style="{StaticResource GhostButton}" Padding="7,4" FontSize="10" Margin="2,0,0,0"
                                                                        Command="{Binding DeleteCommand}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Background="#1A1430"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,10,0,0"
                                                Visibility="{Binding DataContext.GroupViewModel.Moderation.IsRoleEditorOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.RoleEditorTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding DataContext.GroupViewModel.Moderation.RoleEditorName, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}"
                                                         Padding="10,6"
                                                         FontSize="11.5"
                                                         MinHeight="30"
                                                         Margin="0,6,0,0"
                                                         AutomationProperties.Name="Role name"
                                                         AutomationProperties.AutomationId="GroupRoleNameBox" />
                                                <TextBox Text="{Binding DataContext.GroupViewModel.Moderation.RoleEditorDescription, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}"
                                                         Padding="10,6"
                                                         FontSize="11.5"
                                                         MinHeight="30"
                                                         Margin="0,6,0,0"
                                                         AutomationProperties.Name="Role description" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <CheckBox IsChecked="{Binding DataContext.GroupViewModel.Moderation.RoleEditorAddedOnJoin, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              Content="Added when someone joins"
                                                              Foreground="{StaticResource MutedBrush}"
                                                              FontSize="10.5"
                                                              Margin="0,0,14,0" />
                                                    <CheckBox IsChecked="{Binding DataContext.GroupViewModel.Moderation.RoleEditorSelfAssignable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              Content="Members can assign it themselves"
                                                              Foreground="{StaticResource MutedBrush}"
                                                              FontSize="10.5" />
                                                </StackPanel>
                                                <TextBlock Text="PERMISSIONS" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                                <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.RolePermissions, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                                      Content="{Binding Label}"
                                                                      Foreground="{StaticResource MutedBrush}"
                                                                      FontSize="10.5"
                                                                      Width="252"
                                                                      Margin="0,0,4,4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <Button Content="{Binding DataContext.GroupViewModel.Moderation.RoleEditorActionText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="12,6"
                                                            FontSize="10.5"
                                                            Command="{Binding DataContext.GroupViewModel.Moderation.SaveRoleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Content="Cancel"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,6"
                                                            FontSize="10.5"
                                                            Margin="4,0,0,0"
                                                            Command="{Binding DataContext.GroupViewModel.Moderation.CloseRoleEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding DataContext.GroupViewModel.Moderation.ShowLog, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Log, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="9,6" Margin="0,0,0,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       FontSize="9"
                                                                       Foreground="{StaticResource MutedBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- Member moderation popup: opened by Moderate, grouped the way VRCX does it -->
                            <Grid Grid.RowSpan="2"
                                  x:Name="ModerationMemberCardOverlay"
                                  Panel.ZIndex="6"
                                  Visibility="{Binding DataContext.GroupViewModel.Moderation.IsMemberCardOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <Button Command="{Binding DataContext.GroupViewModel.Moderation.CloseMemberCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Focusable="False"
                                        Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                        AutomationProperties.Name="Close member card">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#D9060810" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Border Width="470"
                                        MaxHeight="600"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Padding="16,12"
                                                BorderBrush="{StaticResource SoftBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" CornerRadius="23" Background="#1B2130" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.Initial, RelativeSource={RelativeSource AncestorType=Window}}"
