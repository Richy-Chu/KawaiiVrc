                                       Foreground="{StaticResource ErrorTextBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding DiscordBrowserViewModel.IsFocusMode, Converter={StaticResource InverseBoolToVis}}" />
                            <TextBlock Text="{Binding DiscordBrowserViewModel.DownloadStatus}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscordBrowserViewModel.DownloadStatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Live instance popup                                       -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="InstanceTemplate">
            <Grid Margin="26,2,26,20">
                <Border Background="#A8060810" CornerRadius="18" />

                <Border MaxWidth="1180"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Popup header -->
                        <Border BorderBrush="{StaticResource SoftBorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40"
                                        CornerRadius="11"
                                        Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7F4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="17"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="INSTANCE"
                                                   Style="{StaticResource FieldLabel}"
                                                   Margin="0,0,9,0"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{StaticResource GreenBrush}"
                                                CornerRadius="999"
                                                Padding="5,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="LIVE"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="#07120D" />
                                        </Border>
                                        <TextBlock Text="{Binding InstanceViewModel.LastUpdatedText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding InstanceViewModel.HeaderTitle}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RefreshInstanceCommand}"
                                            Padding="11,7"
                                            Margin="0,0,7,0"
                                            ToolTip="Refresh the live instance and its players">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding CopyInstanceLinkCommand}"
                                            Padding="11,7"
                                            Margin="0,0,7,0"
                                            ToolTip="Copy the VRChat instance link">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Copy link" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Command="{Binding CloseInstanceCommand}"
                                            Padding="8,6"
                                            ToolTip="Close the instance popup">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ProgressBar Grid.Row="1"
                                     Height="2"
                                     IsIndeterminate="True"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Visibility="{Binding InstanceViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />

                        <Grid Grid.Row="2">
                            <!-- Live instance content -->
                            <Grid Margin="20"
                                  Visibility="{Binding InstanceViewModel.ShowContent, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="326" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- World + instance facts -->
                                <ScrollViewer Grid.Column="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,8,0">
                                    <StackPanel>
                                        <Border Height="172"
                                                CornerRadius="16"
                                                Background="{StaticResource InputBrush}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="&#xE909;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="34"
                                                           Foreground="{StaticResource BorderBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <controls:AsyncImage SourceUrl="{Binding InstanceViewModel.WorldImageUrl}"
                                                                     DecodeWidth="640"
                                                                     CornerRadius="16" />
                                                <Border VerticalAlignment="Bottom"
                                                        Background="#C40B0D16"
                                                        Padding="12,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                                CornerRadius="7"
                                                                Padding="7,3">
                                                            <TextBlock Text="{Binding InstanceViewModel.InstanceAccessText}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                                        </Border>
                                                        <Border Background="{StaticResource InputBrush}"
                                                                CornerRadius="7"
                                                                Padding="7,3"
                                                                Margin="5,0,0,0">
                                                            <TextBlock Text="{Binding InstanceViewModel.RegionText}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="{Binding InstanceViewModel.WorldName}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,13,0,0" />
                                        <TextBlock Text="{Binding InstanceViewModel.WorldAuthorText}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />

                                        <TextBlock Text="{Binding InstanceViewModel.WorldDescriptionText}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,10,0,0" />

                                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="INSTANCE INFORMATION" Style="{StaticResource FieldLabel}" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="Instance" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding InstanceViewModel.InstanceNumberText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="1" Text="Access" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstanceViewModel.InstanceAccessText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="2" Text="Region" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstanceViewModel.RegionText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="3" Text="Owner" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding InstanceViewModel.OwnerText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding InstanceViewModel.OwnerKindText}"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource DimBrush}"
                                                                   Margin="5,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="4" Text="Capacity" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstanceViewModel.PlayerCountText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="5" Text="Age gate" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InstanceViewModel.AgeGateText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="6" Text="Queue" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding InstanceViewModel.QueueText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="7" Text="Platforms" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding InstanceViewModel.PlatformsText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="8" Text="Avatars" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding InstanceViewModel.MinimumAvatarPerformanceText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="WORLD" Style="{StaticResource FieldLabel}" />
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Visits" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding InstanceViewModel.WorldVisitsText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="1" Text="Favourites" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstanceViewModel.WorldFavoritesText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="2" Text="Published" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstanceViewModel.WorldPublishedText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="3" Text="Updated" Style="{StaticResource MutedText}" FontSize="10.5" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstanceViewModel.WorldUpdatedText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Grid.Row="4" Text="World cap" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,6,0,0" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding InstanceViewModel.WorldCapacityText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                                                    <TextBlock Grid.Row="5" Text="Recommended" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,6,0,0" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding InstanceViewModel.RecommendedCapacityText}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" />
                                                </Grid>
                                                <TextBlock Text="{Binding InstanceViewModel.WorldTagsText}"
                                                           FontSize="9.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,9,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Players -->
                                <Grid Grid.Column="1" Margin="20,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding InstanceViewModel.PlayersHeader}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding InstanceViewModel.InstanceTagsText}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="9.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding InstanceViewModel.PlayersSummary}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding InstanceViewModel.PlayerListSourceText}"
                                                       FontSize="9"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Grid.Row="1"
                                             Style="{StaticResource InputBox}"
                                             Text="{Binding InstanceViewModel.PlayerSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Search players, trust rank, or platform…"
                                             Margin="0,12,0,0" />

                                    <StackPanel Grid.Row="2" Margin="0,9,0,9">
                                        <TextBlock Text="{Binding InstanceViewModel.ProfileStatusText}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                   Visibility="{Binding InstanceViewModel.HasProfileStatus, Converter={StaticResource BoolToVis}}"
                                                   Margin="0,0,0,6" />
                                        <Border Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource SoftBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,7">
                                            <TextBlock Text="{Binding InstanceViewModel.PlayerListNotice}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ScrollViewer Grid.Row="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Padding="0,0,6,0">
                                            <ItemsControl ItemsSource="{Binding InstanceViewModel.PlayersPage.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ListRow}" Padding="11" Margin="0,0,0,8">
                                                            <Button Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    Cursor="Hand"
                                                                    IsEnabled="{Binding CanOpenProfile}"
                                                                    ToolTip="Open this player's VRChat profile"
                                                                    Command="{Binding DataContext.OpenInstancePlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                                              VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter Property="Cursor" Value="Arrow" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <Grid Width="42" Height="42" Margin="0,0,11,0">
                                                                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                                    <Border CornerRadius="21" ClipToBounds="True" Background="{StaticResource InputBrush}">
                                                                        <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                             DecodeWidth="96"
                                                                                             CornerRadius="21" />
                                                                    </Border>
                                                                    <TextBlock Text="&#xE77B;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="17"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Visibility="{Binding AvatarUrl, Converter={StaticResource StringEmptyToVis}}" />
                                                                    <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                                            IntroUrl="{Binding IconFrameIntroUrl}"
                                                                                            DecodeWidth="128"
                                                                                            Width="54"
                                                                                            Height="54"
                                                                                         HorizontalAlignment="Center"
                                                                                         VerticalAlignment="Center"
                                                                                         Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                                                    <Ellipse Width="11" Height="11"
                                                                             Fill="{Binding StatusDotBrush}"
                                                                             Stroke="{StaticResource PanelBrush}"
                                                                             StrokeThickness="2"
                                                                             HorizontalAlignment="Right"
                                                                             VerticalAlignment="Bottom"
                                                                             Margin="0,0,-1,-1" />
                                                                </Grid>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="12.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding TrustBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{Binding BlockedMarker}"
                                                                                   FontSize="10.5"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource RedBrush}"
                                                                                   ToolTip="{Binding BlockedToolTip}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="5,0,0,0"
                                                                                   Visibility="{Binding HasBlockedMarker, Converter={StaticResource BoolToVis}}" />
                                                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                                                CornerRadius="6"
                                                                                Padding="5,1"
                                                                                Margin="7,0,0,0"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{Binding BadgeText}"
                                                                                       FontSize="8.5"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding DetailText}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,2,0,0" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                        <TextBlock Text="{Binding StatusText}"
                                                                                   FontSize="9"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding StatusBrush}"
                                                                                   Margin="0,0,7,0" />
                                                                        <TextBlock Text="{Binding LanguageText}"
                                                                                   FontSize="9"
                                                                                   Foreground="{StaticResource DimBrush}"
                                                                                   Visibility="{Binding HasLanguage, Converter={StaticResource BoolToVis}}"
                                                                                   Margin="0,0,7,0" />
                                                                        <TextBlock Text="{Binding AgeText}"
                                                                                   FontSize="9"
                                                                                   Foreground="{StaticResource GreenBrush}"
                                                                                   Visibility="{Binding HasAge, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                    <Border Background="{StaticResource InputBrush}"
                                                                            CornerRadius="7"
                                                                            Padding="7,2"
                                                                            HorizontalAlignment="Right">
                                                                        <TextBlock Text="{Binding TrustText}"
                                                                                   FontSize="9"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding TrustBrush}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding PlatformText}"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource DimBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               Margin="0,4,0,0"
                                                                               Visibility="{Binding HasPlatform, Converter={StaticResource BoolToVis}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            </Button>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <controls:ListPager Grid.Row="1"
                                                            DataContext="{Binding InstanceViewModel.PlayersPage}"
                                                            Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />

                                        <Border Style="{StaticResource EmptyStateCard}"
                                                VerticalAlignment="Top"
                                                Margin="0,4,0,0"
                                                Visibility="{Binding InstanceViewModel.HasVisiblePlayers, Converter={StaticResource InverseBoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="&#xE716;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="24"
                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding InstanceViewModel.PlayersEmptyMessage}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,9,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Signed in but not in a world -->
                            <Grid Visibility="{Binding InstanceViewModel.ShowEmptyState, Converter={StaticResource BoolToVis}}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border Width="460" Style="{StaticResource EmptyStateCard}" Padding="28">
                                    <StackPanel>
                                        <Border Width="52" Height="52"
                                                CornerRadius="14"
                                                Background="{StaticResource AccentSoftBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE7F4;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding InstanceViewModel.EmptyTitle}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,14,0,0" />
                                        <TextBlock Text="{Binding InstanceViewModel.EmptyMessage}"
                                                   Style="{StaticResource MutedText}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Refresh"
                                                HorizontalAlignment="Center"
                                                Margin="0,16,0,0"
                                                Command="{Binding RefreshInstanceCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Inline errors stay inside the popup -->
                            <Border Style="{StaticResource ErrorBannerPanel}"
                                    MaxWidth="620"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="20,18,20,0"
                                    Visibility="{Binding InstanceViewModel.HasError, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource ErrorTextBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding InstanceViewModel.ErrorMessage}"
                                               FontSize="11"
                                               Foreground="{StaticResource ErrorTextBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActivityTemplate">
            <DataTemplate.Resources>
                <Style x:Key="ActivityFilterPill" TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="PillBorder"
                                        Background="#CC1B1530"
                                        BorderBrush="#3A2850"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PillBorder" Property="Background" Value="#D9221838" />
                                        <Setter TargetName="PillBorder" Property="BorderBrush" Value="#5B3D7E" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                        <Setter Property="Foreground" Value="#FFD8EA" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="ActivityFilterList" TargetType="ListBox" BasedOn="{StaticResource RegionPillList}">
                    <Setter Property="ItemContainerStyle" Value="{StaticResource ActivityFilterPill}" />
                </Style>

                <Style x:Key="ActivityRow" TargetType="Border">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="12,11" />
                    <Setter Property="Background" Value="#CC171329" />
                    <Setter Property="BorderBrush" Value="#3A2A54" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#D91F1735" />
                            <Setter Property="BorderBrush" Value="#5B3D7E" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataTemplate.Resources>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,2,12,12"
                              behaviors:ScrollViewerBehavior.PageToken="{Binding ActivityFeedViewModel.PageToken}">
                <StackPanel>
                    <TextBlock Text="{Binding ActivityFeedViewModel.CheckedFriendsText}"
                               FontSize="10"
                               Foreground="{StaticResource DimBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,0,2,10" />

                    <Border Background="#33FF5C7A"
                            BorderBrush="#8A425B"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8"
                            Margin="0,0,0,12"
                            Visibility="{Binding ActivityFeedViewModel.HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActivityFeedViewModel.ErrorMessage}"
                                   FontSize="11"
                                   Foreground="{StaticResource ErrorTextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Filter chips -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="FILTER  ♡"
                                   Style="{StaticResource KawaiiSectionLabel}"
                                   VerticalAlignment="Top"
                                   Margin="2,7,9,0" />
                        <ListBox ItemsSource="{Binding ActivityFeedViewModel.Filters}"
                                 SelectedItem="{Binding ActivityFeedViewModel.SelectedFilterOption, Mode=TwoWay}"
                                 Style="{StaticResource ActivityFilterList}"
                                 MaxHeight="44">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Search -->
                    <Border Style="{StaticResource KawaiiCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SEARCH ACTIVITY  ♡" Style="{StaticResource KawaiiSectionLabel}" />
                            <TextBox Text="{Binding ActivityFeedViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Background="#CC160F26"
                                     BorderBrush="#45305F"
                                     Tag="Search by username, user ID, world, or activity..." />

                            <!-- The person this search resolved to, even with no activity yet -->
                            <Border Margin="0,10,0,0"
                                    Padding="10,9"
                                    CornerRadius="12"
                                    Background="#CC171329"
                                    BorderBrush="#3A2A54"
                                    BorderThickness="1"
                                    Visibility="{Binding ActivityFeedViewModel.HasSearchPerson, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="18"
                                            Background="{StaticResource AccentGradientPink}">
                                        <Border Margin="2"
                                                CornerRadius="16"
                                                Background="{StaticResource InputBrush}">
                                            <controls:AsyncImage SourceUrl="{Binding ActivityFeedViewModel.SearchPerson.AvatarUrl}"
                                                                 CornerRadius="16"
                                                                 DecodeWidth="72" />
                                        </Border>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,8,0"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ActivityFeedViewModel.SearchPerson.DisplayName}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Background="#33F472B6"
                                                    BorderBrush="#5A3D82"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="4,1"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="This is your own account"
                                                    Visibility="{Binding ActivityFeedViewModel.SearchPerson.IsSelf, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="YOU"
                                                           FontSize="8"
                                                           FontWeight="Bold"
                                                           Foreground="#FFD8EA" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ActivityFeedViewModel.SearchPersonMeta}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Background="#33F472B6"
                                            BorderBrush="#5A3D82"
                                            Content="View profile"
                                            Padding="10,5"
                                            FontSize="9.5"
                                            VerticalAlignment="Center"
                                            ToolTip="Open this person's VRChat profile"
                                            Command="{Binding DataContext.OpenActivityUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding ActivityFeedViewModel.SearchPerson}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Activity list -->
                    <TextBlock Text="{Binding ActivityFeedViewModel.NoEntriesText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="2,4,2,12"
                               Visibility="{Binding ActivityFeedViewModel.HasNoEntries, Converter={StaticResource BoolToVis}}" />
                    <!-- Routed through a virtualizing panel: it lays rows out exactly like the
                         default stack, so nothing moves, and a bounded scroll host around this
                         list would then only realize the rows on screen. -->
                    <ItemsControl ItemsSource="{Binding ActivityFeedViewModel.Entries}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ActivityRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="3"
                                                CornerRadius="2"
                                                Background="{StaticResource AccentGradientPink}"
                                                Margin="0,3,10,3"
                                                HorizontalAlignment="Left" />

                                        <!-- Avatar (clickable for avatar changes) -->
                                        <Button Grid.Column="1"
                                                Width="44" Height="44"
                                                Margin="0,0,12,0"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                ToolTip="Open this person's VRChat profile"
                                                Command="{Binding DataContext.OpenActivityUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Width="44" Height="44"
                                                    CornerRadius="22"
                                                    Background="{StaticResource AccentGradientPink}">
                                                <Border Margin="2"
                                                        CornerRadius="20"
                                                        Background="{StaticResource InputBrush}">
                                                    <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                         CornerRadius="20"
                                                                         DecodeWidth="96" />
                                                </Border>
                                            </Border>
                                        </Button>

                                        <!-- Activity details (opens the live VRChat profile) -->
                                        <Button Grid.Column="2"
                                                Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                ToolTip="Open this person's VRChat profile"
                                                Command="{Binding DataContext.OpenActivityUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Foreground>
                                                            <MultiBinding Converter="{StaticResource TrustNameBrush}">
                                                                <Binding Path="Tags" />
                                                                <Binding Path="DeveloperType" />
                                                            </MultiBinding>
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <Border Background="#33F472B6"
                                                            BorderBrush="#5A3D82"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="4,1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            ToolTip="This activity is from your own account"
                                                            Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="YOU"
                                                                   FontSize="8"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FFD8EA" />
                                                    </Border>
                                                    <TextBlock Text="  ·  "
                                                               FontSize="11"
                                                               Foreground="#7B629B" />
                                                    <TextBlock Text="{Binding Details}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource KawaiiMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="♡"
                                                               FontSize="9"
                                                               Foreground="#9D79C4"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding RelativeTime}"
                                                               FontSize="10"
                                                               Foreground="#B7A6D6" />
                                                    <TextBlock Text="  ·  "
                                                               FontSize="10"
                                                               Foreground="#7B629B" />
                                                    <TextBlock Text="{Binding TimestampText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource DimBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="3"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Background="#33F472B6"
                                                    BorderBrush="#5A3D82"
                                                    Padding="10,5"
                                                    IsEnabled="{Binding CanOpenAvatar}"
                                                    ToolTip="{Binding AvatarActionTooltip}"
                                                    Command="{Binding DataContext.OpenActivityAvatarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsAvatarChange, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="AvatarChanged"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFD8EA"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="View avatar  ♡"
                                                               FontSize="8.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PinkBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <Border Background="#33F472B6"
                                                    BorderBrush="#5A3D82"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsAvatarChange, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="{Binding Type}"
                                                           FontSize="9"
                                                           Foreground="#FFD8EA"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Refresh -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource KawaiiActionButton}"
                                Content="♡  Refresh"
                                Command="{Binding LoadActivityFeedCommand}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <!-- Paging: the timeline shows one page at a time instead of scrolling forever -->
                <Border Grid.Row="1"
                        Background="#E6141024"
                        BorderBrush="#3A2A54"
                        BorderThickness="0,1,0,0"
                        Padding="16,9"
                        Visibility="{Binding ActivityFeedViewModel.HasPages, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ActivityFeedViewModel.PageSummaryText}"
                                   FontSize="10"
                                   Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="‹  Previous"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Command="{Binding ActivityFeedViewModel.PreviousPageCommand}"
                                    IsEnabled="{Binding ActivityFeedViewModel.HasPreviousPage}" />
                            <TextBlock Text="{Binding ActivityFeedViewModel.PageText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />
                            <Button Content="Next  ›"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="12,6"
                                    FontSize="11"
                                    Command="{Binding ActivityFeedViewModel.NextPageCommand}"
                                    IsEnabled="{Binding ActivityFeedViewModel.HasNextPage}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AccountsTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,2,12,12">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="9"
                                        Padding="8,2"
                                        Margin="10,3,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="♡"
                                               FontSize="12"
                                               Foreground="{StaticResource PinkBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Your cozy little corner for every VRChat identity."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="52"
                                Height="52"
                                CornerRadius="26"
                                Background="{StaticResource AccentGradientPink}"
                                VerticalAlignment="Center">
                            <TextBlock Text="✦"
                                       FontSize="20"
                                       Foreground="{StaticResource WhiteBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Active account -->
                    <Border Margin="0,0,0,16"
                            Padding="20"
                            CornerRadius="22"
                            Background="#CC171427"
                            BorderBrush="#40345F"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="28"
                                    Background="{StaticResource AccentGradientPink}">
                                <TextBlock Text="{Binding MultiAccountViewModel.ActiveAccountInitial}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WhiteBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="14,0,12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="SIGNED IN"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0" />
                                <TextBlock Text="{Binding MultiAccountViewModel.ActiveAccountLabel}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="Your session is encrypted on this PC with Windows DPAPI."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Right">
                                <Border Background="#33233F"
                                        CornerRadius="10"
                                        Padding="9,5"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6"
                                                 Height="6"
                                                 Fill="{StaticResource GreenBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,5,0" />
                                        <TextBlock Text="ACTIVE"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenBrush}" />
                                    </StackPanel>
                                </Border>
                                <Button Content="Back to sign-in"
                                        Style="{StaticResource GhostButton}"
                                        Padding="4,2"
                                        FontSize="10"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ReturnToSignInCommand}"
                                        ToolTip="Shows the sign-in screen with your saved accounts. Your saved sessions stay on this PC until you use Sign out." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Save the signed-in account -->
                    <Border Margin="0,0,0,18"
                            Padding="18"
                            CornerRadius="18"
                            Background="{StaticResource RowBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="✦"
                                           FontSize="16"
                                           Foreground="{StaticResource VioletBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Margin="12,0,14,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Keep this account close"
                                           Style="{StaticResource SectionTitle}"
                                           FontSize="13" />
                                <TextBlock Text="Save the session you are signed in with so you can hop back to it later."
                                           Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding MultiAccountViewModel.ErrorMessage}"
                                           Style="{StaticResource MutedText}"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding MultiAccountViewModel.ErrorMessage, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="♡  Save account"
                                    Padding="14,8"
                                    FontSize="11"
                                    VerticalAlignment="Center"
                                    Command="{Binding MultiAccountViewModel.AddAccountCommand}" />
                        </Grid>
                    </Border>

                    <!-- Account list -->
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="Saved accounts"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="2,0,0,0" />
                        <TextBlock Text="Pick up where you left off"
                                   FontSize="10"
                                   Foreground="{StaticResource DimBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MultiAccountViewModel.Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="AccountCard"
                                        Margin="0,0,0,9"
                                        Padding="14,12"
                                        Background="{StaticResource RowBrush}"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="44"
                                                Height="44"
                                                CornerRadius="22"
                                                Background="{StaticResource AccentSoftBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="12,0,10,0"
                                                    VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center" />
                                                <Border Background="#33233F"
                                                        CornerRadius="7"
                                                        Padding="6,2"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ACTIVE"
                                                               FontSize="8"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource GreenBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Saved on this PC"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="Switch"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="11,6"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.MultiAccountViewModel.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}" />
                                            <Button Content="Remove"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="10,6"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.MultiAccountViewModel.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip="Remove this saved account" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="AccountCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="AccountCard" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate x:Key="ContinuityTemplate">
            <controls:ContinuityView DataContext="{Binding ContinuityViewModel}" />
        </DataTemplate>

        <DataTemplate x:Key="ContextTemplate">
            <controls:ContextView DataContext="{Binding ContextViewModel}" />
        </DataTemplate>

        <DataTemplate x:Key="MediaTemplate">
            <Grid Margin="24,20,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Summary and page controls -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding MediaViewModel.SummaryText}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="{Binding MediaViewModel.RootPath}"
                                   Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Previous"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.PreviousPageCommand}"
                                IsEnabled="{Binding MediaViewModel.HasPreviousPage}"
                                Padding="12,6" FontSize="11" />
                        <TextBlock Text="{Binding MediaViewModel.PageText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,0" />
                        <Button Content="Next"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.NextPageCommand}"
                                IsEnabled="{Binding MediaViewModel.HasNextPage}"
                                Padding="12,6" FontSize="11"
                                Margin="10,0,8,0" />
                        <Button Content="Open folder"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.OpenFolderCommand}"
                                Padding="12,6" FontSize="11" />
                        <Button Content="Refresh"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding MediaViewModel.RefreshCommand}"
                                Padding="12,6" FontSize="11" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Search plus world/person filters, like the gallery filters in VRCX -->
                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="14,12"
                        Margin="0,0,0,12"
                        Visibility="{Binding MediaViewModel.HasPictures, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}"
                                     FontSize="12"
                                     Tag="Search by file name, world or player…"
                                     Text="{Binding MediaViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear filters"
                                    Padding="12,6"
                                    FontSize="11"
                                    Margin="8,0,0,0"
                                    Command="{Binding MediaViewModel.ClearFiltersCommand}"
                                    Visibility="{Binding MediaViewModel.HasActiveFilter, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Text="{Binding MediaViewModel.FilterSummaryText}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="10.5"
                                   Margin="2,7,0,0"
                                   Visibility="{Binding MediaViewModel.HasFilterSummary, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="WORLD" Style="{StaticResource FieldLabel}" Margin="2,0,0,5" />
                                <ComboBox Style="{StaticResource MediaFilterCombo}"
                                          ItemsSource="{Binding MediaViewModel.WorldFilterOptions}"
                                          ItemTemplate="{StaticResource MediaFilterOptionTemplate}"
                                          SelectedItem="{Binding MediaViewModel.SelectedWorldFilter, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="PERSON" Style="{StaticResource FieldLabel}" Margin="2,0,0,5" />
                                <ComboBox Style="{StaticResource MediaFilterCombo}"
                                          ItemsSource="{Binding MediaViewModel.PeopleFilterOptions}"
                                          ItemTemplate="{StaticResource MediaFilterOptionTemplate}"
                                          SelectedItem="{Binding MediaViewModel.SelectedPeopleFilter, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              behaviors:ScrollViewerBehavior.PageToken="{Binding MediaViewModel.PageToken}">
                    <ItemsControl ItemsSource="{Binding MediaViewModel.PageCards}"
                                  ItemTemplate="{StaticResource MediaCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Text="{Binding MediaViewModel.LoadingText}"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding MediaViewModel.IsBusy, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding MediaViewModel.HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{StaticResource ErrorTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MediaViewModel.ErrorMessage}"
                               Foreground="#C9CEDC"
                               Margin="0,8,0,0"
                               TextAlignment="Center"
                               MaxWidth="420"
                               TextWrapping="Wrap" />
                    <Button Content="Retry"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding MediaViewModel.RefreshCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding MediaViewModel.EmptyMessage}"
                           Foreground="#8C93A6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding MediaViewModel.IsEmpty, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding MediaViewModel.IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MediaViewModel.FilteredEmptyMessage}"
                               Foreground="#8C93A6"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               TextAlignment="Center" />
                    <Button Content="Clear filters"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,6"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding MediaViewModel.ClearFiltersCommand}" />
                </StackPanel>

                <!-- In-app picture viewer with the world, session and players -->
                <Grid x:Name="MediaViewerOverlay" Grid.RowSpan="3" Panel.ZIndex="10"
                      Visibility="{Binding MediaViewModel.IsViewerOpen, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding MediaViewModel.CloseViewerCommand}"
                            Focusable="False"
                            Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                            ToolTip="Close picture">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#F2070910" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Margin="22,16,22,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,260,0">
                                <TextBlock Text="{Binding MediaViewModel.ViewerTitle}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#E6E9F0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MediaViewModel.ViewerTakenText}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Open in Explorer"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="11,6"
                                        FontSize="11"
                                        Command="{Binding MediaViewModel.OpenSelectedInShellCommand}" />
                                <Button Content="Close"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="11,6"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding MediaViewModel.CloseViewerCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#0B0D12"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    ClipToBounds="True">
                                <Image Source="{Binding MediaViewModel.ViewerImage}"
                                       Stretch="Uniform"
                                       Margin="10" />
                            </Border>

                            <Button Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,16"
                                    FontSize="16"
                                    Content="&#xE76B;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Command="{Binding MediaViewModel.PreviousImageCommand}" />
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,16"
                                    FontSize="16"
                                    Content="&#xE76C;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Command="{Binding MediaViewModel.NextImageCommand}" />

                            <!-- Picture metadata. A sticker or another game's shot
                                 has no VRChat session, so the panel is hidden. -->
                            <Border Grid.Column="1"
                                    Width="286"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding MediaViewModel.ViewerShowsMetaPanel, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="TAKEN IN" Style="{StaticResource FieldLabel}" />

                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                IsEnabled="{Binding MediaViewModel.CanOpenViewerWorld}"
                                                ToolTip="Open this world"
                                                Command="{Binding OpenMediaWorldCommand}"
                                                CommandParameter="{Binding MediaViewModel.ViewerContext}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="76" Height="52"
                                                        CornerRadius="9"
                                                        ClipToBounds="True"
                                                        Background="{StaticResource InputBrush}">
                                                    <Grid>
                                                        <TextBlock Text="&#xE909;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <controls:AsyncImage SourceUrl="{Binding MediaViewModel.ViewerWorldThumbnailUrl}"
                                                                             DecodeWidth="152"
                                                                             CornerRadius="9" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MediaViewModel.ViewerWorldName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="36" />
                                                    <TextBlock Text="{Binding MediaViewModel.ViewerWorldAuthorText}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MediaViewModel.ViewerWorldFolderName, StringFormat='Folder: {0}'}"
                                                               FontSize="9.5"
                                                               Foreground="{StaticResource DimBrush}"
                                                               Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <!-- Public / Friends / group access, kept apart from the
                                             group row so a public session still says Public. -->
                                        <Border Margin="0,10,0,0"
                                                Padding="9,4"
                                                CornerRadius="8"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource InputBrush}"
                                                Visibility="{Binding MediaViewModel.ViewerShowsAccessChip, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding MediaViewModel.ViewerAccessLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </Border>

                                        <!-- Group instances name the group and open its popup. -->
                                        <Button Style="{StaticResource GhostButton}"
                                                Padding="2,2,8,2"
                                                Margin="0,8,0,2"
                                                MinHeight="36"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                IsEnabled="{Binding MediaViewModel.CanOpenViewerGroup}"
                                                ToolTip="Open this group"
                                                Visibility="{Binding MediaViewModel.ViewerHasGroup, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding OpenMediaGroupCommand}"
                                                CommandParameter="{Binding MediaViewModel.ViewerContext}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26"
                                                        Height="26"
                                                        CornerRadius="13"
                                                        ClipToBounds="True"
                                                        Background="{StaticResource InputBrush}">
                                                    <Grid>
                                                        <TextBlock Text="&#xE902;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <controls:AsyncImage SourceUrl="{Binding MediaViewModel.ViewerGroupIconUrl}"
                                                                             DecodeWidth="96"
                                                                             CornerRadius="13" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MediaViewModel.ViewerAccessLabel}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource DimBrush}" />
                                                    <TextBlock Text="{Binding MediaViewModel.ViewerGroupName}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ChipButton}"
                                                Content="Only pictures from this world"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding MediaViewModel.CanFilterByViewerWorld, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding MediaViewModel.ShowWorldFilterCommand}"
                                                CommandParameter="{Binding MediaViewModel.ViewerContext}" />

                                        <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,12,0,10" />

                                        <TextBlock Text="{Binding MediaViewModel.ViewerSessionTitle}"
                                                   Style="{StaticResource FieldLabel}"
                                                   Visibility="{Binding MediaViewModel.HasViewerContext, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding MediaViewModel.ViewerSessionText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding MediaViewModel.HasViewerContext, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource ChipButton}"
                                                Content="View this session"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Visibility="{Binding MediaViewModel.CanOpenViewerSession, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding OpenMediaSessionCommand}"
                                                CommandParameter="{Binding MediaViewModel.ViewerContext}" />
                                        <TextBlock Text="{Binding MediaViewModel.ViewerContextNote}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding MediaViewModel.ViewerShowsNoContext, Converter={StaticResource BoolToVis}}" />
                                        <!-- The picture itself carried VRChat/VRCX metadata. -->
                                        <TextBlock Text="{Binding MediaViewModel.ViewerContextNote}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding MediaViewModel.ViewerShowsPhotoNote, Converter={StaticResource BoolToVis}}" />

                                        <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,12,0,10" />

                                        <Grid Visibility="{Binding MediaViewModel.HasViewerContext, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="WHO WAS THERE" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="{Binding MediaViewModel.ViewerPeopleCountText}"
                                                       FontSize="9.5"
                                                       Foreground="{StaticResource DimBrush}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding MediaViewModel.ViewerShowsPeopleCount, Converter={StaticResource BoolToVis}}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding MediaViewModel.ViewerPeople}"
                                                      Visibility="{Binding MediaViewModel.HasViewerPeople, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0"
                                                                Padding="6"
                                                                HorizontalContentAlignment="Left"
                                                                Cursor="Hand"
                                                                ToolTip="Open profile"
                                                                Command="{Binding DataContext.OpenMediaPersonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding HasUserId}">
                                                            <Button.Style>
                                                                <!-- A name VRCX saved without an id cannot open a
                                                                     profile, but it must not look greyed out. -->
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="30" Height="30"
                                                                        CornerRadius="15"
                                                                        ClipToBounds="True"
                                                                        Background="{StaticResource InputBrush}">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding Initial}"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                             DecodeWidth="96"
                                                                                             CornerRadius="15" />
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayNameText}"
                                                                           FontSize="11.5"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="9,0,0,0"
                                                                           MaxWidth="150"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Style="{StaticResource GhostButton}"
                                                                Padding="6"
                                                                VerticalAlignment="Center"
                                                                Cursor="Hand"
                                                                ToolTip="Show pictures with this person"
                                                                Command="{Binding DataContext.MediaViewModel.ShowPersonFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE71C;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding MediaViewModel.ViewerNoPlayersText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding MediaViewModel.ViewerShowsNoPlayers, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChatboxTemplate">
            <DataTemplate.Resources>
                <Style x:Key="ChatboxTabButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
                    <Setter Property="Padding" Value="18,8" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource KawaiiMutedBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <Style x:Key="KawaiiPanel" TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Background" Value="{DynamicResource KawaiiPanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource KawaiiBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Padding" Value="16" />
                </Style>
                <Style x:Key="KawaiiSubPanel" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource KawaiiListBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource KawaiiBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="12" />
                </Style>
                <Style x:Key="KawaiiChip" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource KawaiiChipBrush}" />
                    <Setter Property="CornerRadius" Value="999" />
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="KawaiiMuted" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Foreground" Value="{DynamicResource KawaiiMutedBrush}" />
                </Style>
                <Style x:Key="KawaiiListRow" TargetType="Border" BasedOn="{StaticResource ListRow}">
                    <Setter Property="Background" Value="{DynamicResource KawaiiListBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource KawaiiBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="10" />
                    <Setter Property="Padding" Value="10" />
                </Style>
            </DataTemplate.Resources>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource KawaiiShellBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="292" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Background="{DynamicResource KawaiiHeaderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="KawaiiChatbox"
                                               Foreground="White"
                                               FontSize="19"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ChatboxViewModel.KawaiiEmoji}"
                                               FontFamily="Segoe UI Emoji"
                                               FontSize="17"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource KawaiiTabStripBrush}"
                                        CornerRadius="9"
                                        Padding="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Status"
                                                Command="{Binding ChatboxViewModel.ShowStatusPageCommand}"
                                                Click="ChatboxTab_Click"
                                                AutomationProperties.AutomationId="ChatboxStatusPageButton"
                                                Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChatboxTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChatboxViewModel.IsStatusPage}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource KawaiiAccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Chatting"
                                                Command="{Binding ChatboxViewModel.ShowChattingPageCommand}"
                                                Click="ChatboxTab_Click"
                                                AutomationProperties.AutomationId="ChatboxChattingPageButton"
                                                Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChatboxTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChatboxViewModel.IsChattingPage}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource KawaiiAccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Integrations"
                                                Command="{Binding ChatboxViewModel.ShowIntegrationsPageCommand}"
                                                Click="ChatboxTab_Click"
                                                AutomationProperties.AutomationId="ChatboxIntegrationsPageButton"
                                                Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChatboxTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChatboxViewModel.IsIntegrationsPage}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource KawaiiAccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Options"
                                                Command="{Binding ChatboxViewModel.ShowOptionsPageCommand}"
                                                Click="ChatboxTab_Click"
                                                AutomationProperties.AutomationId="ChatboxOptionsPageButton">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ChatboxTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChatboxViewModel.IsOptionsPage}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource KawaiiAccentBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Border Background="{DynamicResource KawaiiAccentSoftBrush}"
                                            BorderBrush="{DynamicResource KawaiiAccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="8,3"
                                            HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ChatboxViewModel.ChatboxDisplayTag}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource KawaiiHeaderTextBrush}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <CheckBox Content="Send to VRChat"
                                                  IsChecked="{Binding ChatboxViewModel.OscEnabled, Mode=TwoWay}"
                                                  Style="{StaticResource FriendlyCheckBox}"
                                                  AutomationProperties.AutomationId="ChatboxOscEnabledCheckBox" />
                                        <Border Style="{StaticResource KawaiiChip}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding ChatboxViewModel.OscStatusText}"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource KawaiiMutedBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource KawaiiChip}" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ChatboxViewModel.OutputModeText}"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource KawaiiMutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
<!-- STATUS PAGE -->
                        <StackPanel Visibility="{Binding ChatboxViewModel.IsStatusPage, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Status groups" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Only groups switched on for cycling join the rotation. Selecting a group filters the library; manual statuses outside the cycle stay put."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChatboxViewModel.SelectedGroupText}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding ChatboxViewModel.NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="40"
                                                 ToolTip="Name a new status group." />
                                        <Button Grid.Column="1"
                                                Content="+ Group"
                                                Command="{Binding ChatboxViewModel.AddStatusGroupCommand}"
                                                Style="{StaticResource SmallButton}"
                                                Margin="6,0,0,0" />
                                    </Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="All"
                                                Command="{Binding ChatboxViewModel.ShowAllStatusesCommand}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,5"
                                                Margin="0,0,5,5" />
                                        <ItemsControl ItemsSource="{Binding ChatboxViewModel.StatusGroups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="7,3"
                                                            Margin="0,0,5,5">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource InputBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="{Binding DisplayName}"
                                                                    Command="{Binding DataContext.ChatboxViewModel.SelectStatusGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Padding="4,2" />
                                                            <Button Content="{Binding CycleText}"
                                                                    Command="{Binding DataContext.ChatboxViewModel.ToggleStatusGroupCycleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    FontSize="9"
                                                                    Padding="5,2"
                                                                    Margin="2,0" />
                                                            <Button Content="×"
                                                                    Command="{Binding DataContext.ChatboxViewModel.DeleteStatusGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Padding="6,2" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>

                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Status library" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="A saved status is not a chat message. Only statuses marked for cycling are used by the automatic display."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChatboxViewModel.StatusCountText}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top" />
                                    </Grid>

                                                                                <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding ChatboxViewModel.NewStatusText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="144"
                                             AcceptsReturn="False"
                                             Margin="0,14,0,0"
                                             AutomationProperties.AutomationId="ChatboxNewStatusBox"
                                             ToolTip="A saved status line. This is separate from Chatting." />
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock Text="{Binding ChatboxViewModel.NewStatusCountText}"
                                                   Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center" />
                                        <Button Content="+ Add status"
                                                Command="{Binding ChatboxViewModel.AddStatusCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                HorizontalAlignment="Right"
                                                Padding="14,7"
                                                AutomationProperties.AutomationId="ChatboxAddStatusButton" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Select visible"
                                                    Command="{Binding ChatboxViewModel.SelectAllVisibleStatusesCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,4"
                                                    Margin="0,0,5,0" />
                                            <Button Content="Clear selection"
                                                    Command="{Binding ChatboxViewModel.ClearStatusSelectionCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,4"
                                                    Margin="0,0,5,0" />
                                            <Button Content="Delete selected"
                                                    Command="{Binding ChatboxViewModel.DeleteSelectedStatusesCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="8,4" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChatboxViewModel.SelectedStatusCountText}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="No statuses saved yet. Add one above to start the automatic line."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0"
                                               Visibility="{Binding ChatboxViewModel.HasNoStatusItems, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="No statuses in this group. Switch to All or add one with this group selected."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,14,0,0"
                                               Visibility="{Binding ChatboxViewModel.HasNoFilteredStatuses, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding ChatboxViewModel.FilteredStatusItems}"
                                                  Margin="0,14,0,0"
                                                  AutomationProperties.AutomationId="ChatboxStatusList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KawaiiListRow}" Margin="0,0,0,7">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                      Command="{Binding DataContext.ChatboxViewModel.ToggleStatusSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"
                                                                      Style="{StaticResource FriendlyCheckBox}"
                                                                      VerticalAlignment="Top"
                                                                      Margin="0,3,8,0" />
                                                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding DisplayText}"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                    <TextBlock Text="{Binding StatusPowerText}"
                                                                               Style="{StaticResource MutedText}"
                                                                               Margin="0,0,10,0" />
                                                                    <TextBlock Text="{Binding CycleText}"
                                                                               Style="{StaticResource MutedText}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Button Content="↑"
                                                                        Command="{Binding DataContext.ChatboxViewModel.MoveStatusUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        ToolTip="Move this status earlier"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="↓"
                                                                        Command="{Binding DataContext.ChatboxViewModel.MoveStatusDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        ToolTip="Move this status later"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="Use"
                                                                        Command="{Binding DataContext.ChatboxViewModel.UseStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="Cycle"
                                                                        Command="{Binding DataContext.ChatboxViewModel.ToggleStatusCycleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="Edit"
                                                                        Command="{Binding DataContext.ChatboxViewModel.EditStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="Group"
                                                                        Command="{Binding DataContext.ChatboxViewModel.AssignStatusToSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        ToolTip="Move this status into the selected group"
                                                                        Margin="0,0,2,0" />
                                                                <Button Content="×"
                                                                        Command="{Binding DataContext.ChatboxViewModel.RemoveStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}"
                                                                        Padding="8,5" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Margin="0,9,0,0">
                                                            <TextBox Style="{StaticResource InputBox}"
                                                                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                     MaxLength="144" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <Button Content="Save"
                                                                        Command="{Binding DataContext.ChatboxViewModel.SaveStatusEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource SmallButton}"
                                                                        Margin="0,0,5,0" />
                                                                <Button Content="Cancel"
                                                                        Command="{Binding DataContext.ChatboxViewModel.CancelStatusEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource GhostButton}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Status cycle" Style="{StaticResource SectionTitle}" />
                                        <Button Content="Next status"
                                                Command="{Binding ChatboxViewModel.CycleStatusNowCommand}"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="Favourites marked for cycle rotate every interval. Statuses not marked stay manual."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />
                                    <CheckBox Content="Cycle automatic status"
                                              IsChecked="{Binding ChatboxViewModel.CycleStatus}"
                                              Style="{StaticResource FriendlyCheckBox}"
                                              AutomationProperties.AutomationId="ChatboxCycleStatusCheckBox" />
                                    <Grid Margin="0,10,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Change every" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.CycleSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="54"
                                                     Margin="8,0"
                                                     TextAlignment="Center"
                                                     AutomationProperties.AutomationId="ChatboxCycleSecondsBox" />
                                            <TextBlock Text="seconds" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Content="Random order"
                                                  IsChecked="{Binding ChatboxViewModel.RandomStatusOrder}"
                                                  Style="{StaticResource FriendlyCheckBox}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding ChatboxViewModel.StatusModeText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}">
                                <StackPanel>
                                    <TextBlock Text="Status display" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Choose what is allowed in the composed line. VRChat only shows one chatbox line. The Integrations page controls the order in which these parts are joined."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />
                                    <CheckBox Content="Include the active status"
                                              IsChecked="{Binding ChatboxViewModel.IncludeStatus}"
                                              Style="{StaticResource FriendlyCheckBox}" />
                                    <CheckBox Content="Show the status icon"
                                              IsChecked="{Binding ChatboxViewModel.ShowStatusIcon}"
                                              Style="{StaticResource FriendlyCheckBox}"
                                              Margin="0,8,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Icon" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Text="{Binding ChatboxViewModel.StatusIcon, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="74"
                                                 HorizontalAlignment="Right"
                                                 TextAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- CHATTING PAGE -->
                        <StackPanel Visibility="{Binding ChatboxViewModel.IsChattingPage, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Chatting" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Type as yourself. Nothing is sent to VRChat while you type; Send temporarily takes over the same chatbox, then automatic Status returns."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Background="{StaticResource AccentSoftBrush}"
                                                CornerRadius="999"
                                                Padding="10,4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="KAWAII CHAT"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                    </Grid>

                                    <!--  Status strip: feedback on the left, the live countdown on the right.  -->
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="10,7"
                                            Margin="0,14,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding ChatboxViewModel.ChatFeedback}"
                                                       Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,120,0" />
                                            <TextBlock Text="{Binding ChatboxViewModel.ChatCountdownText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!--  One composer shell, like Magic's LIVE chip + input + count + Send.  -->
                                    <Border Background="{StaticResource InputBrush}"
                                            BorderBrush="{StaticResource AccentSoftBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="8"
                                            Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Content="LIVE"
                                                      IsChecked="{Binding ChatboxViewModel.LiveTyping}"
                                                      Style="{StaticResource FriendlyCheckBox}"
                                                      FontSize="9"
                                                      FontWeight="Bold"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0,8,0"
                                                      AutomationProperties.AutomationId="ChatboxLiveTypingCheckBox"
                                                      ToolTip="Only this option sends live drafts while typing. With it off, typing stays local until Send and never opens VRChat's chatbox." />
                                            <Grid Grid.Column="1">
                                                <TextBox x:Name="ChatboxMessageBox"
                                                         Style="{StaticResource InputBox}"
                                                         Text="{Binding ChatboxViewModel.ChatText, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="144"
                                                         AcceptsReturn="False"
                                                         MinHeight="56"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Center"
                                                         KeyDown="ChatboxMessageBox_KeyDown"
                                                         AutomationProperties.AutomationId="ChatboxMessageBox"
                                                         ToolTip="This is a chat message. It is not saved as a status. Enter sends; Tab accepts autocomplete." />
                                                <TextBlock Text="Send a chat message"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=ChatboxMessageBox}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ChatboxViewModel.ChatCountText}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0" />
                                            <Button Grid.Column="3"
                                                    Content="Send"
                                                    Command="{Binding ChatboxViewModel.SendChatCommand}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="18,7"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AutomationId="ChatboxSendButton" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <TextBlock Text="QUICK EMOJI"
                                                   Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <ItemsControl ItemsSource="{Binding ChatboxViewModel.EmojiChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}"
                                                            Command="{Binding DataContext.ChatboxViewModel.InsertChatEmojiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"
                                                            FontSize="15"
                                                            Padding="8,2"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Add this emoji to the message" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="7"
                                            Padding="9,6"
                                            Margin="0,7,0,0"
                                            Visibility="{Binding ChatboxViewModel.HasAutocompleteSuffix, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="TAB"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ChatboxViewModel.AutocompleteDisplay}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ChatboxViewModel.DraftPreviewText}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,190,0" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Stop / clear"
                                                    Command="{Binding ChatboxViewModel.StopChatCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    AutomationProperties.AutomationId="ChatboxStopChatButton"
                                                    Margin="0,0,6,0" />
                                            <Button Content="Clear history"
                                                    Command="{Binding ChatboxViewModel.ClearChatHistoryCommand}"
                                                    Style="{StaticResource GhostButton}"
                                                    AutomationProperties.AutomationId="ChatboxClearChatHistoryButton" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Enter sends · Tab accepts autocomplete · draft updates are silent until finalized"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}">
                                <StackPanel>
                                    <TextBlock Text="Chat history" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="The last five messages. Resend one or edit the message that is currently showing."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />
                                    <TextBlock Text="No chat messages yet."
                                               Style="{StaticResource MutedText}"
                                               Visibility="{Binding ChatboxViewModel.HasNoChatHistory, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding ChatboxViewModel.ChatHistory}"
                                                  AutomationProperties.AutomationId="ChatboxChatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource KawaiiListRow}"
                                                        Margin="0,0,0,7"
                                                        Opacity="{Binding Opacity}">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                                <TextBlock Text="{Binding DisplayText}"
