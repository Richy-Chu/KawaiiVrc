                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,5" FontSize="10.5" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Content="Kick from group"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,5" FontSize="10.5" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.KickCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Content="Ban from group"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,5" FontSize="10.5" Margin="0,0,6,6"
                                                            Command="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.BanCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>

                                                <TextBlock Text="ROLES" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
