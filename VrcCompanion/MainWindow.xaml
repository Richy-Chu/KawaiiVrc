<Window x:Class="VrcCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:VrcCompanion.Controls"
        xmlns:behaviors="clr-namespace:VrcCompanion.Behaviors"
        xmlns:converters="clr-namespace:VrcCompanion.Converters"
        xmlns:m="clr-namespace:VrcCompanion.Models"
        xmlns:sys="clr-namespace:System"
        mc:Ignorable="d"
        d:DesignWidth="1440" d:DesignHeight="900"
        Title="KawaiiVrc"
        Icon="Assets/app-icon.png"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MediaTemplates.xaml" />
                <ResourceDictionary Source="Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="KawaiiAccentBrush" Color="#5A3796" />
            <SolidColorBrush x:Key="KawaiiAccentSoftBrush" Color="#2A1750" />
            <SolidColorBrush x:Key="KawaiiHeaderStartBrush" Color="#45237A" />
            <SolidColorBrush x:Key="KawaiiHeaderEndBrush" Color="#1B0F30" />
            <SolidColorBrush x:Key="KawaiiHeaderTextBrush" Color="#D3C4F2" />
            <SolidColorBrush x:Key="KawaiiPanelBrush" Color="#B31B1131" />
            <SolidColorBrush x:Key="KawaiiBorderBrush" Color="#352457" />
            <SolidColorBrush x:Key="KawaiiChipBrush" Color="#B32A1A47" />
            <SolidColorBrush x:Key="KawaiiMutedBrush" Color="#B4A4D6" />
            <SolidColorBrush x:Key="KawaiiShellBrush" Color="#B3120A22" />
            <SolidColorBrush x:Key="KawaiiTabStripBrush" Color="#B31A0F2E" />
            <SolidColorBrush x:Key="KawaiiListBrush" Color="#B3150D27" />
            <LinearGradientBrush x:Key="KawaiiHeaderBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#45237A" Offset="0" />
                <GradientStop Color="#24123F" Offset="0.62" />
                <GradientStop Color="#1B0F30" Offset="1" />
            </LinearGradientBrush>

        <!-- ========================================================= -->
        <!-- Kawaii profile surfaces                                    -->
        <!-- ========================================================= -->
        <Style x:Key="KawaiiCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Background" Value="{StaticResource KawaiiPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KawaiiBorderBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#5B3D7E" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KawaiiStatCard" TargetType="Border">
            <Setter Property="Background" Value="#CC1C1433" />
            <Setter Property="BorderBrush" Value="#3A2850" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,10" />
            <Setter Property="MinWidth" Value="190" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#694A91" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KawaiiSectionLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Foreground" Value="{StaticResource PinkBrush}" />
        </Style>

        <Style x:Key="KawaiiActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource KawaiiPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KawaiiBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KawaiiMutedBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>

        <!-- ========================================================= -->
        <!-- Small reusable pieces                                     -->
        <!-- ========================================================= -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="TagChip" TargetType="Border">
            <Setter Property="Background" Value="#C41E1738" />
            <Setter Property="BorderBrush" Value="#42305F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Shared content-tag chips for every avatar card and detail popup. -->
        <DataTemplate x:Key="AvatarTagChips">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TagChip}"
                                Padding="6,2"
                                Margin="0,0,4,4">
                            <TextBlock Text="{Binding}"
                                       Style="{StaticResource TagText}"
                                       FontSize="9"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- VRChat refuses to load avatars whose server-side checks failed. -->
        <DataTemplate x:Key="SecurityFailedChip">
            <Border Background="#E6080C10"
                    BorderBrush="#2E6E55"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/security-check-failed.png"
                           Width="14"
                           Height="14"
                           Margin="0,0,4,0" />
                    <TextBlock Text="SECURITY FAILED"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="#F4F7F5"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ErrorBannerPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ErrorBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
        </Style>

        <Style x:Key="InfoBannerPanel" TargetType="Border">
            <Setter Property="Background" Value="#13251F" />
            <Setter Property="BorderBrush" Value="#24543F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,9" />
        </Style>

        <Style x:Key="BareListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BareListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource BareListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>

        <Style x:Key="FriendListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="9"
                                Padding="9,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#241B39" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendListBox" TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
            <Setter Property="Padding" Value="0,0,4,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource FriendListItem}" />
            <!-- Only the rows in view are ever built, for any list size. -->
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.CacheLength" Value="1" />
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        </Style>

        <Style x:Key="WorldListBox" TargetType="ListBox" BasedOn="{StaticResource BareListBox}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <!-- A catalog page is long enough to scroll, and the panel
                             keeps only the rows near the viewport built. 334 is the
                             row height these cards actually measure. -->
                        <controls:VirtualizingWrapPanel ItemWidth="274"
                                                        EstimatedItemHeight="334"
                                                        CacheViewports="0.75" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,12,12" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorldCardButton" TargetType="Button">
            <Setter Property="Width" Value="262" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource PanelAltBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EmptyStateCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="30,26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="380" />
        </Style>

        <Style x:Key="BrowserFocusToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Content" Value="Focus browser" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Hide the search controls and give this browser the whole pane." />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Exit focus" />
                    <Setter Property="Foreground" Value="#0B0D12" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChoiceListItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChoiceBorder"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="#5B3D7E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChoiceListItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="RegionPillStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PillBorder"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#5B3D7E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RegionPillList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource RegionPillStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================================================= -->
        <!-- Content section templates                                 -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="ProfileTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,2,12,12">
                <StackPanel>

                    <!-- Identity card -->
                    <Border Style="{StaticResource KawaiiCard}" Padding="0" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="148" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border CornerRadius="14,14,0,0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6B2D5F" Offset="0" />
                                        <GradientStop Color="#40245F" Offset="0.52" />
                                        <GradientStop Color="#1E1235" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" Opacity="0.45" />
                                    <controls:CosmeticImage SourceUrl="{Binding ProfileEffectUrl}"
                                                            IntroUrl="{Binding ProfileEffectIntroUrl}"
                                                            DecodeWidth="900"
                                                            Opacity="0.7"
                                                            Visibility="{Binding HasProfileEffect, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="♡"
                                               FontSize="46"
                                               Foreground="#80F472B6"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Margin="0,12,26,0" />
                                    <TextBlock Text="✧"
                                               FontSize="20"
                                               Foreground="#A0C084FC"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,72,24" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,-42,24,22">
                                <Grid Width="92" Height="92" Margin="0,0,18,0">
                                    <Ellipse Fill="{StaticResource InputBrush}"
                                             Stroke="{StaticResource AccentGradientPink}"
                                             StrokeThickness="3" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarImage}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding AvatarInitial}"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                            IntroUrl="{Binding IconFrameIntroUrl}"
                                                            DecodeWidth="192"
                                                            Width="118"
                                                            Height="118"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
                                    <TextBlock FontSize="27"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding TrustBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                        <Run Text="  ♡"
                                             FontSize="18"
                                             Foreground="{StaticResource PinkBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsernameHandle}"
                                               Style="{StaticResource MutedText}"
                                               Foreground="{Binding ProfileSubtextBrush}"
                                               Margin="0,2,0,0" />

                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource TagChip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding StatusBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding ProfileStatusLabel}"
                                                           Style="{StaticResource TagText}"
                                                           Foreground="{Binding StatusBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource TagChip}" BorderBrush="{Binding TrustBrush}">
                                            <TextBlock Text="{Binding TrustLabel}" Style="{StaticResource TagText}"
                                                       Foreground="{Binding TrustBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsVrcPlus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="VRC+" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding IsAgeVerified, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Age verified" Style="{StaticResource TagText}" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource TagChip}"
                                                Visibility="{Binding HasPronouns, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PronounsText}" Style="{StaticResource TagText}" />
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding ProfileStatusDescription}"
                                               MaxWidth="520"
                                               Margin="0,9,0,0"
                                               FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasProfileStatusDescription, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- At a glance -->
                    <Border Style="{StaticResource KawaiiCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="AT A GLANCE  ♡" Style="{StaticResource KawaiiSectionLabel}" />
                            <WrapPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource KawaiiStatCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="8"
                                                    Background="#38F472B6">
                                                <TextBlock Text="&#xE716;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource PinkBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="FRIENDS"
                                                       Style="{StaticResource KawaiiSectionLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="7,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding FriendsSummary}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFD8EA"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KawaiiStatCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="8"
                                                    Background="#388B5CF6">
                                                <TextBlock Text="&#xE7ED;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource VioletBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="NOTIFICATIONS"
                                                       Style="{StaticResource KawaiiSectionLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="7,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding NotificationsSummary}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#DCCBFF"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource KawaiiStatCard}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="24" Height="24"
                                                    CornerRadius="8"
                                                    Background="#3860A5FA">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="{StaticResource BlueBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="ON VRCHAT SINCE"
                                                       Style="{StaticResource KawaiiSectionLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="7,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding JoinedText}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C9E2FF"
                                                   Margin="0,7,0,0" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Style="{StaticResource KawaiiActionButton}"
                                        Margin="0,0,8,0"
                                        Content="♡  Mark notifications read"
                                        Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding MarkAllReadCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Creator tools: only rendered when signed in as the creator -->
                    <Border Style="{StaticResource KawaiiCard}"
                            Visibility="{Binding IsCreatorAccount, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="CREATOR TOOLS  ♡" Style="{StaticResource KawaiiSectionLabel}" />
                            <TextBlock Text="Only your account can see this. Turning it on unlocks the profile location injector used to test Join."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource KawaiiActionButton}"
                                        Command="{Binding ToggleDevToolsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="♡"
                                                   Foreground="{StaticResource PinkBrush}"
                                                   Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding DevToolsButtonText}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="On: the DEV button appears in profile popups."
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Friends: list + profile detail                            -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="FriendsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Width="290">
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding FriendFilter, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search by name or username"
                                   Margin="13,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FriendFilter}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                  Content="Online only"
                                  IsChecked="{Binding ShowOnlineOnly}"
                                  VerticalAlignment="Center" />
                        <Button Content="Friend changes"
                                Style="{StaticResource SecondaryButton}"
                                Padding="10,5"
                                FontSize="10.5"
                                Margin="14,0,0,0"
                                Command="{Binding OpenFriendChangesCommand}"
                                ToolTip="Friended and unfriended events seen since the last refresh" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Grid.ColumnSpan="3"
                             ItemsSource="{Binding FriendFilters}"
                             SelectedItem="{Binding SelectedFriendFilter, Mode=TwoWay}"
                             Style="{StaticResource RegionPillList}"
                             Margin="0,8,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="8"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding FriendsSummary}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <!-- Friend list -->
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0"
                                     Style="{StaticResource FriendListBox}"
                                     ItemsSource="{Binding FriendsPage.Items}"
                                     SelectedItem="{Binding SelectedFriend, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="42" Height="42" Margin="0,0,11,0">
                                                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarUrl}"
                                                                    Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AvatarUrl}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding AvatarUrl, Converter={StaticResource StringEmptyToVis}}" />
                                                <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                        IntroUrl="{Binding IconFrameIntroUrl}"
                                                                        DecodeWidth="128"
                                                                        Width="54"
                                                                        Height="54"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                                <Ellipse Width="11" Height="11"
                                                         Fill="{Binding StatusDotBrush}"
                                                         Stroke="{StaticResource PanelBrush}"
                                                         StrokeThickness="2"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Bottom"
                                                         Margin="0,0,-1,-1" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TrustBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SubText}"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding TrustLabel}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TrustBrush}"
                                                               Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding LocationText}"
                                                               FontSize="9.5"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,0,0">
                                                <Border Background="{StaticResource InputBrush}"
                                                        CornerRadius="8"
                                                        Padding="7,2"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding StatusBrush}" />
                                                </Border>
                                                <Button Style="{StaticResource GhostButton}"
                                                        Content="Join"
                                                        Padding="8,2"
                                                        FontSize="9.5"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.JoinFriendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsJoinable, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding ActivityText}"
                                                           FontSize="8.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding HasNoVisibleFriends, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xE716;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="24"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FriendsEmptyMessage}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               Margin="0,10,0,0"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <controls:ListPager Grid.Row="1"
                                                DataContext="{Binding FriendsPage}"
                                                Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                </Grid>

                <!-- Launch mode bar -->
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="LAUNCH AS"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="LaunchMode"
                                         Content="Desktop"
                                         Foreground="{StaticResource TextBrush}"
                                         IsChecked="{Binding IsDesktopDefault, Mode=TwoWay}"
                                         Margin="0,0,14,0" />
                            <RadioButton GroupName="LaunchMode"
                                         Content="VR"
                                         Foreground="{StaticResource TextBrush}"
                                         IsChecked="{Binding IsVrDefault, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding LaunchDefaultText}"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Margin="18,0,12,0"
                                   TextTrimming="CharacterEllipsis" />

                        <Button Grid.Column="3"
                                Style="{StaticResource PrimaryButton}"
                                Content="REJOIN WORLD"
                                Padding="22,8"
                                FontSize="12"
                                FontWeight="Bold"
                                Height="36"
                                MinWidth="150"
                                Margin="0,0,7,0"
                                Command="{Binding RejoinWorldCommand}"
                                ToolTip="Rejoin the most recent VRChat instance. VRChat restarts automatically when needed.">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.84">
                                    <GradientStop Color="#8B5CF6" Offset="0" />
                                    <GradientStop Color="#3B82F6" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button Grid.Column="4"
                                Style="{StaticResource GhostButton}"
                                Content="Advanced"
                                Padding="10,6"
                                FontSize="11"
                                Margin="0,0,7,0"
                                Command="{Binding OpenAdvancedLaunchCommand}"
                                ToolTip="Create and select named VRChat launch-argument profiles" />

                        <Button Grid.Column="5"
                                Style="{StaticResource SecondaryButton}"
                                Content="Open VRChat"
                                Padding="12,6"
                                FontSize="11"
                                Command="{Binding OpenVrChatCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Notifications                                             -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="NotificationsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding NotificationsSummary}"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallButton}"
                                Content="Mark all read"
                                Margin="0,0,6,0"
                                Command="{Binding MarkAllReadCommand}"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource SmallButton}"
                                Content="Clear all"
                                ToolTip="Clear every notification from your list"
                                Command="{Binding ClearAllNotificationsCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Clearing asks once: the cleared ids do not come back. -->
                    <Border Grid.Row="0"
                            Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsClearConfirmationOpen, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ClearConfirmationText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0">
                                <Button Style="{StaticResource SmallButton}"
                                        Content="Cancel"
                                        Margin="0,0,6,0"
                                        Command="{Binding CancelClearConfirmationCommand}" />
                                <Button Style="{StaticResource SmallButton}"
                                        Content="Clear"
                                        Command="{Binding ConfirmClearConfirmationCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notification filters -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding NotificationFilters}"
                             SelectedItem="{Binding SelectedNotificationFilter, Mode=TwoWay}"
                             Style="{StaticResource RegionPillList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBrush}"
                                        CornerRadius="8"
                                        Padding="10,6">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                        <!-- These act on the selected filter only. -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0">
                            <Button Style="{StaticResource SmallButton}"
                                    Content="Mark these read"
                                    Margin="0,0,6,0"
                                    ToolTip="Mark every notification in this filter as read"
                                    Command="{Binding MarkFilteredNotificationsReadCommand}"
                                    Visibility="{Binding HasUnreadVisibleNotifications, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource SmallButton}"
                                    Content="Clear these"
                                    ToolTip="Clear every notification in this filter from your list"
                                    Command="{Binding ClearFilteredNotificationsCommand}"
                                    Visibility="{Binding HasVisibleNotifications, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Notification list + detail -->
                    <Grid Grid.Row="2">

                    <!-- Notification list -->
                    <Border
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SoftBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox Grid.Row="0"
                                     Style="{StaticResource BareListBox}"
                                     ItemsSource="{Binding NotificationsPage.Items}"
                                     SelectedItem="{Binding SelectedNotification, Mode=TwoWay}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListRow}" Background="{Binding RowBackground}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="3"
                                                        Background="{Binding TypeBrush}"
                                                        CornerRadius="2"
                                                        Margin="0,1,12,1"
                                                        Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />

                                                <Border Grid.Column="1"
                                                        Background="{StaticResource InputBrush}"
                                                        BorderBrush="{Binding TypeBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="7,4"
                                                        Width="60"
                                                        Height="42"
                                                        VerticalAlignment="Top"
                                                        Margin="0,0,13,0">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               FontSize="8.5"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding TypeBrush}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource GhostButton}"
                                                        Width="52"
                                                        Height="52"
                                                        Padding="0"
                                                        Margin="0,0,13,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Click to enlarge the boop attachment"
                                                        Command="{Binding DataContext.OpenBoopPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasBoopImage, Converter={StaticResource BoolToVis}}">
                                                    <Border Width="52"
                                                            Height="52"
                                                            CornerRadius="9"
                                                            ClipToBounds="True"
                                                            Background="{StaticResource InputBrush}">
                                                        <controls:AsyncImage SourceUrl="{Binding BoopImageUrl}"
                                                                             DecodeWidth="104"
                                                                             CornerRadius="9" />
                                                    </Border>
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Style="{StaticResource GhostButton}"
                                                        Width="52"
                                                        Height="52"
                                                        Padding="0"
                                                        Margin="0,0,13,0"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Open this group"
                                                        Command="{Binding DataContext.OpenNotificationGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding HasGroupImage, Converter={StaticResource BoolToVis}}">
                                                    <Border Width="52"
                                                            Height="52"
                                                            CornerRadius="9"
                                                            ClipToBounds="True"
                                                            Background="{StaticResource InputBrush}">
                                                        <controls:AsyncImage SourceUrl="{Binding GroupImageUrl}"
                                                                             DecodeWidth="104"
                                                                             CornerRadius="9" />
                                                    </Border>
                                                </Button>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding GroupName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding TypeBrush}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding GroupTitle}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding HasGroupTitle, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding MessageText}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SenderLine}"
                                                               Style="{StaticResource MutedText}"
                                                               Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding DetailsText}"
                                                               FontSize="10.5"
                                                               Foreground="{StaticResource DimBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>

                                                <WrapPanel Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"
                                                           HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Accept"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Accept this friend request"
                                                            Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanAcceptFriendRequest, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Accept"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Invite this person to your current instance"
                                                            Command="{Binding DataContext.AcceptInviteRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanAcceptInviteRequest, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Join"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Launch VRChat into this instance"
                                                            Command="{Binding DataContext.JoinInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanJoinInvite, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Decline"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Decline and remove this notification"
                                                            Command="{Binding DataContext.DeclineNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanDecline, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Accept group"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Join this group and open it"
                                                            Command="{Binding DataContext.AcceptGroupInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanAcceptGroupInvite, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Deny"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Decline this group invitation"
                                                            Command="{Binding DataContext.DeclineGroupInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding CanDeclineGroupInvite, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Mark read"
                                                            ToolTip="Mark this notification as read"
                                                            Command="{Binding DataContext.MarkNotificationSeenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />
                                                    <Button Style="{StaticResource SmallButton}"
                                                            Content="Clear"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Remove this notification from your list"
                                                            Command="{Binding DataContext.ClearNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Style="{StaticResource EmptyStateCard}"
                                    Visibility="{Binding HasNoVisibleNotifications, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="&#xEA8F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="26"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding NotificationsEmptyMessage}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,0"
                                               TextAlignment="Center" />
                                    <TextBlock Text="Invites, friend requests, and group updates will show up here."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,5,0,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <controls:ListPager Grid.Row="1"
                                                DataContext="{Binding NotificationsPage}"
                                                Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>

                    <!-- Notification detail popup -->
                    <Grid Visibility="{Binding HasSelectedNotification, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding ClearNotificationSelectionCommand}"
                                Focusable="False"
                                Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#C4060810" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Width="560"
                                MaxHeight="740"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20,18,18,22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          DataContext="{Binding NotificationDetail}">
                                <StackPanel Margin="0,0,0,0">
                                    <!-- This surface is intentionally distinct from the
                                         full profile card: it is the actionable
                                         notification, including friend requests. -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34"
                                                CornerRadius="17"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding NotificationKindGlyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Foreground="{Binding TypeBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="NOTIFICATION"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding NotificationKindText}"
                                                       FontSize="14.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource GhostButton}"
                                                Padding="7,4"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.ClearNotificationSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Close notification">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <!-- Group that sent this update, resolved by group id. -->
                                    <Border Visibility="{Binding HasGroup, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource KawaiiListBrush}"
                                            BorderBrush="{DynamicResource KawaiiBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="64" Height="64"
                                                    CornerRadius="10"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource InputBrush}"
                                                    Margin="0,0,12,0"
                                                    Visibility="{Binding HasGroupImage, Converter={StaticResource BoolToVis}}">
                                                <controls:AsyncImage SourceUrl="{Binding GroupImageUrl}"
                                                                     DecodeWidth="128"
                                                                     CornerRadius="10" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="GROUP"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding TypeBrush}" />
                                                <TextBlock Text="{Binding GroupName}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding GroupTitle}"
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Visibility="{Binding HasGroupTitle, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="You've been invited to join this group."
                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0"
                                                           Visibility="{Binding IsGroupInvite, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Content="Open group"
                                                    Height="36"
                                                    Padding="14,0"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    Command="{Binding DataContext.OpenNotificationGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Notification}"
                                                    Visibility="{Binding CanOpenGroup, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>

                                    <!-- Sender avatar + name -->
                                    <StackPanel Margin="0,0,0,14"
                                                Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}">
                                        <controls:CosmeticImage SourceUrl="{Binding ProfileEffectUrl}"
                                                                IntroUrl="{Binding ProfileEffectIntroUrl}"
                                                                DecodeWidth="600"
                                                                Height="72"
                                                                Opacity="0.3"
                                                             Margin="-12,-8,-12,0"
                                                             Visibility="{Binding HasProfileEffect, Converter={StaticResource BoolToVis}}" />
                                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                                            <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                            <TextBlock Text="&#xE77B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="30"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasSenderAvatar, Converter={StaticResource InverseBoolToVis}}" />
                                            <Ellipse Stroke="{StaticResource PanelBrush}"
                                                     StrokeThickness="2"
                                                     Visibility="{Binding HasSenderAvatar, Converter={StaticResource BoolToVis}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding SenderAvatarUrl}"
                                                                Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                    IntroUrl="{Binding IconFrameIntroUrl}"
                                                                    DecodeWidth="192"
                                                                    Width="96"
                                                                    Height="96"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"
                                                                 Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                        <TextBlock Text="{Binding SenderName}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TrustBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,10,0,2" />
                                        <TextBlock Text="{Binding SenderHandle}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SenderStatusLabel}"
                                                   FontSize="9.5"
                                                   Foreground="{Binding SenderStatusBrush}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0" />
                                        <Border Style="{StaticResource TagChip}"
                                                BorderBrush="{Binding TrustBrush}"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0">
                                            <TextBlock Text="{Binding TrustLabel}"
                                                       Style="{StaticResource TagText}"
                                                       Foreground="{Binding TrustBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Open full profile"
                                            Height="36"
                                            Margin="0,0,0,0"
                                            Command="{Binding DataContext.ShowSenderProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasSender, Converter={StaticResource BoolToVis}}" />

                                    <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,16,0,12" />

                                    <!-- Type & details -->
                                    <TextBlock Text="Details" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding TypeBrush}"
                                                 Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TypeLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TypeBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding MessageText}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Width="160"
                                            Height="160"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            Margin="0,10,0,0"
                                            ToolTip="Click to enlarge the boop attachment"
                                            Command="{Binding DataContext.OpenBoopPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding HasBoopImage, Converter={StaticResource BoolToVis}}">
                                        <Border Width="160"
                                                Height="160"
                                                CornerRadius="12"
                                                ClipToBounds="True"
                                                Background="{StaticResource InputBrush}">
                                            <controls:AsyncImage SourceUrl="{Binding BoopImageUrl}"
                                                                 DecodeWidth="320"
                                                                 CornerRadius="12" />
                                        </Border>
                                    </Button>
                                    <TextBlock Text="Click the emoji to enlarge it."
                                               Style="{StaticResource MutedText}"
                                               FontSize="10"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasBoopImage, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding DetailsText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasDetailsText, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ReceivedText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,8,0,0" />

                                    <Border Height="1" Background="{StaticResource SoftBorderBrush}" Margin="0,16,0,12" />

                                    <!-- The invited instance, before the accept/decline choice. -->
                                    <Border Visibility="{Binding HasWorld, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource KawaiiListBrush}"
                                            BorderBrush="{DynamicResource KawaiiBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="YOU'RE INVITED TO" Style="{StaticResource FieldLabel}" />
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="92" Height="62"
                                                        CornerRadius="8"
                                                        ClipToBounds="True"
                                                        Background="{DynamicResource KawaiiChipBrush}">
                                                    <controls:AsyncImage SourceUrl="{Binding WorldImageUrl}"
                                                                         DecodeWidth="184"
                                                                         CornerRadius="8" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorldName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding WorldAuthorText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding WorldMetaText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                <Button Content="Join world"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Height="36"
                                                        Padding="16,0"
                                                        Command="{Binding DataContext.JoinInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Notification}"
                                                        Visibility="{Binding CanJoinInvite, Converter={StaticResource BoolToVis}}" />
                                                <Button Content="Decline"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Height="36"
                                                        Padding="16,0"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.DeclineNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Notification}" />
                                                <Button Content="Decline with message"
                                                        Style="{StaticResource GhostButton}"
                                                        Height="36"
                                                        Padding="10,0"
                                                        Margin="6,0,0,0"
                                                        Command="{Binding DataContext.DeclineNotificationWithMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Notification}" />
                                            </StackPanel>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Content="Open world details"
                                                    Padding="0,4"
                                                    FontSize="10.5"
                                                    Margin="0,7,0,0"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.OpenNotificationWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions -->
                                    <TextBlock Text="Actions" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Accept friend request"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.AcceptFriendRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanAcceptFriendRequest, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Accept invite request"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.AcceptInviteRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanAcceptInviteRequest, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Accept group invite"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.AcceptGroupInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanAcceptGroupInvite, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Deny group invite"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.DeclineGroupInviteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanDeclineGroupInvite, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Decline"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.DeclineNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanDeclineNotification, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="Decline with a message"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.DeclineNotificationWithMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding CanDeclineNotification, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="{Binding UserLocationLine, StringFormat='Join their world ({0})'}"
                                            Height="40"
                                            Margin="0,0,0,8"
                                            Command="{Binding DataContext.JoinNotificationUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanJoinUser, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Mark as read"
                                            Height="40"
                                            Command="{Binding DataContext.MarkNotificationSeenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Notification}"
                                            Visibility="{Binding IsUnseen, Converter={StaticResource BoolToVis}}" />

                                 </StackPanel>
                             </ScrollViewer>
                         </Border>
                     </Grid>

                    <!-- Enlarged boop attachment -->
                    <Grid x:Name="BoopPreviewOverlay"
                          Panel.ZIndex="20"
                          Visibility="{Binding IsBoopPreviewOpen, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding CloseBoopPreviewCommand}"
                                Focusable="False"
                                Cursor="Arrow" controls:OverlayBackdropGuard.Protect="True"
                                ToolTip="Close boop attachment">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#F2070910" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Border Margin="28"
                                MaxWidth="760"
                                MaxHeight="820"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="18"
                                DataContext="{Binding BoopPreview}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="BOOP ATTACHMENT" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="{Binding BoopAttachmentTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding BoopKindText}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource GhostButton}"
                                            Padding="8,5"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.CloseBoopPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ToolTip="Close boop attachment">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1"
                                        Background="#0B0D12"
                                        BorderBrush="{StaticResource SoftBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        MinHeight="300">
                                    <controls:AsyncImage SourceUrl="{Binding BoopImageUrl}"
                                                         DecodeWidth="1600"
                                                         CornerRadius="12"
                                                         Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                 </Grid>
                 </Grid>
             </Grid>
         </DataTemplate>

        <!-- ========================================================= -->
        <!-- Worlds                                                    -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="WorldsTemplate">
            <Grid Margin="26,2,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,0">
                            <TextBlock Text="Search worlds" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,9,0,0">
                                <TextBox x:Name="WorldSearchBox"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding WorldQuery, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="WorldSearchBox_KeyDown" />
                                <TextBlock Text="Search the public VRChat world catalogâ€¦"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WorldQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock Text="Try"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="The Great Pug"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="The Great Pug" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="Black Cat"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="Black Cat" />
                                <Button Style="{StaticResource ChipButton}"
                                        Content="Midnight Rooftop"
                                        Command="{Binding SearchSuggestionCommand}"
                                        CommandParameter="Midnight Rooftop" />
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="Search"
                                Padding="20,9"
                                VerticalAlignment="Bottom"
                                Command="{Binding SearchWorldsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Style="{StaticResource Card}"
                        Padding="16,13"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Quick join an instance" Style="{StaticResource SectionTitle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Paste a vrchat:// launch link, vrch.at short link, full world:instance location, or instance ID."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,9" />
                            <Grid>
                                <TextBox x:Name="QuickJoinBox"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding QuickJoinInput, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="QuickJoinBox_KeyDown" />
                                <TextBlock Text="vrchat://launch?ref=vrchat.com&amp;id=wrld_â€¦:â€¦"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuickJoinInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Content="Join"
                                Padding="22,9"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom"
                                Command="{Binding QuickJoinCommand}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="{Binding WorldsSummary}"
                           Style="{StaticResource MutedText}"
                           Margin="0,0,0,9" />

                <Grid Grid.Row="3">
                    <ListBox Style="{StaticResource WorldListBox}"
                             ItemsSource="{Binding Worlds}"
                             behaviors:ScrollViewerBehavior.PageToken="{Binding WorldsPageToken}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource WorldCardButton}"
                                        ToolTip="Open world details, create or join an instance"
                                        Command="{Binding DataContext.OpenWorldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <Grid Height="132" Margin="0,0,0,9">
                                            <Border CornerRadius="10" Background="{StaticResource AccentGradient}" />
                                            <TextBlock Text="&#xE909;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="30"
                                                       Foreground="{StaticResource WhiteBrush}"
                                                       Opacity="0.55"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border CornerRadius="10">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#CC0B0D12"
                                                    CornerRadius="7"
                                                    Padding="7,3"
                                                    Margin="8">
                                                <TextBlock Text="{Binding PlatformsText}"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AuthorText}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding MetaText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource DimBrush}"
                                                   Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding TagsText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource VioletBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />

                                        <Grid Margin="0,10,0,0">
                                            <TextBlock Text="Open details"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentHoverBrush}" />
                                            <TextBlock Text="&#xE8A7;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource EmptyStateCard}"
                            Visibility="{Binding HasNoWorlds, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="&#xE909;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="26"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WorldsEmptyMessage}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="0,10,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,8"
                        Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Previous"
                                Padding="18,8"
                                Margin="0,0,10,0"
                                Command="{Binding PreviousWorldsPageCommand}"
                                IsEnabled="{Binding HasPreviousWorldsPage}" />
                        <TextBlock Text="{Binding WorldsPageText}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Next"
                                Padding="22,8"
                                Command="{Binding NextWorldsPageCommand}"
                                IsEnabled="{Binding HasNextWorldsPage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- Settings: backdrop, appearance, app preferences             -->
        <!-- ========================================================= -->
        <DataTemplate x:Key="SettingsTemplate">
            <TabControl Style="{StaticResource SettingsTabControl}"
                        Margin="16,2,12,12">

                <!-- System: the account the app is signed in with. -->
                <TabItem Header="System" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Only auth cookies are stored, encrypted with Windows DPAPI. Your password is never stored."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,14" />

                                    <TextBlock Text="Last active account" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding MultiAccountViewModel.ActiveAccountLabel, TargetNullValue='(none)'}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,4" />
                                    <TextBlock Text="Switch accounts in the Accounts section."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,14" />

                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Sign out"
                                            Command="{Binding LogoutCommand}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Interface: how the app looks and how text behaves. -->
                <TabItem Header="Interface" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Background" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Make the app come alive with an animated backdrop."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,3,0,12" />

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Style" Style="{StaticResource FieldLabel}" />
                                        <ListBox ItemsSource="{Binding BackdropStyles}"
                                                 SelectedItem="{Binding SelectedBackdropStyle, Mode=TwoWay}"
                                                 Style="{StaticResource RegionPillList}"
                                                 MaxHeight="60">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            CornerRadius="8"
                                                            Padding="10,6">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Margin" Value="0,0,6,0" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Animated" Style="{StaticResource FieldLabel}" />
                                        <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                                  Content="Animate the backdrop"
                                                  IsChecked="{Binding AnimateBackdrop}"
                                                  Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Dim overlay" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Text="Darkens the backdrop so content stays readable."
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,8" />
                                        <Slider Minimum="0" Maximum="0.7"
                                                Value="{Binding BackdropDim}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding BackdropDim, StringFormat={}{0:P0}}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Custom image" Style="{StaticResource FieldLabel}" />
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Choose PNG / GIF…"
                                                Padding="12,7"
                                                FontSize="11"
                                                Margin="10,0,0,0"
                                                Command="{Binding ChooseBackdropCommand}" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Reset"
                                                Padding="10,7"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding ClearBackdropCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding BackdropFileName}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasCustomBackdrop, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="Or paste an image URL" Style="{StaticResource FieldLabel}" />
                                        <Grid Margin="0,4,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding BackdropUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InputBox}"
                                                     Tag="https://example.com/image.gif" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Content="Download"
                                                    Padding="12,7"
                                                    FontSize="11"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DownloadBackdropFromUrlCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Profile popup background" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Use a PNG or GIF behind friend and profile popups. GIFs animate."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,3,0,12" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Choose PNG / GIF…"
                                                Padding="12,7"
                                                FontSize="11"
                                                Command="{Binding ChooseProfileBackdropCommand}" />
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Content="Reset"
                                                Padding="10,7"
                                                FontSize="11"
                                                Margin="8,0,0,0"
                                                Command="{Binding ClearProfileBackdropCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding ProfileBackdropFileName}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Performance" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Lite mode keeps the app light on older PCs: the animated background is drawn once instead of repainting, pictures appear without fading and decode at thumbnail size instead of full resolution, the friend safety-net poll runs every 30 seconds instead of every 10, and only the page you are on is kept in memory. Nothing is removed or disabled."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,12" />
                                    <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                              Content="Use lite mode on this PC"
                                              IsChecked="{Binding LiteMode, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding LiteModeDescription}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Text selection" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Highlight any label, message or user id with the mouse, then press Ctrl+C or right-click to copy it. Text boxes keep working normally either way."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,12" />
                                    <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                              Content="Let me highlight and copy text across the app"
                                              IsChecked="{Binding EnableTextSelection}" />
                                    <TextBlock Text="Rows, buttons and links are never grabbed, so clicking them still does what it always did."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Social: the activity feed. -->
                <TabItem Header="Social" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Activity Feed" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Configure how the activity timeline behaves."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,3,0,12" />

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Default filter" Style="{StaticResource FieldLabel}" />
                                        <ListBox SelectedItem="{Binding ActivityDefaultFilter}"
                                                 Style="{StaticResource RegionPillList}"
                                                 MaxHeight="44">
                                            <ListBox.Items>
                                                <sys:String>all</sys:String>
                                                <sys:String>FriendOnline</sys:String>
                                                <sys:String>FriendJoinedWorld</sys:String>
                                                <sys:String>FriendOffline</sys:String>
                                                <sys:String>BioChanged</sys:String>
                                                <sys:String>AvatarChanged</sys:String>
                                                <sys:String>FriendAdded</sys:String>
                                                <sys:String>FriendRemoved</sys:String>
                                            </ListBox.Items>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource InputBrush}"
                                                            CornerRadius="8"
                                                            Padding="10,6"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                              Content="Show offline friends in activity feed"
                                              IsChecked="{Binding ActivityShowOfflineFriends}"
                                              Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Browser: settings shared by every embedded page. -->
                <TabItem Header="Browser" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Embedded browsers" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Brave Browser, Discord and Creator Resources share one engine. This one switch covers all three; per-site shields stay in the Brave Browser section."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,12" />

                                    <CheckBox Style="{StaticResource FriendlyCheckBox}"
                                              Content="Block ads and trackers in every embedded browser"
                                              IsChecked="{Binding BrowserAdBlockEnabled}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Advanced: updates and the about blurb. -->
                <TabItem Header="Advanced" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="KawaiiVrc checks for a newer release when it starts."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,10" />

                                    <TextBlock Text="{Binding UpdateViewModel.VersionSummary}"
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,8" />
                                    <StackPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Content="Check for updates"
                                                    Command="{Binding UpdateViewModel.CheckCommand}"
                                                    IsEnabled="{Binding UpdateViewModel.CanCheck}"
                                                    ToolTip="{Binding UpdateViewModel.UpdateUnavailableText}" />
                                            <TextBlock Text="{Binding UpdateViewModel.StatusText}"
                                                       Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding UpdateViewModel.HasStatusText, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding UpdateViewModel.UpdateUnavailableText}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding UpdateViewModel.ShowUnsupportedNotice, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                                    <TextBlock FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,0,0,4">
                                        <Run Text="Kawaii" Foreground="{StaticResource PinkBrush}" />
                                        <Run Text="Vrc" Foreground="{StaticResource VioletBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="A kawaii unofficial VRChat companion."
                                               Style="{StaticResource MutedText}"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Settings and caches live in %LOCALAPPDATA%\VrcCompanion. Your auth cookie is encrypted with Windows DPAPI and your password is never stored."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,0" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </DataTemplate>

        <!-- ========================================================= -->
        <!-- New section templates                                     -->
        <!-- ========================================================= -->

        <DataTemplate x:Key="AvatarsTemplate">
            <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,2,12,12"
                          behaviors:ScrollViewerBehavior.PageToken="{Binding AvatarViewModel.AvatarPageToken}"
                          Visibility="{Binding AvatarViewModel.IsAvatarDetailsOpen, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <!-- Search bar -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Search avatars" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AvatarViewModel.SearchTerm, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource InputBox}"
                                         Tag="Search by name, author, or tags..." />
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Search"
                                        Padding="14,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding AvatarViewModel.SearchCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Refresh"
                                        Padding="14,7"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        Command="{Binding AvatarViewModel.RefreshCommand}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding AvatarViewModel.SummaryText}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="AvatarSortButton"
                                            Style="{StaticResource GhostButton}"
                                            Padding="9,5"
                                            Margin="0,0,8,0"
                                            Command="{Binding AvatarViewModel.ToggleAvatarSortCommand}"
                                            ToolTip="Sort uploaded avatars">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8CB;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Margin="6,0,7,0">
                                                <TextBlock Text="SORTED BY"
                                                           FontSize="7.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource DimBrush}" />
                                                <TextBlock Text="{Binding AvatarViewModel.SelectedAvatarSort.Label}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="9"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Popup DataContext="{Binding}"
                                           PlacementTarget="{Binding ElementName=AvatarSortButton}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade"
                                           IsOpen="{Binding AvatarViewModel.IsAvatarSortOpen, Mode=TwoWay}">
                                        <Border Width="190"
                                                Margin="0,4,0,0"
                                                Padding="8"
                                                Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <StackPanel>
                                                <TextBlock Text="SORTED BY"
                                                           Style="{StaticResource FieldLabel}"
                                                           Margin="7,3,7,6" />
                                                <ListBox Style="{StaticResource ChoiceListBox}"
                                                         ItemsSource="{Binding AvatarViewModel.AvatarSortOptions}"
                                                         SelectedItem="{Binding AvatarViewModel.SelectedAvatarSort, Mode=TwoWay}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="&#xE73E;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                                           HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,5"
                                            FontSize="10.5"
                                            Margin="0,0,6,0"
                                            Command="{Binding AvatarViewModel.RevertPreviousAvatarCommand}"
                                            Visibility="{Binding AvatarViewModel.CanRevertPrevious, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Go back to the avatar you were wearing before the last change">
                                        <TextBlock Text="{Binding AvatarViewModel.PreviousAvatarName, StringFormat='Back to {0}'}" />
                                    </Button>
                                    <Button Style="{StaticResource GhostButton}"
                                            Padding="9,5"
                                            FontSize="10.5"
                                            Command="{Binding AvatarViewModel.WearOriginalAvatarCommand}"
                                            Visibility="{Binding AvatarViewModel.CanRevertAvatar, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Put back the avatar you were wearing when the app started">
                                        <TextBlock Text="{Binding AvatarViewModel.OriginalAvatarName, StringFormat='Session start: {0}'}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Avatar grid -->
                    <ItemsControl x:Name="AvatarGrid"
                                  ItemsSource="{Binding AvatarViewModel.Avatars}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Only the cards near the viewport stay built; the
                                     rest are rows of scrollable height. -->
                                <controls:VirtualizingWrapPanel ItemWidth="236"
                                                                EstimatedItemHeight="320"
                                                                CacheViewports="0.75" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CardButton}"
                                        Width="220"
                                        Margin="0,0,16,16"
                                        Command="{Binding DataContext.AvatarViewModel.OpenAvatarDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Id}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Avatar image -->
                                        <Border Grid.Row="0"
                                                Width="140" Height="140"
                                                CornerRadius="10"
                                                Background="{StaticResource InputBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top">
                                            <Grid>
                                                <controls:AsyncImage SourceUrl="{Binding ThumbnailUrl}"
                                                                     DecodeWidth="160">
                                                    <controls:AsyncImage.Style>
                                                        <Style TargetType="{x:Type controls:AsyncImage}">
                                                            <Setter Property="Opacity" Value="1" />
