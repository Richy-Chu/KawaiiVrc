                                                             Margin="0,4,0,0"
                                                             AutomationProperties.AutomationId="ChatboxPulsoidTokenBox" />
                                                <TextBlock Text="{Binding ChatboxViewModel.HeartRateText}"
                                                           Style="{StaticResource KawaiiMuted}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="TWITCH HELIX" Style="{StaticResource FieldLabel}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                    <TextBlock Text="CLIENT ID" Style="{StaticResource KawaiiMuted}" FontSize="9" />
                                                    <TextBox Style="{StaticResource InputBox}"
                                                             Text="{Binding ChatboxViewModel.TwitchClientId, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="Twitch application Client ID" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0">
                                                    <TextBlock Text="ACCESS TOKEN" Style="{StaticResource KawaiiMuted}" FontSize="9" />
                                                    <PasswordBox Style="{StaticResource PasswordInput}"
                                                                 controls:PasswordBoxBinding.BindPassword="True"
                                                                 controls:PasswordBoxBinding.BoundPassword="{Binding ChatboxViewModel.TwitchAccessToken, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip="Twitch user access token"
                                                                 AutomationProperties.AutomationId="ChatboxTwitchAccessTokenBox" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                                    <TextBlock Text="CHANNEL" Style="{StaticResource KawaiiMuted}" FontSize="9" />
                                                    <TextBox Style="{StaticResource InputBox}"
                                                             Text="{Binding ChatboxViewModel.TwitchChannel, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="Twitch channel login name" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ChatboxViewModel.TwitchText}"
                                                       Style="{StaticResource KawaiiMuted}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource KawaiiListRow}" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="TIKTOK PROFILE" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="USERNAME" Style="{StaticResource KawaiiMuted}" FontSize="9" Margin="0,4,0,0" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.TikTokUsername, UpdateSourceTrigger=LostFocus}"
                                                     ToolTip="TikTok profile name" />
                                            <TextBlock Text="Reads the public follower count. The label and token order are under Extra formats."
                                                       Style="{StaticResource KawaiiMuted}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Extra formats" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Each service keeps its own template and its own live preview, so a change here never rewrites the other providers."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,10">
                                            <StackPanel>
                                                <TextBlock Text="SPOTIFY" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.SpotifyFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {state} {display} {title} {artist} {source}. Read from the Windows Spotify session."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.SpotifyText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="WEATHER" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.WeatherFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {emoji} {temperature} {temperature_f} {feels} {humidity} {wind} {condition} {city} {detail}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.WeatherText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,10">
                                            <StackPanel>
                                                <TextBlock Text="NETWORK" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.NetworkFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {network} {down} {up}. Local interface counters only."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.NetworkText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="VRCHAT RADAR" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.RadarFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {world} {players} {instance} {region}. Read from VRChat's own output_log."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.RadarText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,10">
                                            <StackPanel>
                                                <TextBlock Text="COMPONENT STATS" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.ComponentFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {stats} {cpu} {gpu} {vram} {ram} {ram_used} {ram_total}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.ComponentText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="SOUNDPAD" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.SoundpadFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {sound}. Enable remote control in Soundpad."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.SoundpadText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,10">
                                            <StackPanel>
                                                <TextBlock Text="HEART RATE" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.HeartRateFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {bpm}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.HeartRateText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="TWITCH" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.TwitchFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {twitch} {channel} {live} {viewers} {game} {title}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.TwitchText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,10">
                                            <StackPanel>
                                                <TextBlock Text="DISCORD" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.DiscordFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {channel} {count} {speaking} {speaking_count}. Read from the embedded Discord voice channel."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.DiscordText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="VR GEAR BATTERY" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.VrBatteryFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {icon} {name} {batt} {status}. One entry per tracked device, up to nine."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.VrTrackerText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                <TextBlock Text="VR BATTERY DIAGNOSTIC"
                                                           Style="{StaticResource FieldLabel}"
                                                           Margin="0,9,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.VrBatteryDiagnosticText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9"
                                                           TextWrapping="Wrap" MaxHeight="104"
                                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="VR PERFORMANCE" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.VrPerformanceFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {fps} {dropped} {frame_ms}. Read from SteamVR's compositor frame timing."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.VrPerformanceText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Row="5" Grid.Column="1" Style="{StaticResource KawaiiListRow}" Padding="12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="TIKTOK" Style="{StaticResource FieldLabel}" />
                                                <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                                                         Text="{Binding ChatboxViewModel.TikTokFormat, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="Tokens: {profile} {followers} {followers_raw}. Public follower count only; LIVE events need TikTok's connector."
                                                           Style="{StaticResource KawaiiMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding ChatboxViewModel.TikTokText}"
                                                           Style="{StaticResource KawaiiMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Status and line composition" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="The automatic line is composed from the active status plus whatever integrations are enabled. Extra parts are dropped if the 144-character chatbox limit is reached."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="CYCLE INTERVAL (SECONDS)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.CycleSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="SCAN INTERVAL (SECONDS)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.ScanSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Show AFK when I stop using the PC"
                                              IsChecked="{Binding ChatboxViewModel.AfkEnabled}"
                                              Style="{StaticResource FriendlyCheckBox}"
                                              Margin="0,12,0,0"
                                              ToolTip="Uses Windows' last keyboard or mouse input. Nothing is recorded or sent anywhere." />
                                    <TextBlock Text="{Binding ChatboxViewModel.AfkStateText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="AFK AFTER (SECONDS)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.AfkTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                            <TextBlock Text="AFK PREFIX" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.AfkPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                     TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="AFK TEXT" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.AfkText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="SEPARATOR BETWEEN PARTS" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding ChatboxViewModel.Separator, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ChatboxSeparatorBox" />
                                    <CheckBox Content="Put each part on its own line"
                                              IsChecked="{Binding ChatboxViewModel.SeparateWithEnters}"
                                              Style="{StaticResource FriendlyCheckBox}"
                                              Margin="0,10,0,0" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="LINE PREFIX" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.LinePrefix, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="LINE SUFFIX" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.LineSuffix, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Enabled integrations" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Integration switches and their order live on the Integrations page. This page only controls timing, composition and OSC."
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Button Content="Open Integrations"
                                                Command="{Binding ChatboxViewModel.ShowIntegrationsPageCommand}"
                                                Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource KawaiiPanel}">
                                <StackPanel>
                                    <TextBlock Text="VRChat connection" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="VRChat listens on this OSC endpoint. Keep the port matching VRChat's OSC settings."
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="HOST" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.Host, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="ChatboxOscHostBox" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                                            <TextBox Style="{StaticResource InputBox}"
                                                     Text="{Binding ChatboxViewModel.Port, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="ChatboxOscPortBox" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- LIVE PREVIEW / STATUS SIDEBAR -->
                    <Border Grid.Column="1" Style="{StaticResource KawaiiPanel}" VerticalAlignment="Top" Padding="16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="PREVIEW" Style="{StaticResource FieldLabel}" />
                                <Border Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="999"
                                        Padding="8,3"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ChatboxViewModel.ChatboxDisplayTag}"
                                               FontSize="8"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentHoverBrush}" />
                                </Border>
                            </Grid>
                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,11"
                                    MinHeight="92"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding ChatboxViewModel.PreviewLine}"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ChatboxPreviewText" />
                            </Border>
                            <Grid Margin="0,5,0,0">
                                <TextBlock Text="{Binding ChatboxViewModel.PreviewCountText}"
                                           Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ChatboxViewModel.ChatCountdownText}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding ChatboxViewModel.PreviewStatusText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />

                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="9,7"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="PROVIDER PIPELINE" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ChatboxViewModel.ProviderSummaryText}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding ChatboxViewModel.IntegrationCards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding OrderText}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                               FontWeight="Bold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StateText}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="9" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="10"
                                    Padding="11,9"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE STATUS" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding ChatboxViewModel.ActiveStatusText}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Button Content="Stop chat and restore status"
                                    Command="{Binding ChatboxViewModel.StopChatCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,12,0,0" />
                            <Button Content="Clear chat history"
                                    Command="{Binding ChatboxViewModel.ClearChatHistoryCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,6,0,0" />
                            <Button Content="Reorder integrations"
                                    Command="{Binding ChatboxViewModel.ShowIntegrationsPageCommand}"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,6,0,0" />

                            <TextBlock Text="{Binding ChatboxViewModel.StatusText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="OSC"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,14,0,4" />
                            <TextBlock Text="Configure the endpoint and output options in Options · Enable OSC in VRChat"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ============================================================= -->
    <!-- Root                                                          -->
    <!-- ============================================================= -->
    <Grid ClipToBounds="True">

        <!-- Animated backdrop layer (behind everything) -->
        <controls:ImageBackdrop
            SourcePath="{Binding CustomBackdropPath}"
            Animate="{Binding AnimateBackdrop}"
            Visibility="{Binding HasCustomBackdrop, Converter={StaticResource BoolToVis}}" />
        <controls:AuroraBackdrop
            Variant="{Binding BackdropVariant}"
            Animate="{Binding AnimateBackdrop}"
            Visibility="{Binding HasCustomBackdrop, Converter={StaticResource InverseBoolToVis}}" />
        <Border Background="#0B0D12"
                Opacity="{Binding BackdropDim}" />

        <!-- Ambient background -->
        <Ellipse Width="620" Height="620"
                 Fill="{StaticResource PurpleGlow}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-220,-300,0,0"
                 IsHitTestVisible="False" />
        <Ellipse Width="560" Height="560"
                 Fill="{StaticResource BlueGlow}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-220,-260"
                 IsHitTestVisible="False" />

        <!-- ========================================================= -->
        <!-- Signed-in shell                                           -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderBrush="#3A2C52"
                    BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.75,1">
                        <GradientStop Color="#D9201538" Offset="0" />
                        <GradientStop Color="#D9121026" Offset="0.42" />
                        <GradientStop Color="#CC0B0D16" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,20,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/app-icon.png"
                               Width="42" Height="42"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Bold">
                                <Run Text="Kawaii" Foreground="{StaticResource PinkBrush}" />
                                <Run Text="Vrc" Foreground="{StaticResource VioletBrush}" />
                            </TextBlock>
                            <TextBlock Text="stay cute online ♡"
                                       FontSize="9.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,30,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="NAVIGATE  ♡"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{StaticResource PinkBrush}"
                                   FontSize="9"
                                   Margin="12,0,0,8" />
                        <ListBox Grid.Row="1"
                                 Style="{StaticResource NavList}"
                                 ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <StackPanel Grid.Row="2">
                        <Button Content="♡  Open VRChat"
                                Style="{StaticResource PrimaryButton}"
                                Padding="12,8"
                                Margin="0,0,0,10"
                                FontSize="11"
                                Command="{Binding OpenVrChatCommand}"
                                ToolTip="Start VRChat with the saved launch mode" />

                        <Button Command="{Binding OpenOwnProfileCommand}"
                                Cursor="Hand"
                                ToolTip="Open your profile"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter x:Name="Card" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Border Background="#CC171329"
                                    BorderBrush="#3C2D58"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34"
                                            CornerRadius="17"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding AvatarInitial}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentHoverBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding TrustBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UsernameHandle}"
                                                   FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <TextBlock Text="Session encrypted with Windows DPAPI ♡"
                                   FontSize="9"
                                   Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap"
                                   Margin="2,10,2,0" />
                        <TextBlock Text="Made with ♡ · Not affiliated with VRChat Inc."
                                   FontSize="9"
                                   Foreground="{StaticResource DimBrush}"
                                   TextWrapping="Wrap"
                                   Margin="2,4,2,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border x:Name="AppHeader"
                        Visibility="{Binding IsAnyBrowserFocused, Converter={StaticResource InverseBoolToVis}}"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="26,18,26,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="♡"
                                           FontSize="16"
                                           Foreground="{StaticResource PinkBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,2" />
                            </StackPanel>
                            <TextBlock Text="{Binding SectionSubtitle}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0" />
                            <Grid Width="390"
                                  HorizontalAlignment="Left"
                                  Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PlayerSearchBox"
                                         Style="{StaticResource InputBox}"
                                         Text="{Binding PlayerSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search a VRChat username or usr_ ID">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding PlayerSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Search"
                                        Padding="14,7"
                                        Margin="8,0,0,0"
                                        Command="{Binding PlayerSearchCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Content="Clear"
                                        Padding="8,7"
                                        Margin="4,0,0,0"
                                        Command="{Binding ClearPlayerSearchCommand}"
                                        ToolTip="Clear player search" />
                            </Grid>
                            <Popup PlacementTarget="{Binding ElementName=PlayerSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsPlayerSearchOpen, Mode=TwoWay}">
                                <Border Width="390"
                                        MaxHeight="380"
                                        Margin="0,4,0,0"
                                        Padding="10"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PlayerSearchSummary}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="6,2,6,8"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer MaxHeight="320"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding PlayerSearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="7,6"
                                                                HorizontalContentAlignment="Stretch"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.OpenPlayerSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="40"
                                                                        Height="40"
                                                                        CornerRadius="20"
                                                                        Background="{StaticResource PanelBrush}"
                                                                        Margin="0,0,10,0">
                                                                    <Grid>
                                                                        <controls:AsyncImage SourceUrl="{Binding AvatarUrl}"
                                                                                             DecodeWidth="96"
                                                                                             CornerRadius="20" />
                                                                        <TextBlock Text="{Binding Initial}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{Binding TrustBrush}"
                                                                                   Visibility="{Binding AvatarUrl, Converter={StaticResource StringEmptyToVis}}" />
                                                                        <controls:CosmeticImage SourceUrl="{Binding IconFrameUrl}"
                                                                                                IntroUrl="{Binding IconFrameIntroUrl}"
                                                                                                DecodeWidth="128"
                                                                                                Width="52"
                                                                                                Height="52"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Visibility="{Binding HasIconFrame, Converter={StaticResource BoolToVis}}" />
                                                                        <Ellipse Width="10"
                                                                                 Height="10"
                                                                                 Fill="{Binding StatusDotBrush}"
                                                                                 Stroke="{StaticResource PanelBrush}"
                                                                                 StrokeThickness="2"
                                                                                 HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Bottom"
                                                                                 Margin="0,0,-1,-1" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding TrustBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding SubText}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource MutedBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,2,0,0" />
                                                                    <TextBlock Text="{Binding TrustLabel}"
                                                                               FontSize="9"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding TrustBrush}"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding TrustBrush}"
                                           HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LastUpdatedText}"
                                           Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <Button Style="{StaticResource KawaiiActionButton}"
                                    Command="{Binding OpenInstanceCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Your current world, instance, and live players">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Instance" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource KawaiiActionButton}"
                                    Command="{Binding OpenFriendsCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Your friends, their presence, and their locations">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Friends" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource KawaiiActionButton}"
                                    Command="{Binding OpenRecentPlayersCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="People you have played with, recorded locally">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Recent people" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource KawaiiActionButton}"
                                    Command="{Binding OpenFriendLocationsCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Friends in worlds, with join">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE716;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Friend locations" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource KawaiiActionButton}"
                                    Command="{Binding RefreshCommand}"
                                    Margin="0,0,6,0"
                                    ToolTip="Refresh friends and notifications">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="Sign out of VRChat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7E8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Sign out" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error, info, and busy banners -->
                <StackPanel Grid.Row="1" Margin="26,12,26,0">
                    <Border Style="{StaticResource ErrorBannerPanel}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource ErrorTextBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource ErrorTextBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearErrorCommand}"
                                    Foreground="{StaticResource ErrorTextBrush}"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    ToolTip="Dismiss">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource InfoBannerPanel}"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource GreenBrush}"
                                       VerticalAlignment="Top"
                                       Margin="0,1,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding InfoMessage}"
                                       FontSize="11"
                                       Foreground="{StaticResource GreenBrush}"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding DismissInfoCommand}"
                                    Foreground="{StaticResource GreenBrush}"
                                    Padding="6,2"
                                    Margin="8,0,0,0"
                                    ToolTip="Dismiss">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="10"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BusyText}"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentHoverBrush}"
                                       Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Active section. Visited views stay alive so page state, calls, and scroll position survive tab switches. -->
                <Grid x:Name="SectionHost"
                      Grid.Row="2"
                      Margin="0,8,0,0"
                      ClipToBounds="True" />

                <!-- Footer -->
                <Border x:Name="AppFooter"
                        Grid.Row="3"
                        Visibility="{Binding IsAnyBrowserFocused, Converter={StaticResource InverseBoolToVis}}"
                        BorderBrush="{StaticResource SoftBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="26,8">
                    <StackPanel>
                        <!-- Only visible while a newer release is waiting to be downloaded. -->
                        <Button Command="{Binding UpdateViewModel.OpenCommand}"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="12,7"
                                Margin="0,0,0,8"
                                BorderThickness="1"
                                BorderBrush="{StaticResource AccentHoverBrush}"
                                Background="{StaticResource AccentSoftBrush}"
                                ToolTip="Open the update download popup"
                                AutomationProperties.Name="Open the available update"
                                Visibility="{Binding UpdateViewModel.ShowUpdateBar, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="UpdateBarSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="UpdateBarSurface" Property="Background" Value="{StaticResource KawaiiChipBrush}" />
                                            <Setter TargetName="UpdateBarSurface" Property="BorderBrush" Value="{StaticResource PinkBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="UpdateBarSurface" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="UpdateBarSurface" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE895;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UpdateViewModel.UpdateBarText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentHoverBrush}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Open updater"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Grid>
                            <TextBlock Text="KawaiiVrc · Unofficial VRChat companion · Use at your own risk"
                                       FontSize="9.5"
                                       Foreground="{StaticResource DimBrush}" />
                            <TextBlock Text="API requests are rate-limited to protect your account"
                                       FontSize="9.5"
                                       Foreground="{StaticResource DimBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- Login / two-factor screen                                 -->
        <!-- ========================================================= -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="500" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="60,42,20,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/app-icon.png"
                           Width="46" Height="46"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="17" FontWeight="Bold">
                            <Run Text="Kawaii" Foreground="{StaticResource PinkBrush}" />
                            <Run Text="Vrc" Foreground="{StaticResource VioletBrush}" />
                        </TextBlock>
                        <TextBlock Text="stay cute, stay connected ♡"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="540" Margin="0,20,0,20">
                    <TextBlock FontSize="43"
                               FontWeight="Bold"
                               LineHeight="52"
                               TextWrapping="Wrap">
                        <Run Text="Your VRChat world," />
                        <LineBreak />
                        <Run Text="but kawaii." Foreground="{StaticResource PinkBrush}" />
                    </TextBlock>
                    <TextBlock Text="A kawaii desktop companion for the parts of VRChat you check most often. Browse friend profiles, inspect worlds, create or join instances, and launch the game without clutter."
                               FontSize="14"
                               LineHeight="22"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,16,0,0"
                               MaxWidth="490" />

                    <StackPanel Margin="0,30,0,0">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36"
                                    CornerRadius="10"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE716;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Friends &amp; profiles" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Online presence, bios, groups, badges, mutuals, and one-click joining."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36"
                                    CornerRadius="10"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderBrush="{StaticResource SoftBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE909;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource VioletBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Worlds &amp; instances" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Open world details, spin up a new instance, or join one with a quick link."
                                           FontSize="11"
