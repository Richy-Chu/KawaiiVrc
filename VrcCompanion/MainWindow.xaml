                                                                <DataTrigger Binding="{Binding HasSecurityCheckFailed}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.35" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
