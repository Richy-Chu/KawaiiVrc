                                                                             CornerRadius="23" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.DisplayName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.IdText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.SelectedMember.JoinedText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="9.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.CardVisibilityText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Close"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="9,4"
                                                        FontSize="10"
                                                        VerticalAlignment="Top"
                                                        Command="{Binding DataContext.GroupViewModel.Moderation.CloseMemberCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12,16,16">
