                                                           Style="{StaticResource MutedText}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding DataContext.GroupViewModel.Moderation.Roles, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource ChipButton}"
                                                                    Margin="0,0,6,6"
                                                                    Command="{Binding ToggleCommand}"
                                                                    ToolTip="{Binding Name}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ActionText}"
                                                                               FontSize="9"
                                                                               Foreground="{StaticResource PinkBrush}"
                                                                               Margin="6,0,0,0"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="STAFF NOTES" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                                <TextBlock Text="Only group managers see these notes."
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,0,0,6" />
                                                <TextBox Text="{Binding DataContext.GroupViewModel.Moderation.CardManagerNotes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource InputBox}"
                                                         Padding="10,6"
                                                         FontSize="11.5"
                                                         MinHeight="64"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         AutomationProperties.Name="Staff notes"
                                                         AutomationProperties.AutomationId="GroupMemberNotesBox" />
                                                <Button Content="Save notes"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Padding="12,6"
                                                        FontSize="10.5"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.GroupViewModel.Moderation.SaveMemberSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                <Border Background="#2A1430"
                                                        BorderBrush="{StaticResource PinkBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,7"
                                                        Margin="0,12,0,0"
                                                        Visibility="{Binding DataContext.GroupViewModel.Moderation.IsConfirmOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DataContext.GroupViewModel.Moderation.ConfirmText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                            <Button Content="Confirm" Style="{StaticResource PrimaryButton}" Padding="11,5" FontSize="10.5"
                                                                    Command="{Binding DataContext.GroupViewModel.Moderation.ConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="10.5" Margin="4,0,0,0"
                                                                    Command="{Binding DataContext.GroupViewModel.Moderation.CancelConfirmCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CreatorResourcesTemplate">
            <Grid Margin="16,2,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding CreatorResourcesViewModel.IsBrowserOpen, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SEARCH CREATOR SITES" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CreatorResourcesViewModel.SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="CreatorSearchBox"
                                     Style="{StaticResource InputBox}"
                                     Tag="Search avatars, outfits, models, shaders, or tools..." />
                            <TextBlock Text="Type a term, then choose Search on a site below. Search opens in the in-app browser; Open site uses your default browser."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MARKETPLACES &amp; TOOLS"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding CreatorResourcesViewModel.Resources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Width="370"
                                        Margin="0,0,14,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42"
                                                    CornerRadius="12"
                                                    Background="{StaticResource InputBrush}"
                                                    Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Initial}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}"
                                                           Style="{StaticResource MutedText}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,12,0,16" />

                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open site"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Padding="12,6"
                                                    FontSize="11"
                                                    Margin="0,0,8,0"
                                                    ToolTip="Opens in your default browser"
                                                    Command="{Binding DataContext.CreatorResourcesViewModel.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Search"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6"
                                                    FontSize="11"
                                                    ToolTip="Searches this site in the in-app browser"
                                                    Visibility="{Binding CanSearch, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.CreatorResourcesViewModel.SearchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Browse"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,6"
                                                    FontSize="11"
                                                    ToolTip="Opens this site in the in-app browser"
                                                    Visibility="{Binding CanSearch, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.CreatorResourcesViewModel.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Creator Resources does not handle passwords or automate downloads. Sign in on the site and use its own Download button; a Save As dialog lets you choose where the file goes."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Grid Visibility="{Binding CreatorResourcesViewModel.IsBrowserOpen, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsChecked, ElementName=CreatorFocusToggle, Converter={StaticResource InverseBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="IN-APP BROWSER" Style="{StaticResource FieldLabel}" Margin="0" />
                            <TextBlock Text="{Binding CreatorResourcesViewModel.BrowserTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Back to resources"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0"
                                    ToolTip="Return to Creator Resources while keeping the browser session"
                                    Command="{Binding CreatorResourcesViewModel.CloseBrowserCommand}" />
                            <Button Content="Open folder"
                                    Style="{StaticResource SmallButton}"
                                    Visibility="{Binding CreatorResourcesViewModel.CanOpenDownloadFolder, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.CreatorResourcesViewModel.OpenDownloadFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Tag="CreatorBrowserPane"
                        Style="{StaticResource Card}"
                        Padding="0"
                        ClipToBounds="True">
                    <controls:EmbeddedBrowser
                        DataContext="{Binding CreatorResourcesViewModel}" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <ToggleButton x:Name="CreatorFocusToggle"
                                  Tag="CreatorFocusToggle"
                                  IsChecked="{Binding CreatorResourcesViewModel.IsFocusMode, Mode=TwoWay}"
                                  Style="{StaticResource BrowserFocusToggle}" />
                    <TextBlock Text="{Binding CreatorResourcesViewModel.BrowserError}"
                               Foreground="{StaticResource ErrorTextBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding CreatorResourcesViewModel.IsFocusMode, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Text="{Binding CreatorResourcesViewModel.DownloadStatus}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CreatorResourcesViewModel.DownloadStatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BraveBrowserTemplate">
